+
+/* Refined workspace surface: quieter separators, compact navigation and a focused composer. */
+:root {
+  --side-width: 264px;
+  --rail-width: 288px;
+  --column: 800px;
+  --radius: 8px;
+  --radius-card: 11px;
+  --radius-box: 14px;
+}
+body { font-size: 14px; line-height: 1.55; letter-spacing: .005em; }
+.app { background: var(--bg); }
+.side-col { border-right-color: color-mix(in srgb, var(--border) 65%, transparent); }
+.side-head { padding-top: 12px; }
+.side-head h2 { color: var(--fg); font-size: 14px; letter-spacing: -.01em; }
+.side-tools { gap: 6px; }
+.search { height: var(--hit); border-color: transparent; background: color-mix(in srgb, var(--surface) 72%, var(--side)); }
+.new-btn { min-height: var(--hit); justify-content: flex-start; border-color: transparent; background: transparent; }
+.groups { padding-inline: 10px; }
+.group-head { min-height: 34px; }
+.session { min-height: var(--hit); }
+.session.is-active { box-shadow: inset 2px 0 var(--accent); }
+.session-item { min-height: var(--hit); font-size: 13.5px; }
+.session-item:focus-visible { position: relative; z-index: 1; }
+.topbar { min-height: 60px; padding-inline: 24px; }
+.title-block h2 { font-size: 17px; letter-spacing: -.025em; }
+.sub { font-size: 12px; }
+.session-model-slot { display: inline-flex; align-items: center; min-width: 0; color: var(--fg-muted); font-size: 12px; }
+.thread { gap: 19px; padding-top: 30px; }
+.item-user { max-width: min(78%, 620px); }
+.bubble { padding: 11px 15px; }
+.prose { line-height: 1.65; }
+.composer { padding: 8px 24px 16px; }
+.box { padding: 10px 11px 8px 15px; border-radius: var(--radius-box); box-shadow: 0 4px 18px color-mix(in srgb, var(--fg) 6%, transparent); }
+.box:focus-within { outline: 1px solid color-mix(in srgb, var(--accent) 72%, transparent); outline-offset: 0; }
+.box textarea { min-height: 34px; }
+.send-btn { min-height: var(--hit); padding-inline: 13px; border-radius: 9px; }
+.hint { margin-top: 5px; }
+.rail { gap: 17px; padding: 20px 18px; border-left-color: color-mix(in srgb, var(--border) 60%, transparent); }
+.rail .card { padding: 10px 0; border: 0; border-bottom: 1px solid var(--border); border-radius: 0; background: transparent; }
+.rail .card-title { font-size: 13px; }
+.env-row { grid-template-columns: 18px 58px minmax(0, 1fr); }
+.status { padding: 9px 14px; font-size: 12px; }
+@media (max-width: 1100px) {
+  .topbar { padding-inline: 16px; }
+  .composer { padding-inline: 16px; }
+}
+@media (max-width: 799px) {
+  .topbar { min-height: 54px; padding-inline: 10px; }
+  .thread { padding: 16px 14px 8px; }
+  .composer { padding: 6px 10px 10px; }
+  .item-user { max-width: 94%; }
+  .sub { min-width: 0; gap: 5px; }
+  .session-model-slot { min-width: 0; max-width: 34vw; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
+}
