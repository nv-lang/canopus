// config_layout.nv - where the configuration and the data of the control panel lie, and how the layers of the settings are put together (task 192.12, ADR-0016).
//
// The selected config file's parent is the instance root; default ~/.canopus/config.json.
// Root resources: secrets.json, roles.json, presets/, modes/, prompts/; data/sessions holds durable records.
// state/ contains process/log/diagnostic state, cache/ derived data, tools/ installed tools, backups/ safety copies.
// File precedence: code defaults < selected global config < repository .canopus/config.json.
// secrets.json is adjacent to the selected global file and accepts only secret/infrastructure keys.
// Runtime environment overrides, --home, --set, --file and positional server config are retired.
// Pure legacy parse/layout helpers remain available to the explicit transition code, not as runtime fallback.
//
// This module holds `std` only: the front (Polaris), the hub (the PostgreSQL driver) and the commands of `canopus` all import it.
module canopus.config

import std.text
import std.encoding.json.{Json, JsonValue, JsonObject, ParseJsonError}
import std.fs.{Fs, read_text, Path, try_exists, metadata}
import std.os.{Os, env, home_dir, cwd}

/// ConfigLayout: the folders of an instance. `legacy` - the folders come from an old `data_dir` (everything in one folder) and not from the root `home`.
/// `sessions` is the folder with a folder per session; `data` holds projects.json; `project` is the `.canopus` folder of the project ("" - none).
export type ConfigLayout { home str, config str, config_file str, data str, sessions str, state str, cache str, tools str, project str, legacy bool }

/// The flat layout of an old `data_dir`: all five folders are that one (the stands that started before the layout keep their files where they are).
export fn legacy_layout(dir str) -> ConfigLayout =>
    { home: "", config: "", config_file: "", data: dir, sessions: dir, state: dir, cache: dir, tools: "", project: "", legacy: true }

export fn ign(o Option[JsonValue]) -> () { }

fn slashes(p str) -> str => p.replace("\\", "/")

fn trim_slash(p str) -> str {
    mut s = slashes(p)
    while s.byte_len() > 1 && s.ends_with("/") { s = s[..s.byte_len() - 1] }
    s
}

/// The layout under a root: `<home>`, `data`, `data/sessions`, `state`, `cache`, `tools`.
export fn layout_in(home str, project str) -> ConfigLayout {
    ro h = trim_slash(home)
    if h.byte_len() == 0 { return legacy_layout("") }
    { home: h, config: h, config_file: "${h}/config.json", data: "${h}/data", sessions: "${h}/data/sessions", state: "${h}/state", cache: "${h}/cache", tools: "${h}/tools", project, legacy: false }
}

/// The chosen global file may have any name; its parent remains the instance root.
export fn layout_for_config(selection ConfigSelection, project str) -> ConfigLayout {
    ro at = layout_in(selection.root, project)
    { home: at.home, config: at.config, config_file: selection.file, data: at.data, sessions: at.sessions, state: at.state, cache: at.cache, tools: at.tools, project: at.project, legacy: at.legacy }
}

/// The layout when `data_dir` was named by the old settings: `data`, `sessions`, `state` and `cache` are that folder, `config` and `tools` stay under the root (when there is one).
export fn layout_with_data_dir(home str, data_dir str, project str) -> ConfigLayout {
    ro h = trim_slash(home)
    ro d = trim_slash(data_dir)
    { home: h, config: h, config_file: "${h}/config.json", data: d, sessions: d, state: d, cache: d, tools: if h.byte_len() > 0 { "${h}/tools" } else { "" }, project, legacy: true }
}

/// The root of the instance from the three sources, in the order of the rule: the argument, the variable, the folder of the user. "" - none of them is known.
export fn resolve_home(arg_home str, env_home str, user_home str) -> str {
    if arg_home.byte_len() > 0 { return trim_slash(arg_home) }
    if env_home.byte_len() > 0 { return trim_slash(env_home) }
    if user_home.byte_len() > 0 { return "${trim_slash(user_home)}/.canopus" }
    ""
}

fn cfg_env(key str) Os -> Option[str] {
    match env(key) {
        Some(v) => if v.byte_len() > 0 { Some(v) } else { None }
        None => None
    }
}

/// Default user instance root. arg_home is an explicit code dependency, never a public runtime flag.
export fn canopus_home(arg_home str) Os -> str {
    ro user = match home_dir() {
        Some(p) => p.display()
        None => ""
    }
    resolve_home(arg_home, "", user)
}

/// The chosen file and the root of its instance. Two files in one folder share the same root.
export type ConfigSelection { file str, root str }

/// Select a config without reading process overrides or touching the filesystem.
/// Relative explicit files are based on the caller's cwd; the default stays under the user home.
export fn select_config(config str, work str, user_home str) -> Result[ConfigSelection, str] {
    if config.byte_len() == 0 && user_home.byte_len() == 0 { return Err("the user home is unknown; give --config <file>") }
    ro raw = Path.from_bytes((if config.byte_len() > 0 { config } else { "${trim_slash(user_home)}/.canopus/config.json" }).bytes())
    if !raw.is_absolute() && work.byte_len() == 0 { return Err("a relative --config needs a working directory") }
    ro file = (if raw.is_absolute() { raw } else { Path.from_bytes(work.bytes()).join_path(raw) }).normalize()
    ro parent = match file.parent() {
        Some(p) => p
        None => return Err("--config needs a file inside an instance folder")
    }
    Ok(ConfigSelection { file: slashes(file.display()), root: slashes(parent.display()) })
}

// ----- the command line: --config <file>; old settings flags fail safely -----

/// CliArgs retains the old internal shape; production parsing fills only config/rest/error.
export type CliArgs { config str, home str, sets []str, rest []str, error str }

/// Extract the sole configuration selector and preserve action arguments; never echo retired flag values.
export fn split_cli_args(argv []str) -> CliArgs {
    mut config = ""
    mut home = ""
    mut sets = []str.new()
    mut rest = []str.new()
    mut error = ""
    mut i = 0
    while i < argv.len() {
        ro w = argv[i]
        if i == 0 {
            rest.push(w)
        } else if w == "--config" {
            if config.byte_len() > 0 { error = "--config must be given only once" }
            if i + 1 >= argv.len() {
                error = "--config needs a file"
            } else if argv[i + 1].byte_len() == 0 || argv[i + 1].starts_with("--") {
                error = "--config needs a file"
            } else {
                config = argv[i + 1]
                i += 1
            }
        } else if w.starts_with("--config=") {
            if config.byte_len() > 0 { error = "--config must be given only once" }
            config = w[9..]
            if config.byte_len() == 0 { error = "--config needs a file" }
        } else if w == "--home" || w.starts_with("--home=") {
            error = "--home is no longer supported; use --config <file>"
        } else if w == "--set" || w.starts_with("--set=") {
            error = "--set is no longer supported; edit the selected config file"
        } else if w == "--file" || w.starts_with("--file=") {
            error = "--file is no longer supported; use --config <file>"
        } else {
            rest.push(w)
        }
        i += 1
    }
    { config, home, sets, rest, error }
}

// ----- the project folder -----

fn is_dir(p str) Fs -> bool {
    match metadata(Path.from_bytes(p.bytes())) {
        Ok(m) => m.is_dir()
        Err(e) => false
    }
}

fn parent_of(p str) -> str {
    ro s = trim_slash(p)
    match s.rfind("/") {
        Some(at) => if at == 0 { "/" } else if at == 2 && s[1..2] == ":" { s[..3] } else { s[..at] }
        None => ""
    }
}

/// The `.canopus` folder of the project that holds `start` (or a folder above it, up to 16 levels): the first one that is not the root of the instance. "" - none.
export fn find_project_dir(start str, home str) Os Fs -> str {
    ro global = match home_dir() {
        Some(p) => "${trim_slash(p.display())}/.canopus"
        None => ""
    }
    mut dir = trim_slash(start)
    mut level = 0
    while dir.byte_len() > 0 && level < 16 {
        if dir == trim_slash(home) { return "" }
        ro candidate = if dir.ends_with("/") { "${dir}.canopus" } else { "${dir}/.canopus" }
        // An instance boundary is never a project or a reason to inherit another user's ancestor config.
        if candidate == trim_slash(home) || candidate == global { return "" }
        if is_dir(candidate) { return candidate }
        ro up = parent_of(dir)
        if up == dir || up.byte_len() == 0 { return "" }
        dir = up
        level += 1
    }
    ""
}

/// The folder the program works in now, with slashes; "" when it cannot be told.
export fn work_dir_now() Os -> str {
    match cwd() {
        Ok(p) => slashes(p.display())
        Err(e) => ""
    }
}

// ----- JSON helpers -----

/// Why a text is not JSON: the line and the reason; the text itself is never quoted.
export fn json_error_text(e ParseJsonError) -> str {
    match e {
        UnexpectedChar { line, col, found } => "${line}: unexpected character (column ${col})"
        UnexpectedEof { line, col } => "${line}: the text ends too early (column ${col})"
        InvalidEscape { line, col, seq } => "${line}: wrong escape (column ${col})"
        InvalidUnicode { line, col, hex } => "${line}: wrong unicode escape (column ${col})"
        InvalidNumber { line, col, text } => "${line}: wrong number (column ${col})"
        DuplicateKey { line, col, key } => "${line}: the key ${key} is twice (column ${col})"
        TrailingContent { line, col } => "${line}: something after the end of the object (column ${col})"
    }
}

/// The line (1 based) where the key (its last name, after the last dot) is written in the text; 1 when it is not found.
export fn key_line(text str, key str) -> int {
    ro name = match key.rfind(".") {
        Some(at) => key[at + 1..]
        None => key
    }
    ro needle = "\"${name}\""
    mut n = 1
    for line in text.split("\n") {
        if line.contains(needle) { return n }
        n += 1
    }
    1
}

/// Layer: one source of settings. `origin` is `user`, `server`, `project`, `local`, `secret`, `env` or `arg`; `file` is its file ("" for env and arg); `text` is the text of the file ("" - no file).
export type Layer { origin str, file str, obj JsonObject, text str }

export fn file_text(path str) Fs -> Option[str] {
    ro p = Path.from_bytes(path.bytes())
    ro there = match try_exists(p) {
        Ok(b) => b
        Err(e) => false
    }
    if !there { return None }
    match read_text(p) {
        Ok(t) => Some(t)
        Err(e) => None
    }
}

/// The file as a layer: Ok(None) - there is no such file; Err("file:line: reason") - it is not a JSON object.
export fn read_layer(origin str, file str) Fs -> Result[Option[Layer], str] {
    ro text = match file_text(file) {
        Some(t) => t
        None => return Ok(None)
    }
    ro raw = text.bytes()
    ro stripped = if raw.len() >= 3 && raw[0] == (239 as u8) && raw[1] == (187 as u8) && raw[2] == (191 as u8) { text[3..] } else { text }
    ro value = match Json.parse(stripped) {
        Ok(v) => v
        Err(e) => return Err("${file}:${json_error_text(e)}")
    }
    match value.object() {
        Some(o) => Ok(Some(Layer { origin, file, obj: o, text: stripped }))
        None => Err("${file}:1: the file must hold one JSON object")
    }
}

/// The old key `stt` is read as `voice`: the object `stt` is put under the name `voice`, the keys of `voice` itself over it.
export fn normalize_layer(o JsonObject) -> JsonObject {
    if !o.contains("stt") { return merge_objects(o, JsonObject.new()) }
    mut out = JsonObject.new()
    for (k, v) in o {
        if k != "stt" && k != "voice" { ign(out.insert(k, v)) }
    }
    ro old = o.get("stt").unwrap()
    ro old_o = old.object()
    // a value that is not an object is kept as it is under `voice`, so that the settings say what is wrong
    if old_o.is_none() {
        ign(out.insert("voice", old))
        return out
    }
    match o.get("voice") {
        None => ign(out.insert("voice", old))
        Some(now) => match now.object() {
            Some(now_o) => ign(out.insert("voice", JsonValue.object(merge_objects(old_o.unwrap(), now_o))))
            None => ign(out.insert("voice", now))
        }
    }
    out
}

/// `over` on top of `base`: objects are merged key by key, any other value of `over` replaces the value of `base`.
export fn merge_objects(base JsonObject, over JsonObject) -> JsonObject {
    mut out = JsonObject.new()
    for (k, v) in base { ign(out.insert(k, v)) }
    for (k, v) in over {
        match out.get(k) {
            Some(b) => match b.object() {
                Some(bo) => match v.object() {
                    Some(vo) => { ign(out.insert(k, JsonValue.object(merge_objects(bo, vo)))) }
                    None => { ign(out.insert(k, v)) }
                }
                None => { ign(out.insert(k, v)) }
            }
            None => { ign(out.insert(k, v)) }
        }
    }
    out
}

/// The layers put together.
export fn merge_layers(layers []Layer) -> JsonObject {
    mut out = JsonObject.new()
    for l in layers { out = merge_objects(out, l.obj) }
    out
}

/// Put a value under a dotted key (`voice.url`) into the object.
export fn put_path(o JsonObject, key str, value JsonValue) -> JsonObject {
    match key.split_once(".") {
        None => {
            mut out = merge_objects(o, JsonObject.new())
            ign(out.insert(key, value))
            out
        }
        Some((head, tail)) => {
            ro inner = match o.get(head) {
                Some(v) => v.object() ?? JsonObject.new()
                None => JsonObject.new()
            }
            mut out = merge_objects(o, JsonObject.new())
            ign(out.insert(head, JsonValue.object(put_path(inner, tail, value))))
            out
        }
    }
}

/// The value of a `--set` word or of a text from the command line: `true` and `false` are flags, digits are a number, anything else is a string.
export fn guess_value(text str) -> JsonValue {
    if text.starts_with("[") || text.starts_with("{") {
        match Json.parse(text) { Ok(value) => return value, Err(e) => () }
    }
    if text == "true" { return JsonValue.bool(true) }
    if text == "false" { return JsonValue.bool(false) }
    match text.to_int() {
        Ok(n) => if text.byte_len() > 0 && !text.starts_with("+") { JsonValue.int(n) } else { JsonValue.str(text) }
        Err(e) => JsonValue.str(text)
    }
}

// ----- the environment as a layer -----

/// EnvKey: a variable and the key of the settings it sets; `kind` is `s` (text), `i` (number) or `b` (true/false). Later lines of the list win.
type EnvKey { var str, key str, kind str }

fn ek(var str, key str, kind str) -> EnvKey => { var, key, kind }

fn env_keys() -> []EnvKey => [
    ek("CANOPUS_STT_DIR", "voice.dir", "s"),
    ek("CANOPUS_SERVER_PORT", "port", "i"), ek("CANOPUS_SERVER_STORE", "store", "s"), ek("CANOPUS_SERVER_DATA_DIR", "data_dir", "s"), ek("CANOPUS_SERVER_WORKDIR", "workdir", "s"),
    ek("CANOPUS_SERVER_WEB_DIR", "web_dir", "s"), ek("CANOPUS_SERVER_MACHINES_DIR", "machines_dir", "s"), ek("CANOPUS_SERVER_ACP_TRACE", "acp_trace", "b"), ek("CANOPUS_SERVER_ASK_FORM", "ask_form", "b"),
    ek("CANOPUS_SERVER_ASK_TIMEOUT_SECONDS", "ask_timeout_seconds", "i"), ek("CANOPUS_SERVER_IDLE_SECONDS", "idle_term_seconds", "i"),
    ek("CANOPUS_SERVER_ROUTES_DIR", "routes_dir", "s"), ek("CANOPUS_SERVER_MAX_IMAGE_BYTES", "max_image_bytes", "i"),
    ek("CANOPUS_SERVER_STT_URL", "voice.url", "s"), ek("CANOPUS_SERVER_STT_LANGUAGE", "voice.language", "s"), ek("CANOPUS_SERVER_STT_MANAGED", "voice.managed", "b"),
    ek("CANOPUS_SERVER_STT_DIR", "voice.dir", "s"), ek("CANOPUS_SERVER_STT_MODEL", "voice.model", "s"),
    ek("CANOPUS_VOICE_URL", "voice.url", "s"), ek("CANOPUS_VOICE_LANGUAGE", "voice.language", "s"), ek("CANOPUS_VOICE_MANAGED", "voice.managed", "b"),
    ek("CANOPUS_VOICE_DIR", "voice.dir", "s"), ek("CANOPUS_VOICE_MODEL", "voice.model", "s"),
    ek("CANOPUS_PG_HOST", "pg.host", "s"), ek("CANOPUS_PG_PORT", "pg.port", "i"), ek("CANOPUS_PG_DATABASE", "pg.database", "s"), ek("CANOPUS_PG_USER", "pg.user", "s"), ek("CANOPUS_PG_PASSWORD", "pg.password", "s"),
    ek("CANOPUS_PRESET", "preset", "s"), ek("CANOPUS_TOOLS_DIR", "tools_dir", "s")
]

/// The layer of the variables CANOPUS_*. A variable with a wrong value (a number that is not one) is skipped here: the settings of the hub say what is wrong.
export fn env_layer() Os -> Layer {
    mut o = JsonObject.new()
    for k in env_keys() {
        match cfg_env(k.var) {
            None => ()
            Some(text) => {
                if k.kind == "i" {
                    match text.to_int() {
                        Ok(n) => { o = put_path(o, k.key, JsonValue.int(n)) }
                        Err(e) => ()
                    }
                } else if k.kind == "b" {
                    if text == "true" || text == "1" { o = put_path(o, k.key, JsonValue.bool(true)) }
                    if text == "false" || text == "0" { o = put_path(o, k.key, JsonValue.bool(false)) }
                } else {
                    o = put_path(o, k.key, JsonValue.str(text))
                }
            }
        }
    }
    match cfg_env("CANOPUS_SERVER_AGENT") {
        Some(command) => {
            mut words = []str.new()
            for word in command.split(" ") { if word.byte_len() > 0 { words.push(word) } }
            if words.len() > 0 {
                mut args = []JsonValue.new()
                mut i = 1
                while i < words.len() { args.push(JsonValue.str(words[i])); i += 1 }
                mut agent = JsonObject.new()
                ign(agent.insert("id", JsonValue.str("opencode")))
                ign(agent.insert("label", JsonValue.str("OpenCode")))
                ign(agent.insert("program", JsonValue.str(words[0])))
                ign(agent.insert("args", JsonValue.array(args)))
                ign(agent.insert("ask", JsonValue.str("native")))
                mut agents = []JsonValue.new()
                agents.push(JsonValue.object(agent))
                o = put_path(o, "agents", JsonValue.array(agents))
            }
        }
        None => ()
    }
    match cfg_env("CANOPUS_SERVER_HUB") {
        Some(command) => {
            mut words = []str.new()
            for word in command.split(" ") { if word.byte_len() > 0 { words.push(word) } }
            if words.len() > 0 {
                o = put_path(o, "hub.program", JsonValue.str(words[0]))
                mut args = []JsonValue.new()
                mut i = 1
                while i < words.len() { args.push(JsonValue.str(words[i])); i += 1 }
                o = put_path(o, "hub.args", JsonValue.array(args))
            }
        }
        None => ()
    }
    { origin: "env", file: "", obj: o, text: "" }
}

// ----- the refusal of the old names of the variables (task 284) -----

/// "" when the environment is clean, else the refusal text. A set old variable (`CANOPUS_X` for the new // guard-allow(legacy-name): карта переименования — назначение функции
/// `CANOPUS_X`) is a clear refusal with the new name: the old value is never read, there is no fallback
/// and no silent choice of another empty folder (the rename Canopus -> Canopus is one moment). guard-allow(legacy-name): карта переименования — назначение функции
fn retired_env_names() -> []str {
    mut names = ["CANOPUS_HOME", "CANOPUS_SERVER_CONFIG", "CANOPUS_SERVER_AGENT", "CANOPUS_SERVER_HUB", "CANOPUS_PG_CONFIG", "CANOPUS_OPENCODE_KEEP_PLUGIN", "CANOPUS_PREPARATION_SERVICE_REGISTRATION", "CANOPUS_PREPARATION_MODEL", "CANOPUS_PREPARATION_VARIANT", "CANOPUS_PREPARATION_ADAPTER", "CANOPUS_GIT_LOG"]
    for k in env_keys() { names.push(k.var) }
    names
}

export fn legacy_env_problem() Os -> str {
    mut out = []str.new()
    for n in retired_env_names() {
        ro old = "CREW_${n[8..]}" // guard-allow(legacy-name): вывод старого имени из нового — назначение функции
        match cfg_env(old) {
            Some(v) => out.push("${old} -> ${n} is retired; use --config <file>; technical values are named code policy")
            None => ()
        }
    }
    out.join(", ")
}

/// Retired runtime inputs fail by name only; never quote a value or a secret.
export fn retired_env_problem() Os -> str {
    mut found = []str.new()
    for name in retired_env_names() { if cfg_env(name).is_some() { found.push(name) } }
    if found.len() == 0 { "" } else { "runtime environment settings are no longer supported: ${found.join(", ")}; use --config <file>" }
}

/// The layer of the words `key=value` of `--set`.
export fn arg_layer(sets []str) -> Layer {
    mut o = JsonObject.new()
    for w in sets {
        match w.split_once("=") {
            Some((k, v)) => { if k.byte_len() > 0 { o = put_path(o, k, guess_value(v)) } }
            None => ()
        }
    }
    { origin: "arg", file: "", obj: normalize_layer(o), text: "" }
}

// ----- the files of the layers -----

/// The files of the layers in order, for `canopus doctor`: (origin, file).
export fn layer_files(layout ConfigLayout, server_file str) -> [](str, str) {
    mut out = [](str, str).new()
    if layout.config.byte_len() > 0 { out.push(("user", layout.config_file)) }
    if server_file.byte_len() > 0 { out.push(("server", server_file)) }
    if layout.project.byte_len() > 0 {
        out.push(("project", "${layout.project}/config.json"))
    }
    if layout.config.byte_len() > 0 { out.push(("secret", "${layout.config}/secrets.json")) }
    out
}

/// The file layers that exist, in the order of the rule. A file that is not JSON is an error `file:line: reason`. `server_file` that is named but missing is an error too (the caller checks that).
export fn file_layers(layout ConfigLayout, server_file str) Fs -> Result[[]Layer, str] {
    if layout.project.byte_len() > 0 {
        ro retired = match try_exists(Path.from_bytes("${layout.project}/local.json".bytes())) { Ok(v) => v, Err(e) => return Err("could not inspect retired project configuration") }
        if retired { return Err("local.json was removed; run the explicit two-level configuration transition") }
    }
    mut out = []Layer.new()
    for (origin, file) in layer_files(layout, server_file) {
        match read_layer(origin, file)? {
            Some(l) => {
                ro problems = validate_layer(l)
                if problems.len() > 0 { return Err(problems.join("\n")) }
                out.push(l)
            }
            None => ()
        }
    }
    Ok(out)
}

/// All the layers over the code: the files, then the variables, then the arguments.
export fn all_layers(layout ConfigLayout, server_file str, sets []str) Os Fs -> Result[[]Layer, str] {
    if server_file.byte_len() > 0 || sets.len() > 0 { return Err("runtime overrides are no longer supported; use --config <file>") }
    ro problem = retired_env_problem()
    if problem.byte_len() > 0 { return Err(problem) }
    file_layers(layout, "")
}

/// The folders of the modes in order of priority: the project, the user ("" are left out).
export fn modes_dirs(layout ConfigLayout) -> []str {
    mut out = []str.new()
    if layout.project.byte_len() > 0 { out.push("${layout.project}/modes") }
    if layout.config.byte_len() > 0 { out.push("${layout.config}/modes") }
    out
}

/// The folders of the presets in order of priority: the project, the user.
export fn presets_dirs(layout ConfigLayout) -> []str {
    mut out = []str.new()
    if layout.project.byte_len() > 0 { out.push("${layout.project}/presets") }
    if layout.config.byte_len() > 0 { out.push("${layout.config}/presets") }
    out
}

/// The files of the roles in order of priority: the project, the user.
export fn roles_files(layout ConfigLayout) -> []str {
    mut out = []str.new()
    if layout.project.byte_len() > 0 { out.push("${layout.project}/roles.json") }
    if layout.config.byte_len() > 0 { out.push("${layout.config}/roles.json") }
    out
}

/// The folder of the tools: CANOPUS_TOOLS_DIR, else the layout (`<home>/tools`); the setting `voice.dir` still moves the recognizer alone.
export fn tools_dir_now(layout ConfigLayout) Os -> str => layout.tools
