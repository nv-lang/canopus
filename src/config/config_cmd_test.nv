// config_cmd_test.nv - `config list|get|set`, the schema and `doctor` (task 192.12).
module canopus.config

import std.os.{Os, MockOs, mock_os, real_os, temp_dir, pid}
import std.fs.{Fs, real_fs, read_text, write_text, create_dir_all, remove_dir_all, Path}
import std.encoding.json.{Json, JsonValue, JsonObject}

fn tmp3(name str) -> str {
    ro base = with Os = real_os() { temp_dir() }
    ro id = with Os = real_os() { pid() }
    ro dir = base.join("canopus-cmd-${name}-${id}")
    with Fs = real_fs() {
        ro gone = remove_dir_all(dir)
        ro made = create_dir_all(dir)
    }
    dir.display().replace("\\", "/")
}

fn drop3(root str) -> () {
    with Fs = real_fs() {
        ro gone = remove_dir_all(Path.from_bytes(root.bytes()))
    }
}

fn put3(root str, rel str, text str) -> () {
    ro path = Path.from_bytes("${root}/${rel}".bytes())
    with Fs = real_fs() {
        match path.parent() {
            Some(p) => { ro made = create_dir_all(p) }
            None => ()
        }
        ro written = write_text(path, text)
    }
}

fn line_of(text str, key str) -> str {
    for line in text.split("\n") {
        if line.starts_with("${key}=") { return line }
    }
    ""
}

fn listing(layout ConfigLayout, server str, sets []str, origin bool, envs []str) -> str {
    mut state = MockOs.new()
    for pair in envs {
        match pair.split_once("=") {
            Some((k, v)) => state.put_env(k, v)
            None => ()
        }
    }
    match with Os = mock_os(state), Fs = real_fs() { config_list(layout, server, sets, origin) } {
        Ok(t) => t
        Err(e) => panic("list: ${e}")
    }
}

test "schema: every default is JSON of its kind" {
    for k in known_keys() {
        match Json.parse(k.default_text) {
            Err(e) => assert(false)
            Ok(v) => assert(kind_ok(k.kind, v))
        }
    }
}

test "list: only the five public fields are shown with their file origins" {
    ro root = tmp3("origin")
    put3(root, "inst/config.json", "{\"port\":8100,\"voice\":{\"model\":\"medium\"}}")
    put3(root, "repo/.canopus/config.json", "{\"port\":8101}")
    put3(root, "repo/.canopus/local.json", "{\"voice\":{\"language\":\"ru\"}}")
    ro layout = layout_in("${root}/inst", "${root}/repo/.canopus")
    ro text = listing(layout, "", []str.new(), true, []str.new())
    assert(text.split("\n").collect().len() == 5)
    assert(line_of(text, "port").starts_with("port=8101\tproject\t"))
    assert(line_of(text, "store").starts_with("store=files\tdefault"))
    assert(line_of(text, "voice.model").starts_with("voice.model=medium\tuser"))
    assert(line_of(text, "voice.language").starts_with("voice.language=ru\tlocal"))
    assert(!text.contains("data_dir") && !text.contains("hub.") && !text.contains("route_"))
    drop3(root)
}

test "list: plain output has no origins and runtime overrides are refused" {
    ro root = tmp3("plain")
    ro layout = layout_in("${root}/inst", "")
    ro text = listing(layout, "", []str.new(), false, []str.new())
    assert(!text.contains("\t") && text.split("\n").collect().len() == 5)
    mut state = MockOs.new()
    state.put_env("CANOPUS_PG_PASSWORD", "not-printed-value")
    match with Os = mock_os(state), Fs = real_fs() { config_list(layout, "", []str.new(), true) } {
        Ok(t) => assert(false)
        Err(e) => assert(e.contains("CANOPUS_PG_PASSWORD") && !e.contains("not-printed-value"))
    }
    drop3(root)
}

test "secrets: database URL is masked on explicit get and absent from public list" {
    ro root = tmp3("secret")
    put3(root, "inst/secrets.json", "{\"database_url\":\"placeholder\"}")
    ro layout = layout_in("${root}/inst", "")
    ro quiet = listing(layout, "", []str.new(), true, []str.new())
    assert(!quiet.contains("placeholder") && line_of(quiet, "database_url") == "")
    match with Os = mock_os(MockOs.new()), Fs = real_fs() { config_get(layout, "", []str.new(), "database_url", false) } {
        Ok(t) => assert(t == "***")
        Err(e) => assert(false)
    }
    drop3(root)
}

test "get: a value, with the origin, and an error for an unknown key" {
    ro root = tmp3("get")
    put3(root, "inst/config.json", "{\"port\":8100}")
    ro layout = layout_in("${root}/inst", "")
    match with Os = mock_os(MockOs.new()), Fs = real_fs() { config_get(layout, "", []str.new(), "port", true) } {
        Ok(t) => assert(t == "8100\tuser\t${root}/inst/config.json")
        Err(e) => assert(false)
    }
    match with Os = mock_os(MockOs.new()), Fs = real_fs() { config_get(layout, "", []str.new(), "nothing", false) } {
        Ok(t) => assert(false)
        Err(e) => assert(e.contains("nothing"))
    }
    drop3(root)
}

test "set: writes the key into the file of the scope and keeps the other keys" {
    ro root = tmp3("set")
    put3(root, "inst/config.json", "{\"port\":8100,\"voice\":{\"model\":\"medium\"}}")
    put3(root, "repo/.canopus/config.json", "{}")
    ro layout = layout_in("${root}/inst", "${root}/repo/.canopus")
    with Fs = real_fs() {
        assert(config_set(layout, "user", "", "voice.language", "ru").is_ok())
        assert(config_set(layout, "project", "", "port", "8102").is_ok())
        assert(config_set(layout, "local", "", "voice.language", "en").is_ok())
        ro user = read_text(Path.from_bytes("${root}/inst/config.json".bytes())).unwrap()
        assert(user.contains("\"port\": 8100") && user.contains("\"model\": \"medium\"") && user.contains("\"language\": \"ru\""))
        ro project = read_text(Path.from_bytes("${root}/repo/.canopus/config.json".bytes())).unwrap()
        assert(project.contains("\"port\": 8102"))
        ro local = read_text(Path.from_bytes("${root}/repo/.canopus/local.json".bytes())).unwrap()
        assert(local.contains("\"language\": \"en\""))
    }
    drop3(root)
}

test "set: a wrong key, a wrong value, a list and a secret are refused" {
    ro layout = layout_in("C:/work/nowhere/home", "")
    with Fs = real_fs() {
        assert(config_set(layout, "user", "", "no_such_key", "1").is_err())
        assert(config_set(layout, "user", "", "port", "abc").is_err())
        assert(config_set(layout, "user", "", "route_wip", "maybe").is_err())
        assert(config_set(layout, "user", "", "agents", "x").is_err())
        match config_set(layout, "user", "", "pg.password", "s3cret") {
            Ok(t) => assert(false)
            Err(e) => assert(!e.contains("s3cret"))
        }
        assert(config_set(layout_in("", ""), "user", "", "port", "1").is_err())
    }
}

test "validate: wrong kinds and unknown keys name the source; secrets are never quoted" {
    match read_layer_text("c.json", "{\n  \"port\": \"abc\",\n  \"colour\": 1,\n  \"database_url\": \"placeholder\"\n}") {
        Err(e) => assert(false)
        Ok(l) => {
            ro problems = validate_layer(l)
            assert(problems.len() == 3)
            assert(problems[0] == "c.json:2: port must be a whole number")
            assert(problems[1] == "c.json:3: unknown key colour")
            assert(problems[2].starts_with("c.json:4: database_url is a secret"))
            assert(!problems[2].contains("placeholder"))
        }
    }
}

fn read_layer_text(file str, text str) -> Result[Layer, str] {
    match Json.parse(text) {
        Ok(v) => Ok({ origin: "user", file, obj: normalize_layer(v.object() ?? JsonObject.new()), text })
        Err(e) => Err(json_error_text(e))
    }
}

test "doctor: lists the paths, a broken file is a problem with file:line, a good home is ok" {
    ro root = tmp3("doctor")
    put3(root, "good/config.json", "{\"port\":8100}")
    ro good = with Os = mock_os(MockOs.new()), Fs = real_fs() { doctor(layout_in("${root}/good", ""), "", "--home", "${root}") }
    assert(good.errors == 0)
    assert(good.text.contains("home: ${root}/good  (--home)"))
    assert(good.text.contains("user: ${root}/good/config.json  ok"))
    put3(root, "bad/config.json", "{\n  \"port\": oops\n}")
    ro bad = with Os = mock_os(MockOs.new()), Fs = real_fs() { doctor(layout_in("${root}/bad", ""), "", "CANOPUS_HOME", "${root}") }
    assert(bad.errors == 1)
    assert(bad.text.contains("${root}/bad/config.json:2:"))
    assert(!bad.text.contains("oops"))
    drop3(root)
}

test "doctor: the old flat layout and an unknown key are named" {
    ro root = tmp3("legacy")
    put3(root, "srv.json", "{\"colour\":1}")
    ro layout = layout_with_data_dir("${root}/inst", "${root}/old-data", "")
    ro report = with Os = mock_os(MockOs.new()), Fs = real_fs() { doctor(layout, "${root}/srv.json", "CANOPUS_HOME", "${root}") }
    assert(report.text.contains("layout: OLD (flat)"))
    assert(report.text.contains("migrate --from ${root}/old-data"))
    assert(report.text.contains("unknown key colour"))
    assert(report.errors == 1)
    drop3(root)
}
