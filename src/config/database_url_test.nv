module canopus.config

import std.encoding.json.{JsonObject}

fn database_url_fixture(tail str) -> str => "postgresql://${tail}"
fn database_url_ok(tail str) -> JsonObject {
    match parse_database_url(database_url_fixture(tail)) {
        Ok(value) => value
        Err(error) => { assert(false); JsonObject.new() }
    }
}

test "database URL preserves URI plus, escaped delimiters and Unicode" {
    ro value = database_url_ok("u%2Bser:p+%40%3A%2F%25@localhost:15432/%D0%B1%D0%B0%D0%B7%D0%B0%2Fname")
    assert(value.get("user").unwrap().str() == Some("u+ser"))
    assert(value.get("password").unwrap().str() == Some("p+@:/%"))
    assert(value.get("database").unwrap().str() == Some("база/name"))
    assert(value.get("host").unwrap().str() == Some("localhost"))
    assert(value.get("port").unwrap().int() == Some(15432))
}

test "database URL supports IPv6 authority and encoded Unicode credentials" {
    ro value = database_url_ok("%D1%8E:%D0%BF%D0%B0%D1%80%D0%BE%D0%BB%D1%8C@[::1]:55432/db+name")
    assert(value.get("user").unwrap().str() == Some("ю"))
    assert(value.get("password").unwrap().str() == Some("пароль"))
    assert(value.get("host").unwrap().str() == Some("::1"))
    assert(value.get("port").unwrap().int() == Some(55432))
    assert(value.get("database").unwrap().str() == Some("db+name"))
}

test "database URL defaults match the existing local connection configuration" {
    ro value = database_url_ok("")
    assert(value.get("host").unwrap().str() == Some("127.0.0.1"))
    assert(value.get("port").unwrap().int() == Some(5432))
    assert(value.get("database").unwrap().str() == Some("canopus"))
    assert(value.get("user").unwrap().str() == Some("canopus_app"))
    assert(value.get("password").unwrap().str() == Some(""))
    ro alias_tail = "user:pw@localhost/db"
    match parse_database_url("POSTGRES://${alias_tail}") {
        Ok(parsed) => assert(parsed.get("user").unwrap().str() == Some("user"))
        Err(error) => assert(false)
    }
}

test "database URL rejects ambiguous authority, ports, escapes and unsupported options without leaking credentials" {
    for tail in ["u:pw@localhost:0/db", "u:pw@localhost:65536/db", "u:pw@localhost:+1/db", "u:pw@localhost:/db", "u:pw@::1/db", "u:pw@[::1/db", "u:pw@[::1]extra/db", "u:pw@localhost/db/path", "u:pw@localhost/db?sslmode=require", "u:pw@localhost/db#fragment", "u:pw@localhost/%GG", "u:pw@localhost/%FF", "u:pw@localhost/%00", "u:pw@localhost/db name", "u:pw@host@localhost/db", ":pw@localhost/db"] {
        match parse_database_url(database_url_fixture(tail)) {
            Ok(value) => assert(false)
            Err(error) => { assert(error.byte_len() > 0); assert(!error.contains(tail)); assert(!error.contains("pw")) }
        }
    }
    ro wrong_scheme_tail = "u:pw@localhost/db"
    match parse_database_url("https://${wrong_scheme_tail}") {
        Ok(value) => assert(false)
        Err(error) => assert(!error.contains("pw"))
    }
}
