module crew_harness.config

import std.encoding.json.{Json}

test "269: pools active exact models at the requested level only, deterministic entropy" {
    ro pools = parse_model_pools(Json.parse("{\"mix\":{\"heavy\":[{\"family\":\"a\",\"model\":\"one\",\"effort\":\"low\"},{\"family\":\"a\",\"model\":\"off\",\"active\":false},{\"family\":\"a\",\"model\":\"missing\"},{\"family\":\"b\",\"model\":\"two\",\"effort\":\"max\"}]}}").unwrap()).unwrap()
    ro available = [PoolEntry { family: "a", model: "one", effort: "", active: true }, PoolEntry { family: "a", model: "off", effort: "", active: true }, PoolEntry { family: "b", model: "two", effort: "", active: true }]
    ro first = resolve_pool(pools, "mix", "heavy", available, 0).unwrap()
    ro second = resolve_pool(pools, "mix", "heavy", available, 1).unwrap()
    assert(first.model == "one" && first.effort == "low")
    assert(second.model == "two" && second.effort == "max")
    assert(resolve_pool(pools, "mix", "heavy", available, 3).unwrap().model == "two")
    assert(resolve_pool(pools, "mix", "light", available, 0).is_err())
    assert(resolve_pool(pools, "mix", "heavy", [], 0).is_err())
    assert(resolve_pool(pools, "absent", "heavy", available, 0).is_err())
    assert(resolve_pool(pools, "mix", "heavy", available, -1).is_err())
}

test "269: pools strict schema and native effort do not depend on level" {
    assert(parse_model_pools(Json.parse("{\"x\":{\"max\":[]}}").unwrap()).is_err())
    assert(parse_model_pools(Json.parse("{\"x\":{\"light\":[{\"family\":\"a\",\"model\":\"m\",\"active\":\"yes\"}]}}").unwrap()).is_err())
    assert(parse_model_pools(Json.parse("{\"x\":{\"light\":[{\"family\":\"a\"}]}}").unwrap()).is_err())
    assert(parse_preset("p", "user", "p.json", "{\"roles\":{\"dev\":{\"pool\":\"x\",\"level\":\"light\",\"family\":\"a\"}},\"pools\":{\"x\":{}}}").is_err())
    assert(parse_preset("p", "user", "p.json", "{\"roles\":{\"dev\":{\"pool\":\"unknown\",\"level\":\"light\"}}}").is_err())
}

test "269: sources legacy roles and explicit model effort survive roundtrip" {
    ro old = parse_preset("p", "user", "p.json", "{\"roles\":{\"dev\":{\"family\":\"a\",\"model\":\"m\",\"effort\":\"high\"}}}").unwrap()
    ro pick = preset_pick(old, "dev").unwrap()
    assert(pick.family == "a" && pick.model == "m" && pick.effort == "high")
    assert(pick.pool == "" && pick.level == "" && old.pools.len() == 0)
    ro body = presets_json([old], "p", builtin_roles())
    assert(body.contains("high") && body.contains("pools"))
}

test "269: pools retain a pinned selection, replace a disabled or unavailable entry across families" {
    ro first = PoolEntry { family: "a", model: "one", effort: "high", active: true }
    ro second = PoolEntry { family: "b", model: "two", effort: "low", active: true }
    ro pools = [ModelPool { name: "mix", levels: [PoolLevel { level: "heavy", entries: [first, second] }] }]
    assert(resolve_pool_pinned(pools, "mix", "heavy", [first, second], Some(first), 1).unwrap().family == "a")
    ro disabled = PoolEntry { family: first.family, model: first.model, effort: first.effort, active: false }
    ro changed = [ModelPool { name: "mix", levels: [PoolLevel { level: "heavy", entries: [disabled, second] }] }]
    assert(resolve_pool_pinned(changed, "mix", "heavy", [first, second], Some(first), 0).unwrap().family == "b")
    assert(resolve_pool_pinned(pools, "mix", "heavy", [second], Some(first), 0).unwrap().family == "b")
    assert(resolve_pool_pinned(changed, "mix", "heavy", [], Some(first), 0).is_err())
}
