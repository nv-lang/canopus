// The hub-side transport. Keep socket I/O in a fiber so the ACP pump can stay nonblocking.
module canopus.daemon

import canopus.acp.{AgentLink, DaemonTicket, Inbound, LEGACY_DAEMON_ID}
import canopus.projects.{EnvEntry}
import std.concurrency.nvchan.{Chan, ChanRx, ChanTx}
import std.encoding.base64.{Base64}
import std.encoding.hex.{Hex}
import std.encoding.json.{Json, JsonObject, JsonValue}
import std.fs.{Fs, Path, read_text, try_exists, real_fs}
import std.net.{Net, SocketAddr, TcpStream}

type DaemonTarget { id str, address SocketAddr, cwd str, key_path str }
export type DaemonEndpoint { id str, address SocketAddr, key str, cwd str, state_dir str }

const RECONNECT_MS = 60000

type RelayAgent { endpoint DaemonEndpoint, session str, owner str, instance str }
type RelayCursor { after int, stderr str, eof bool, exited bool }

fn daemon_target(id str, config JsonObject, key_path str) -> Result[DaemonTarget, str] {
    ro port = number(config, "port") ?? 0
    if port < 1 || port > 65535 { return Err("invalid daemon port") }
    ro host = (config.get("host") ?? JsonValue.str("127.0.0.1")).str().ok_or("invalid daemon host")?
    ro address = daemon_address(host, port)?
    ro cwd = (config.get("cwd") ?? JsonValue.str("")).str().ok_or("invalid daemon working directory")?
    if cwd != "" && !cwd.starts_with("/") { return Err("daemon working directory must be an absolute Linux path") }
    Ok(DaemonTarget { id, address, cwd, key_path })
}

fn valid_daemon_id(id str) -> bool {
    if id.byte_len() == 0 || id.byte_len() > 64 { return false }
    for byte in id.bytes() {
        ro code = byte as int
        ro letter = code >= 97 && code <= 122
        ro digit = code >= 48 && code <= 57
        if !letter && !digit && code != 45 && code != 95 { return false }
    }
    true
}

fn parse_daemons(entries []JsonValue, state_dir str) -> Result[[]DaemonTarget, str] {
    mut ids = []str.new()
    mut targets = []DaemonTarget.new()
    for entry in entries {
        ro config = entry.object().ok_or("invalid daemon entry")?
        ro id = text(config, "id")
        if !valid_daemon_id(id) { return Err("invalid daemon ID") }
        if ids.contains(id) { return Err("duplicate daemon ID: ${id}") }
        ids.push(id)
        targets.push(daemon_target(id, config, "${state_dir}/daemon-keys/${id}.key")?)
    }
    Ok(targets)
}

fn static_daemon_targets(state_dir str) Fs -> Result[[]DaemonTarget, str] {
    if state_dir.byte_len() == 0 { return Ok([]DaemonTarget.new()) }
    ro endpoint_path = Path.from_bytes("${state_dir}/daemon.json".bytes())
    ro configured = match try_exists(endpoint_path) {
        Ok(found) => found
        Err(e) => return Err("cannot inspect daemon configuration")
    }
    if !configured { return Ok([]DaemonTarget.new()) }
    ro source = match read_text(endpoint_path) {
        Ok(content) => content
        Err(e) => return Err("cannot read daemon configuration")
    }
    ro config = match Json.parse(source) {
        Ok(value) => value.object().ok_or("invalid daemon configuration")?
        Err(e) => return Err("invalid daemon configuration")
    }
    match config.get("daemons") {
        Some(value) => {
            ro entries = value.array().ok_or("daemon configuration requires an array of daemons")?
            parse_daemons(entries, state_dir)
        }
        None => Ok([daemon_target(LEGACY_DAEMON_ID, config, "${state_dir}/daemon.key")?])
    }
}

fn daemon_targets(state_dir str) Fs -> Result[[]DaemonTarget, str] {
    mut targets = []DaemonTarget.new()
    mut static_ids = []str.new()
    for target in static_daemon_targets(state_dir)? {
        static_ids.push(target.id)
        if !is_revoked(state_dir, target.id)? { targets.push(target) }
    }
    for id in enrollment_ids(state_dir)? {
        ro row = match enrollment_read(state_dir, id)? { Some(value) => value, None => { continue } }
        if text(row, "phase") != "active" { continue }
        if static_ids.contains(id) { return Err("duplicate daemon ID: ${id}") }
        targets.push(daemon_target(id, row, "")?)
    }
    Ok(targets)
}

export fn daemon_ids(state_dir str) Fs -> Result[[]str, str] {
    mut ids = []str.new()
    for target in daemon_targets(state_dir)? { ids.push(target.id) }
    Ok(ids)
}

export fn daemon_revocation(state_dir str, id str) Fs -> Result[(), str] {
    if is_revoked(state_dir, id)? { return Err("daemon revoked: daemon ${id} was revoked") }
    Ok(())
}

/// With no pinned ID the first entry is the default. Only the selected daemon's key is read.
export fn daemon_endpoint(state_dir str, pinned str) Fs -> Result[Option[DaemonEndpoint], str] {
    daemon_revocation(state_dir, pinned)?
    for target in daemon_targets(state_dir)? {
        if pinned == "" || pinned == target.id { return Ok(Some(read_daemon_key(target, state_dir)?)) }
    }
    Ok(None)
}

fn read_daemon_key(target DaemonTarget, state_dir str) Fs -> Result[DaemonEndpoint, str] {
    ro key = if target.key_path == "" {
        ro row = enrollment_read(state_dir, target.id)?.ok_or("cannot read enrolled daemon key")?
        text(row, "key")
    } else {
        match read_text(Path.from_bytes(target.key_path.bytes())) {
            Ok(content) => content.trim()
            Err(e) => return Err("cannot read daemon key")
        }
    }
    if !valid_key(key) { return Err("invalid daemon key") }
    Ok(DaemonEndpoint { id: target.id, address: target.address, key, cwd: target.cwd, state_dir })
}

fn request_for(agent RelayAgent, op str) -> JsonObject {
    mut body = JsonObject.new()
    put(body, "version", JsonValue.int(VERSION))
    put(body, "daemon_id", JsonValue.str(agent.endpoint.id))
    put(body, "key", JsonValue.str(agent.endpoint.key))
    put(body, "session", JsonValue.str(agent.session))
    put(body, "owner", JsonValue.str(agent.owner))
    put(body, "instance", JsonValue.str(agent.instance))
    put(body, "op", JsonValue.str(op))
    body
}

fn exchange_once(address SocketAddr, body JsonObject, limit int = WIRE_LIMIT) Net -> Result[JsonObject, str] {
    consume sock = match TcpStream.connect(address) {
        Ok(consume connected) => connected
        Err(e) => return Err("cannot connect to the daemon")
    }
    ro wire = "${JsonValue.object(body).to_str()}\n"
    ro reply = match sock.write_all(wire.bytes()) {
        Ok(done) => match read_daemon_message(sock, limit: limit) {
            Some(response) => Ok(response)
            None => Err("daemon closed the connection without a response")
        }
        Err(e) => Err("cannot write to the daemon")
    }
    sock.close()
    reply
}

fn exchange(endpoint DaemonEndpoint, body JsonObject) Net Time -> Result[JsonObject, str] {
    with Fs = real_fs() { daemon_revocation(endpoint.state_dir, endpoint.id) }?
    // A revocation written while this socket waits takes effect before its reply is delivered.
    ro reply = supervised(timeout: SOCKET_MS.to_millis(), on_timeout: |_e| Err("daemon request timed out")) {
        exchange_once(endpoint.address, body)
    }
    with Fs = real_fs() { daemon_revocation(endpoint.state_dir, endpoint.id) }?
    reply
}

fn daemon_reply(agent RelayAgent, body JsonObject) Net Time -> Result[JsonObject, str] {
    checked_reply(agent, exchange(agent.endpoint, body)?)
}

fn checked_reply(agent RelayAgent, reply JsonObject) -> Result[JsonObject, str] {
    ro failure = text(reply, "error")
    if failure.byte_len() > 0 { return Err("daemon ${failure}: ${text(reply, "message")}") }
    if number(reply, "version") != Some(VERSION) || text(reply, "instance").byte_len() == 0 {
        return Err("invalid daemon response")
    }
    if agent.instance.byte_len() > 0 && text(reply, "instance") != agent.instance {
        return Err("daemon agent instance changed")
    }
    Ok(reply)
}

fn send_agent_line(agent RelayAgent, line str) Net Time -> Result[(), str] {
    mut body = request_for(agent, "send")
    put(body, "data", JsonValue.str(Base64.encode("${line}\n".bytes())))
    ro reply = daemon_reply(agent, body)?
    Ok(())
}

fn decode_frame(frame JsonObject, seq int) -> Result[Inbound, str] {
    ro kind = text(frame, "kind")
    if kind == "line" {
        ro bytes = match Base64.decode(text(frame, "data")) {
            Ok(value) => value
            Err(e) => return Err("invalid ACP frame from daemon")
        }
        mut last = bytes.len()
        if last > 0 && bytes[last - 1] == (10 as u8) { last -= 1 }
        if last > 0 && bytes[last - 1] == (13 as u8) { last -= 1 }
        ro line = match bytes[..last].to_str() {
            Ok(value) => value
            Err(e) => return Err("ACP frame is not UTF-8")
        }
        return Ok(Inbound { kind, text: line, code: 0, seq })
    }
    if kind != "exit" && kind != "eof" && kind != "error" { return Err("unknown daemon frame") }
    Ok(Inbound { kind, text: text(frame, "data"), code: number(frame, "code") ?? -1, seq })
}

fn deliver(reply JsonObject, mut cursor RelayCursor, inbox ChanTx[Inbound]) -> Result[(), str] {
    ro diagnostics = text(reply, "stderr")
    if diagnostics != cursor.stderr && inbox.try_send(Inbound { kind: "stderr_tail", text: diagnostics, code: 0, seq: 0 }) {
        cursor.stderr = diagnostics
    }
    ro frames = (reply.get("frames") ?? JsonValue.null()).array().ok_or("invalid daemon frame list")?
    for value in frames {
        ro frame = value.object().ok_or("invalid daemon frame")?
        ro seq = number(frame, "seq") ?? 0
        if seq != cursor.after + 1 { return Err("daemon frame sequence gap") }
        ro item = decode_frame(frame, seq)?
        if !inbox.try_send(item) { break }
        cursor.after = seq
        if item.kind == "eof" { cursor.eof = true }
        if item.kind == "exit" { cursor.exited = true }
    }
    Ok(())
}

fn poll_agent(agent RelayAgent, after int, lease_until int) Net Time -> Result[JsonObject, str] {
    mut body = request_for(agent, "poll")
    put(body, "after", JsonValue.int(after))
    ro network_until = if agent.endpoint.address.ip() == "127.0.0.1" { 0 } else { now_ms() + RECONNECT_MS }
    while true {
        match exchange(agent.endpoint, body) {
            Ok(reply) => {
                if text(reply, "error") != "busy" || now_ms() >= lease_until { return checked_reply(agent, reply) }
            }
            Err(reason) => {
                with Fs = real_fs() { daemon_revocation(agent.endpoint.state_dir, agent.endpoint.id) }?
                // Poll is read-only with respect to ACP and can safely use the same cursor again.
                if now_ms() >= network_until { return Err(reason) }
            }
        }
        100.to_millis().sleep()
    }
    Err("daemon did not answer")
}

fn relay(agent RelayAgent, after int, incoming ChanTx[Inbound], outgoing ChanRx[str], killing ChanRx[int]) Net Time -> Result[(), str] {
    mut cursor = RelayCursor { after, stderr: "", eof: false, exited: false }
    ro attached = poll_agent(agent, after, now_ms() + LEASE_MS + 1000)?
    deliver(attached, cursor, incoming)?
    mut stop_at = 0
    while !(cursor.eof && cursor.exited) {
        match killing.try_recv() {
            Some(signal) => {
                if signal == 2 { return Ok(()) }
                if stop_at == 0 {
                    ro stopped = daemon_reply(agent, request_for(agent, "stop"))?
                    stop_at = now_ms() + 1500
                }
            }
            None => ()
        }
        if stop_at > 0 && now_ms() >= stop_at { return Err("daemon did not confirm agent exit") }
        if stop_at == 0 && !cursor.eof {
            match outgoing.try_recv() {
                Some(line) => {
                    // A timed-out send may already have reached the agent. A retry could run the turn twice.
                    send_agent_line(agent, line)?
                }
                None => ()
            }
        }
        ro reply = poll_agent(agent, cursor.after, 0)?
        ro before = cursor.after
        deliver(reply, cursor, incoming)?
        if before == cursor.after { 100.to_millis().sleep() }
    }
    Ok(())
}

fn keep_relay(agent RelayAgent, after int, incoming ChanTx[Inbound], outgoing ChanRx[str], killing ChanRx[int]) Net Time -> () {
    match relay(agent, after, incoming, outgoing, killing) {
        Ok(done) => ()
        Err(reason) => {
            ro stopped = daemon_reply(agent, request_for(agent, "stop"))
            ro kind = if reason.starts_with("daemon revoked:") { "daemon_revoked" } else { "error" }
            ro told = incoming.send(Inbound { kind, text: reason, code: -1, seq: 0 })
            ro exit = incoming.try_send(Inbound { kind: "exit", text: "", code: -1, seq: 0 })
            ro eof = incoming.try_send(Inbound { kind: "eof", text: "", code: 0, seq: 0 })
        }
    }
}

export fn connect_daemon(endpoint DaemonEndpoint, program str, args []str, dir str, env []EnvEntry) Net Time Detach Random -> Result[AgentLink, str] {
    mut agent = RelayAgent { endpoint, session: Hex.encode(Random.bytes(24)), owner: Hex.encode(Random.bytes(24)), instance: "" }
    mut body = request_for(agent, "start")
    put(body, "program", JsonValue.str(program))
    put(body, "cwd", JsonValue.str(dir))
    mut argv = []JsonValue.new()
    for arg in args { argv.push(JsonValue.str(arg)) }
    put(body, "args", JsonValue.array(argv))
    mut variables = []JsonValue.new()
    for entry in env {
        mut item = JsonObject.new()
        put(item, "key", JsonValue.str(entry.key))
        put(item, "value", JsonValue.str(entry.value))
        variables.push(JsonValue.object(item))
    }
    put(body, "env", JsonValue.array(variables))
    ro started = daemon_reply(agent, body)?
    agent.instance = text(started, "instance")
    Ok(relay_link(agent, number(started, "pid") ?? -1, 0))
}

export fn resume_daemon(endpoint DaemonEndpoint, ticket DaemonTicket, after int) Net Time Detach Random -> AgentLink {
    ro agent = RelayAgent { endpoint, session: ticket.session, owner: Hex.encode(Random.bytes(24)), instance: ticket.instance }
    relay_link(agent, ticket.pid, after)
}

fn relay_link(agent RelayAgent, pid int, after int) Net Time Detach -> AgentLink {
    ro incoming = Chan[Inbound].new(64)
    ro outgoing = Chan[str].new(64)
    ro killing = Chan[int].new(1)
    ro incoming_tx = incoming.tx
    ro outgoing_rx = outgoing.rx
    ro killing_rx = killing.rx
    detach { keep_relay(agent, after, incoming_tx, outgoing_rx, killing_rx) }
    AgentLink { out: outgoing.tx, inb: incoming.rx, kill: killing.tx, pid, managed: true, ticket: Some(DaemonTicket { daemon_id: agent.endpoint.id, session: agent.session, instance: agent.instance, pid }) }
}
