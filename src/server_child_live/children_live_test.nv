// children_live_test.nv - the child sessions over a hub with the fake ACP agent in a repository (task 192.3): the scenario `scenario_route_children` of canopus.server/child_kit.nv.
// The scenario starts several ACP processes and performs real Git merges on Windows.
// Keep the individual waits bounded while allowing the entire integration scenario to finish.
// EXPECT_TIMEOUT_MS 360000
module canopus.server_child_live

import canopus.server.{kit_routes_children, scenario_route_children}

fn children_clean(report str) -> () {
    if report.byte_len() > 0 { panic("NOT AS IT MUST BE: ${report}") }
    assert(report == "")
}

test "files: the child sessions: a task of its own by default, a child task under its epic (any task becomes an epic), the way epic, an epic with no branch, a wait for a clash, the merge into the branch of the epic, unmerged children never hold the epic, the chain, a restart" {
    children_clean(scenario_route_children(kit_routes_children("route-children")))
}
