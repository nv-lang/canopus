// files.nv - the file handlers of the effects `Journal` and `Store` of the engine (task 095).
//
// The data folder holds a folder per session, named by the session id (task 192k; the paths are built in paths.nv only):
//   <id>/journal   the journal: one line of JSON per entry (the format of `journal_line`), appended;
//   <id>/snapshot  the snapshot: one JSON object, replaced as a whole (a temporary file, then a rename);
//   <id>/inbox     the incoming events of the ACP client that are not acknowledged yet (src/acp).
// The flat files of the older form (`<id>.journal` ...) are moved into the folders at the start of the hub (migrate.nv).
// A session id is checked (`valid_session_name`, paths.nv), so a path never leaves the data folder.
//
// A failed write is not an error value: the effects return plain values, a handler that cannot write stops the
// process (`panic`), the step is then not committed (rule 13 of the specification).
//
// Why a module of its own and not `src/engine/`: the engine knows effects and in-memory handlers only; the
// files bring `std.fs` into the program and the engine must stay free of it.
module canopus.storage

import alula.engine.{Journal, Store, JournalEntry, Snapshot, journal_line, parse_journal_line}
import std.encoding.json.{Json, JsonValue, JsonObject}
import std.concurrency.nvchan.{Chan, ChanTx, ChanRx}
import std.fs.{Fs, real_fs, File, Path, read, read_dir, create_dir_all, rename, metadata, remove_file, try_exists}
import std.io.{write_all, SeekFrom}

/// The data folder: created with its parents; false when it cannot be (a file is in the way, no rights).
export fn open_data_dir(root str) Fs -> bool {
    ro path = Path.from_bytes(root.bytes())
    match create_dir_all(path) {
        Err(e) => false
        Ok(done) => match metadata(path) {
            Ok(meta) => meta.is_dir()
            Err(e) => false
        }
    }
}

// Does the file end with a line break (or does not exist, or is empty)? A journal that does not was torn in a write.
fn ends_cleanly(path Path) Fs -> bool {
    match File.open(path) {
        Err(e) => true
        Ok(consume f) => {
            mut clean = true
            match f.metadata() {
                Err(e) => ()
                Ok(meta) => {
                    if meta.len() > 0 {
                        mut last []u8 = []u8.new()
                        last.resize(1, 0 as u8)
                        match f.read_at(last, meta.len() - 1) {
                            Ok(n) => { clean = n == 0 || last[0] == (10 as u8) }
                            Err(e) => ()
                        }
                    }
                }
            }
            match f.close() {
                Ok(done) => ()
                Err(e) => ()
            }
            clean
        }
    }
}

/// Append one line (a line break is added) to a file, creating it; a torn last line is first ended by a line break,
/// so the new line is not glued to it. True when the line is written and synced.
export fn append_line(path Path, line str) Fs -> bool {
    ro prefix = if ends_cleanly(path) { "" } else { "\n" }
    match File.append(path) {
        Err(e) => false
        Ok(consume f) => {
            ro written = write_all(f, "${prefix}${line}\n".bytes())
            mut ok = false
            match written {
                Ok(done) => { ok = true }
                Err(e) => ()
            }
            match f.sync_data() {
                Ok(done) => ()
                Err(e) => { ok = false }
            }
            match f.close() {
                Ok(done) => ()
                Err(e) => { ok = false }
            }
            ok
        }
    }
}

/// The non-empty lines of a file in order ("\r" at the end cut); a missing or unreadable file has none. The bytes are read
/// as they are and a broken UTF-8 sequence (a tear inside a letter) is replaced, so one torn line never hides the others.
export fn read_lines(path Path) Fs -> []str {
    mut out = []str.new()
    match read(path, buffer_size: 256 * 1024) {
        Err(e) => ()
        Ok(bytes) => {
            for raw in bytes.to_str_lossy().split("\n") {
                ro line = raw.strip_suffix("\r") ?? raw
                if line.byte_len() > 0 { out.push(line) }
            }
        }
    }
    out
}

/// Replace the whole file: the text goes to a temporary file beside it, is synced, and the file is renamed over the old
/// one. A process that dies leaves the old file or the new one, never half of a file. A temporary file left by an earlier
/// dead process is simply overwritten. True when the file is replaced.
export fn replace_file(path Path, text str) Fs -> bool {
    ro tmp = Path.from_bytes("${path.display()}.tmp".bytes())
    match File.create(tmp) {
        Err(e) => false
        Ok(consume f) => {
            mut ok = false
            match write_all(f, text.bytes()) {
                Ok(done) => { ok = true }
                Err(e) => ()
            }
            match f.sync_all() {
                Ok(done) => ()
                Err(e) => { ok = false }
            }
            match f.close() {
                Ok(done) => ()
                Err(e) => { ok = false }
            }
            if !ok {
                ro removed = remove_file(tmp)
                return false
            }
            match rename(tmp, path) {
                Ok(done) => true
                Err(e) => {
                    ro removed = remove_file(tmp)
                    false
                }
            }
        }
    }
}

fn snapshot_of(step int, data str) -> Snapshot => { step, data }

fn put(mut o JsonObject, key str, value JsonValue) -> () {
    ro replaced = o.insert(key, value)
}

fn snapshot_text(snapshot Snapshot) -> str {
    mut o = JsonObject.new()
    put(o, "step", JsonValue.int(snapshot.step))
    put(o, "data", JsonValue.str(snapshot.data))
    JsonValue.object(o).to_str()
}

// The snapshot of a file text; None when the text is not a snapshot.
fn parse_snapshot(text str) -> Option[Snapshot] {
    ro value = match Json.parse(text) {
        Ok(v) => v
        Err(e) => return None
    }
    ro o = value.object()?
    ro step = o.get("step")?.int()?
    ro data = o.get("data")?.str()?
    Some(snapshot_of(step, data))
}

fn path_or_stop(root str, session str, name str) -> Path {
    match session_file(root, session, name) {
        Some(p) => p
        None => panic("the session name is not a safe file name: ${session}")
    }
}

// Append a line to a file of the session; the folder of the session is made when the first try fails (it is not there yet).
fn append_in_session(root str, session str, path Path, line str) Fs -> bool {
    if append_line(path, line) { return true }
    if !ensure_session_dir(root, session) { return false }
    append_line(path, line)
}

fn write_journal_entry(root str, session str, path Path, entry JournalEntry) -> () {
    with Fs = real_fs() {
        if !append_in_session(root, session, path, journal_line(entry)) {
            panic("the journal cannot be written: ${path.display()}")
        }
    }
}

const JOURNAL_READ_BYTES = 256 * 1024

const JOURNAL_PARSE_BLOCKS = 4

fn parse_journal_block(bytes []u8) -> []JournalEntry {
    mut entries = []JournalEntry.new()
    for line in bytes.to_str_lossy().split("\n") {
        match parse_journal_line(line.strip_suffix("\r") ?? line) {
            Some(entry) => entries.push(entry)
            None => ()
        }
    }
    entries
}

type JournalBlock { bytes []u8 }
type ParsedJournalBlock { entries []JournalEntry }

fn parse_journal_worker(tx ChanTx[ParsedJournalBlock], block []u8) -> () {
    ro sent = tx.send(ParsedJournalBlock { entries: parse_journal_block(block) })
}

fn append_journal_block(mut entries []JournalEntry, rx ChanRx[ParsedJournalBlock]) -> () {
    match rx.recv() {
        Some(block) => entries.append(block.entries)
        None => panic("journal parser ended without its block")
    }
}

fn parse_journal_blocks(mut entries []JournalEntry, blocks []JournalBlock) -> () {
    if blocks.len() < JOURNAL_PARSE_BLOCKS {
        for block in blocks { entries.append(parse_journal_block(block.bytes)) }
        return
    }
    ro second = Chan[ParsedJournalBlock].new(1)
    ro third = Chan[ParsedJournalBlock].new(1)
    ro fourth = Chan[ParsedJournalBlock].new(1)
    supervised {
        spawn { parse_journal_worker(second.tx, blocks[1].bytes) }
        spawn { parse_journal_worker(third.tx, blocks[2].bytes) }
        spawn { parse_journal_worker(fourth.tx, blocks[3].bytes) }
        entries.append(parse_journal_block(blocks[0].bytes))
        append_journal_block(entries, second.rx)
        append_journal_block(entries, third.rx)
        append_journal_block(entries, fourth.rx)
    }
}

// Split on the last newline of each read before decoding UTF-8. A row may
// span multiple reads. Parse at most four blocks, then append in file order.
fn read_journal_from(path Path, offset int) Fs -> Option[[]JournalEntry] {
    mut entries = []JournalEntry.new()
    match File.open(path) {
        Err(_) => return None
        Ok(consume file) => {
            if offset > 0 && file.seek(SeekFrom.Start(offset)).is_err() {
                ro closed = file.close()
                return None
            }
            mut buffer []u8 = []u8.new()
            buffer.resize(JOURNAL_READ_BYTES, 0 as u8)
            mut tail []u8 = []u8.new()
            mut blocks []JournalBlock = []JournalBlock.new()
            mut readable = true
            loop {
                ro count = match file.read(buffer) {
                    Ok(n) => n
                    Err(e) => {
                        if e.is_interrupted() { continue }
                        readable = false
                        break
                    }
                }
                if count == 0 { break }
                mut end = count
                while end > 0 && buffer[end - 1] != 10 as u8 { end -= 1 }
                if end > 0 {
                    tail.append(buffer[..end])
                    blocks.push(JournalBlock { bytes: tail })
                    tail = []u8.new()
                    if blocks.len() == JOURNAL_PARSE_BLOCKS {
                        parse_journal_blocks(entries, blocks)
                        blocks = []JournalBlock.new()
                    }
                }
                tail.append(buffer[end..count])
            }
            ro closed = file.close()
            if !readable || closed.is_err() { return None }
            if tail.len() > 0 { blocks.push(JournalBlock { bytes: tail }) }
            parse_journal_blocks(entries, blocks)
        }
    }
    Some(entries)
}

fn read_journal(path Path) Fs -> []JournalEntry => read_journal_from(path, 0) ?? []JournalEntry.new()

fn journal_entries(path Path) -> []JournalEntry => with Fs = real_fs() { read_journal(path) }

/// The handler of `Journal` for one session. A torn last line is skipped on read.
export fn file_journal(root str, session str) -> Effect[Journal] {
    ro path = path_or_stop(root, session, "journal")
    effect Journal {
        write(entry) -> () { write_journal_entry(root, session, path, entry) }
        read_all() -> []JournalEntry { journal_entries(path) }
    }
}

type ReplayJournal { entries []JournalEntry }

fn replay_journal(root str, session str, path Path, mut replay ReplayJournal) -> Effect[Journal] {
    effect Journal {
        write(entry) -> () {
            write_journal_entry(root, session, path, entry)
            replay.entries.push(entry)
        }
        read_all() -> []JournalEntry { replay.entries }
    }
}

const REPLAY_CHECKPOINT_SAMPLE = 64

// A derived checkpoint for an append-only journal. The header carries the
// original byte offset and anchors. Missing or invalid checkpoints replay normally.
fn checkpoint_anchor(path Path, offset int) Fs -> Option[str] {
    consume file = match File.open(path) { Ok(consume f) => f, Err(_) => return None }
    mut bytes []u8 = []u8.new()
    bytes.resize(REPLAY_CHECKPOINT_SAMPLE, 0 as u8)
    ro read_count = file.read_at(bytes, offset)
    ro closed = file.close()
    if closed.is_err() { return None }
    match read_count {
        Ok(n) if n == REPLAY_CHECKPOINT_SAMPLE => Some(bytes.to_str_lossy())
        _ => None
    }
}

fn checkpoint_matches(root str, session str, path Path, header JsonObject) Fs -> Option[int] {
    if header.get("version")?.int()? != 1 { return None }
    ro step = header.get("step")?.int()?
    ro offset = header.get("offset")?.int()?
    if step < 1 || offset < REPLAY_CHECKPOINT_SAMPLE { return None }
    ro snapshot_file = path_or_stop(root, session, "snapshot")
    ro snapshot_bytes = match read(snapshot_file) { Ok(bytes) => bytes, Err(_) => return None }
    ro snapshot = parse_snapshot(snapshot_bytes.to_str_lossy())?
    if snapshot.step < step { return None }
    ro first = checkpoint_anchor(path, 0)?
    ro end = checkpoint_anchor(path, offset - REPLAY_CHECKPOINT_SAMPLE)?
    if !end.ends_with("\n") || first != header.get("first")?.str()? || end != header.get("end")?.str()? { return None }
    Some(offset)
}

fn checkpoint_entries(root str, session str, path Path) Fs -> Option[[]JournalEntry] {
    ro meta = path_or_stop(root, session, "replay-checkpoint.json")
    ro bytes = match read(meta) { Ok(bytes) => bytes, Err(_) => return None }
    ro value = match Json.parse(bytes.to_str_lossy()) { Ok(value) => value, Err(_) => return None }
    ro header = value.object()?
    ro offset = checkpoint_matches(root, session, path, header)?
    ro cache = path_or_stop(root, session, "replay-checkpoint.journal")
    mut entries = read_journal(cache)
    if entries.len() == 0 || entries.len() != header.get("records")?.int()? { return None }
    entries.append(read_journal_from(path, offset)?)
    Some(entries)
}

fn replay_entries(root str, session str, path Path) -> []JournalEntry {
    with Fs = real_fs() { checkpoint_entries(root, session, path) ?? read_journal(path) }
}

/// A private journal view for the one restore operation, including entries appended during restart.
export fn file_replay_journal(root str, session str) -> Effect[Journal] {
    ro path = path_or_stop(root, session, "journal")
    mut replay = ReplayJournal { entries: replay_entries(root, session, path) }
    replay_journal(root, session, path, replay)
}

/// The handler of `Store`: `<root>/<id>/snapshot` per session. `save` replaces the file as a whole; `load` of a missing
/// file or of a name that is not safe is None; a file that exists and is not a snapshot comes back as a snapshot the engine
/// rejects (step -1), so a damaged snapshot is never taken for "no session" and the session is never started over it.
/// A `save` under a name that is not safe stops the program.
export fn file_store(root str) -> Effect[Store] {
    effect Store {
        save(id, snapshot) -> () {
            ro path = path_or_stop(root, id, "snapshot")
            // D454: boundary override inside non-test code, see module-conventions (the op body of a handler literal cannot declare the effect in its signature)
            with Fs = real_fs() {
                if !ensure_session_dir(root, id) || !replace_file(path, snapshot_text(snapshot)) {
                    panic("the snapshot cannot be saved: ${path.display()}")
                }
            }
        }
        load(id) -> Option[Snapshot] {
            match session_file(root, id, "snapshot") {
                None => None
                Some(path) => {
                    // D454: boundary override inside non-test code, see module-conventions (the op body of a handler literal cannot declare the effect in its signature)
                    with Fs = real_fs() {
                        match read(path) {
                            Err(e) => None
                            Ok(bytes) => match parse_snapshot(bytes.to_str_lossy()) {
                                Some(snapshot) => Some(snapshot)
                                None => Some(snapshot_of(-1, ""))
                            }
                        }
                    }
                }
            }
        }
    }
}

/// The ids of the sessions in the data folder: the folders that hold a `snapshot` file, in the order of the names. A folder
/// that does not exist has none. A name that is not a safe session name is not a session.
export fn list_sessions(root str) Fs -> []str {
    mut names = []str.new()
    match read_dir(Path.from_bytes(root.bytes())) {
        Err(e) => ()
        Ok(entries) => {
            for entry in entries {
                match entry.name_str() {
                    Some(id) => if entry.is_dir() && valid_session_name(id) {
                        match session_file(root, id, "snapshot") {
                            Some(snapshot) => match try_exists(snapshot) {
                                Ok(there) => { if there { names.push(id) } }
                                Err(e) => ()
                            }
                            None => ()
                        }
                    }
                    None => ()
                }
            }
        }
    }
    // a plain insertion sort: the folder holds a few hundred names at the most
    mut sorted = []str.new()
    for name in names {
        mut at = sorted.len()
        while at > 0 && name < sorted[at - 1] { at -= 1 }
        sorted.insert(at, name)
    }
    sorted
}
