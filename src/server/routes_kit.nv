// routes_kit.nv - task 192q: the scenarios of the modes of work over a hub with the fake ACP agent (the same kit as `testkit.nv`): a scenario returns "" when everything
// was as it must be, else the list of what was not.
module canopus.server

import std.encoding.json.{Json, JsonValue, JsonObject}
import canopus.projects.{projects_load, projects_create}
import std.concurrency.nvchan.{Chan}
import std.fs.{Fs, real_fs, remove_dir_all}
import std.os.{Os, real_os, temp_dir, pid}

// The settings of a hub that works in `workdir` (the folder of the session) and reads the modes from `doc/routes` of this repository; the reviewer is the second fake agent.

// Repository scenarios explicitly choose their fixture project. Missing project_id
// now means an ordinary projectless chat, not inheritance of the hub repository.
fn rk_project_page(mut rig Rig, conn int, trace str, input str) Proc Detach Time -> () {
    ro root = rig.hub.settings.data_dir
    ro folder = kit_slashes(rig.hub.settings.workdir)
    mut project_id = ""
    match projects_load(root) {
        Ok(list) => {
            for project in list {
                for entry in project.folders {
                    if kit_slashes(entry.path) == folder { project_id = project.id }
                }
            }
        }
        Err(f) => panic(f.message)
    }
    if project_id == "" {
        mut body = JsonObject.new()
        jput(body, "name", JsonValue.str("Fixture project"))
        mut entry = JsonObject.new()
        jput(entry, "path", JsonValue.str(folder))
        jput(body, "folders", JsonValue.array([JsonValue.object(entry)]))
        project_id = match projects_create(root, body) {
            Ok(id) => id
            Err(f) => panic(f.message)
        }
    }
    mut body = kit_json_object(input)
    jput(body, "project_id", JsonValue.str(project_id))
    jput(body, "folder", JsonValue.str(folder))
    rig.page(conn, "session_created", trace, JsonValue.object(body).to_str())
}

// The agents of the kit; `opencode` takes an HTTP MCP server (`--ask` of the fake agent), so that it can call the tools of the recognition of the tasks (task 192.2).
fn rk_agents(agents []AgentSpec) -> []AgentSpec {
    mut out = []AgentSpec.new()
    for a in agents {
        mut args = []str.new()
        for word in a.args { args.push(word) }
        // Preserve the complete raw prompt echo without delaying every harness word.
        // Dedicated ACP/burst fixtures still test streaming with the original pacing.
        args.push("--fast-echo")
        if a.id == "opencode" { args.push("--ask") }
        out.push(AgentSpec { id: a.id, label: a.label, program: a.program, args, ask: a.ask, preparation: a.preparation })
    }
    out
}

// These lifecycle probes supply the proposal at the MCP boundary. A normal
// ACP prompt is deliberately forbidden while an explicitly chosen copy is pending.
fn rk_offer_tasks(mut rig Rig, session str, items []JsonValue, title str) Proc Detach Time -> bool {
    mut body = JsonObject.new()
    jput(body, "tasks", JsonValue.array(items))
    ro reply = Chan[str].new(1)
    rig.hub.ct_list_call(McpMsg { kind: "canopus_task_list", call: 1, session, text: JsonValue.object(body).to_str(), reply: reply.tx })
    rig.collect()
    rk_card_id(ck_state(rig, 1, session), title) > 0
}

fn rk_settings(name str, workdir str) -> ServerSettings {
    ro base = kit_files(name, 30000)
    ServerSettings {
        port: base.port, data_dir: base.data_dir, store: base.store, pg: base.pg, agents: rk_agents(base.agents), idle_term_ms: 30000, workdir,
        web_dir: base.web_dir, machines_dir: base.machines_dir, hub_program: "", hub_args: []str.new(), acp_trace: false, ask_form: base.ask_form, ask_timeout_ms: base.ask_timeout_ms, max_image_bytes: base.max_image_bytes, stt_url: base.stt_url, stt_language: base.stt_language,
        routes_dir: "${kit_repo_root().display()}/doc/routes", route_reviewer_order: ["second"], route_task_limit: 12, route_task_messages: 40,
        route_fix_attempts: 2, route_worktree_ask: true, route_overlap_seconds: 30, route_keep_days: 30, context_drop_percent: 40,
        route_confirm_word: "задача", route_over_limit_word: "сверх", route_max_active: 3, route_tool: true, route_auto_propose: false, route_children: false, route_wip: false, wip_timeout_ms: 300000, agent_start_ms: 60000, agent_silent_minutes: 5,
        layout: base.layout, preset: base.preset, auto_extend_confidence: base.auto_extend_confidence, task_scope: base.task_scope
    }
}

/// The settings for a session in a plain folder (not a repository): the tasks go to the data folder.
export fn kit_routes(name str) -> ServerSettings {
    ro base = kit_files(name, 30000)
    ro work = "${base.data_dir}/work"
    ro made = write_file("${work}/.keep", "")
    rk_settings(name, work)
}

// The input of the last page event of this kind, an empty object when there is none.
fn rk_last(lines []str, kind str) -> JsonObject {
    mut found = JsonObject.new()
    for line in lines {
        if line_field(line, "kind") == kind {
            match kit_object(line) {
                Some(o) => {
                    match jchild(o, "input") {
                        Some(i) => { found = i }
                        None => ()
                    }
                }
                None => ()
            }
        }
    }
    found
}

fn rk_array(o JsonObject, key str) -> []JsonValue => (o.get(key) ?? JsonValue.null()).array() ?? []JsonValue.new()

fn rk_task(o JsonObject) -> JsonObject => jchild(o, "task") ?? JsonObject.new()

fn rk_steps_in(o JsonObject, state str) -> int {
    mut n = 0
    for s in rk_array(o, "steps") {
        if jtext(s.object() ?? JsonObject.new(), "state") == state { n += 1 }
    }
    n
}

fn rk_task_is_null(o JsonObject) -> bool {
    match o.get("task") {
        Some(v) => v.is_null()
        None => true
    }
}

fn rk_sub(o JsonObject, at int) -> JsonObject {
    ro subs = rk_array(rk_task(o), "subtasks")
    if at < subs.len() { subs[at].object() ?? JsonObject.new() } else { JsonObject.new() }
}

// Pump until `route_state` has `want` steps in `state`, at most `limit_ms`.
fn Rig mut @wait_steps(state str, want int, limit_ms int) Proc Detach Time -> bool {
    ro deadline = Time.now().unix_millis() + limit_ms
    while Time.now().unix_millis() < deadline {
        @run(150)
        if rk_steps_in(rk_last(@all_lines_for(1), "route_state"), state) >= want { return true }
    }
    false
}

fn rk_text(path str) -> str => read_file(path) ?? ""

fn rk_boxes_done(path str) -> int => parse_progress(rk_text(path)).done

// ----- task 192.2: the tasks are recognised by the agent and started by the owner -----

fn rk_item(kind str, title str, extends int, touches []str) -> JsonValue {
    mut item = JsonObject.new()
    jput(item, "kind", JsonValue.str(kind))
    jput(item, "title", JsonValue.str(title))
    jput(item, "summary", JsonValue.str("сделать: ${title}"))
    jput(item, "extends", JsonValue.int(extends))
    mut files = []JsonValue.new()
    for f in touches { files.push(JsonValue.str(f)) }
    jput(item, "touches", JsonValue.array(files))
    JsonValue.object(item)
}

/// The page message that makes the fake agent call `canopus_task_list` with the items.
fn rk_tasklist_page(turn str, items []JsonValue) -> str {
    mut list = JsonObject.new()
    jput(list, "tasks", JsonValue.array(items))
    mut o = JsonObject.new()
    jput(o, "turn", JsonValue.str(turn))
    jput(o, "text", JsonValue.str("tasklist ${JsonValue.object(list).to_str()}"))
    JsonValue.object(o).to_str()
}

/// The page message that makes the fake agent call `canopus_task` with one item.
fn rk_tasktool_page(turn str, item JsonValue) -> str {
    mut o = JsonObject.new()
    jput(o, "turn", JsonValue.str(turn))
    jput(o, "text", JsonValue.str("tasktool ${item.to_str()}"))
    JsonValue.object(o).to_str()
}

fn rk_cards(st JsonObject) -> []JsonValue => rk_array(st, "proposals")

/// The id of the card with this title, 0 - none.
fn rk_card_id(st JsonObject, title str) -> int {
    for p in rk_cards(st) {
        ro o = p.object() ?? JsonObject.new()
        if jtext(o, "title") == title { return (o.get("id") ?? JsonValue.null()).int() ?? 0 }
    }
    0
}

fn rk_card_state(st JsonObject, title str) -> str {
    for p in rk_cards(st) {
        ro o = p.object() ?? JsonObject.new()
        if jtext(o, "title") == title { return jtext(o, "state") }
    }
    "none"
}

fn rk_number(o JsonObject, key str) -> int => (o.get(key) ?? JsonValue.null()).int() ?? 0

/// The agent lists the works (a turn of the fake agent) and the card is shown: true when the card of the first title is there.
fn Rig mut @list_tasks(session str, turn str, items []JsonValue, first_title str) Proc Detach Time -> bool {
    // a service turn of the hub (the decision of the owner) may still be open: the message of the owner is then ignored, so it is sent again
    mut attempt = 0
    while attempt < 3 {
        @run(1500)
        @page(1, "user_message", session, rk_tasklist_page("${turn}-${attempt}", items))
        if @until(KIT_DONE, 20000) {
            @run(300)
            if rk_card_id(rk_last(@all_lines_for(1), "route_state"), first_title) > 0 { return true }
        }
        attempt += 1
    }
    false
}

/// The owner presses a button of the card with this title.
fn Rig mut @press(session str, title str, action str) Proc Detach Time -> () {
    ro id = rk_card_id(rk_last(@all_lines_for(1), "route_state"), title)
    @page(1, "route_prop", session, "{\"id\":${id},\"action\":\"${action}\"}")
    @run(300)
}

/// A task as the owner makes it: the agent lists one work, the owner presses "В работу", the service turn of the decision ends. true when the task is there.
fn Rig mut @seed_task(session str, turn str, title str, touches []str) Proc Detach Time -> bool {
    if !@list_tasks(session, turn, [rk_item("new", title, 0, touches)], title) { return false }
    @press(session, title, "start")
    mut waited = 0
    while waited < 30000 && rk_task_is_null(rk_last(@all_lines_for(1), "route_state")) {
        @run(200)
        waited += 200
    }
    @run(2500)
    !rk_task_is_null(rk_last(@all_lines_for(1), "route_state"))
}

/// The mode "Fast task" in a plain folder: the task in the data folder, the instruction in front of the message, a message that extends the subtask, the run of the steps with the review
/// of another family, the checklist, the restart.
export fn scenario_route_fast(settings ServerSettings) Proc Detach Time Net Fs Os -> str {
    mut c = kit_check()
    ro work = "${settings.data_dir}/work"
    ro made = write_file("${work}/.keep", "")
    mut rig = rig_open(settings)
    rig.attach(1)
    ro first = rk_last(rig.all_lines_for(1), "route_state")
    c.expect(jtext(first, "route") == "" || jtext(first, "route") == "interactive", "a session starts in the mode interactive")
    rk_project_page(rig, 1, "s-r1", "{\"name\":\"Режим\",\"agent\":\"opencode\"}")
    c.expect(rig.until("\"kind\":\"session_created\"", 5000), "the session is shown")
    // interactive: no task in a plain folder, nothing is put before the message
    rig.page(1, "user_message", "s-r1", "{\"turn\":\"t0\",\"text\":\"привет\"}")
    c.expect(rig.until(KIT_DONE, 15000), "interactive: the turn ends")
    ro lines0 = rig.lines_for(1)
    ro echo0 = answer_of(lines0, line_input(first_of(lines0, "user_message", 0), "turn"))
    c.expect(echo0.ends_with("привет") && echo0.contains("Режим «Выполнение»"), "interactive: the agent gets the instruction of the mode and the message: ${echo0}")
    rig.run(300)
    c.expect(rk_task_is_null(rk_last(rig.all_lines_for(1), "route_state")), "interactive in a plain folder: no task")

    rig.page(1, "session_route", "s-r1", "{\"route\":\"fast\"}")
    rig.run(300)
    ro st = rk_last(rig.all_lines_for(1), "route_state")
    c.expect(jtext(st, "route") == "fast", "the mode is fast")
    c.expect(rk_array(st, "steps").len() == 6, "fast has six steps: ${rk_array(st, "steps").len()}")
    c.expect(rk_steps_in(st, "pending") == 6, "all the steps are pending")

    rig.page(1, "user_message", "s-r1", "{\"turn\":\"t1\",\"text\":\"готово?\"}")
    c.expect(rig.until(KIT_DONE, 15000), "fast: the first message is answered")
    ro lines1 = rig.lines_for(1)
    ro um = first_of(lines1, "user_message", 3)
    c.expect(line_input(um, "text") == "готово?", "the feed shows the message as the owner wrote it: ${line_input(um, "text")}")
    ro echo = answer_of(lines1, line_input(um, "turn"))
    c.expect(echo.contains("Режим «Быстрая задача»"), "the instruction of the mode is put before the message: ${echo}")
    c.expect(!echo.contains("message.1.md"), "the agent is not given an unconfirmed task")
    c.expect(echo.ends_with("готово?"), "the message of the owner comes last")
    rig.run(300)
    c.expect(rk_task_is_null(rk_last(rig.all_lines_for(1), "route_state")), "fast: an ordinary message does not open a task")
    c.expect(rig.seed_task("s-r1", "confirmed", "сделай X", []str.new()), "the owner confirms the proposed task")
    ro st1 = rk_last(rig.all_lines_for(1), "route_state")
    ro task = rk_task(st1)
    c.expect(jtext(task, "number") == "001", "the first task is 001: ${jtext(task, "number")}")
    c.expect(jtext(task, "id") == "001-sdelay-x", "the name of the task: ${jtext(task, "id")}")
    c.expect(jtext(task, "state") == "active", "the task is active")
    ro dir = ck_dir(rig, "s-r1")
    c.expect(rk_text("${dir}/message.1.md").contains("сделай X"), "message.1.md holds the message")
    c.expect(rk_text("${dir}/message.1.md").contains("Дата:"), "message.1.md holds the date")
    c.expect(parse_progress(rk_text("${task_artifact_dir(dir)}/progress.1.md")).total == 6, "progress.1.md holds six boxes")
    c.expect(rk_array(task, "subtasks").len() == 1, "one subtask")

    ro statement = rk_text("${dir}/message.1.md")
    rig.page(1, "user_message", "s-r1", "{\"turn\":\"active-chat\",\"text\":\"готово?\"}")
    c.expect(rig.until(KIT_DONE, 15000), "an ordinary question during work is answered")
    rig.run(300)
    c.expect(rk_text("${dir}/message.1.md") == statement, "an ordinary question leaves the active statement intact")
    c.expect(rk_array(rk_task(rk_last(rig.all_lines_for(1), "route_state")), "subtasks").len() == 1, "an ordinary question adds no subtask")

    // The owner explicitly chooses to extend the subtask with the next message.
    rig.page(1, "route_subtask_same", "s-r1", "{}")
    rig.run(200)
    rig.page(1, "user_message", "s-r1", "{\"turn\":\"t2\",\"text\":\"ещё Y\"}")
    c.expect(rig.until(KIT_DONE, 15000), "fast: the second message is answered")
    rig.run(300)
    ro st2 = rk_last(rig.all_lines_for(1), "route_state")
    c.expect(rk_array(rk_task(st2), "subtasks").len() == 1, "the message extended the subtask, no new one")
    c.expect(jtext(rk_sub(st2, 0), "merged_into") == "1", "merged_into says 1: ${jtext(rk_sub(st2, 0), "merged_into")}")
    c.expect(rk_text("${dir}/message.1.md").contains("## Дополнение") && rk_text("${dir}/message.1.md").contains("ещё Y"), "message.1.md got the supplement")

    // the owner chooses a new subtask for the next message
    rig.page(1, "route_subtask_new", "s-r1", "{}")
    rig.run(200)
    c.expect(jtext(rk_last(rig.all_lines_for(1), "route_state"), "next_subtask") == "new", "the choice of the owner is shown")
    rig.page(1, "user_message", "s-r1", "{\"turn\":\"t3\",\"text\":\"третье\"}")
    c.expect(rig.until(KIT_DONE, 15000), "fast: the third message is answered")
    rig.run(300)
    ro st3 = rk_last(rig.all_lines_for(1), "route_state")
    c.expect(rk_array(rk_task(st3), "subtasks").len() == 2, "a forced new subtask")
    c.expect(rk_text("${dir}/message.2.md").contains("третье"), "message.2.md")
    c.expect(rk_boxes_done("${task_artifact_dir(dir)}/progress.2.md") == 0 && parse_progress(rk_text("${task_artifact_dir(dir)}/progress.2.md")).total == 6, "progress.2.md is an empty checklist")
    c.expect(jtext(rk_sub(st3, 0), "state") == "planned" && jtext(rk_sub(st3, 1), "state") == "running", "subtasks: planned and running")

    // the run: a required step cannot be skipped, an optional one can
    rig.page(1, "route_skip", "s-r1", "{\"step\":5}")
    c.expect(rig.until("обязательный", 5000), "the required step cannot be skipped")
    rig.page(1, "route_skip", "s-r1", "{\"step\":2}")
    rig.run(300)
    ro st4 = rk_last(rig.all_lines_for(1), "route_state")
    c.expect(rk_steps_in(st4, "skipped") == 1, "step 2 is skipped")
    rig.page(1, "route_run", "s-r1", "{}")
    c.expect(rig.wait_steps("done", 5, 90000), "the run passes the steps")
    rig.run(500)
    ro st5 = rk_last(rig.all_lines_for(1), "route_state")
    ro lines5 = rig.lines_for(1)
    c.expect(rk_steps_in(st5, "done") == 5 && rk_steps_in(st5, "skipped") == 1, "five done, one skipped")
    c.expect(jtext(st5, "route") == "fast", "still fast")
    mut label_lines = 0
    for line in lines5 {
        if line_field(line, "kind") == "user_message" && line_input(line, "text").starts_with("Шаг режима: ") { label_lines += 1 }
    }
    c.expect(label_lines == 4, "four steps of the same agent show as labels: ${label_lines}")
    c.expect(kit_with(lines5, "Независимая проверка (second)") >= 1, "the block of the independent review is in the feed")
    c.expect(kit_with(lines5, "=== git status ===") >= 1 && kit_with(lines5, "=== Сообщение пользователя") >= 1, "the protocol of the task is given to the reviewer")
    c.expect(rk_boxes_done("${task_artifact_dir(dir)}/progress.2.md") == 6, "progress.2.md: the boxes of the steps are marked (a skipped one with a note): ${rk_boxes_done("${task_artifact_dir(dir)}/progress.2.md")}")
    c.expect(rk_text("${task_artifact_dir(dir)}/progress.2.md").contains("(пропущен)"), "the skipped step is noted")
    c.expect((rk_task(st5).get("closed") ?? JsonValue.null()).bool() ?? false, "the task is closed when the run is over")
    c.expect(rk_steps_in(st5, "running") == 0 && !((st5.get("running") ?? JsonValue.null()).bool() ?? true), "nothing is running")
    ro lines_before = rig.hub.page_lines("s-r1")
    rig.shut()

    // the restart: the mode, the task and the steps come back from the journal
    mut again = rig_open(settings)
    again.attach(1)
    ro back = rk_last(again.all_lines_for(1), "route_state")
    c.expect(jtext(back, "route") == "fast", "after the restart: the mode")
    c.expect(jtext(rk_task(back), "id") == "001-sdelay-x", "after the restart: the task")
    c.expect(rk_steps_in(back, "done") == 5 && rk_steps_in(back, "skipped") == 1, "after the restart: the steps")
    c.expect(rk_array(rk_task(back), "subtasks").len() == 2, "after the restart: the subtasks")
    c.expect(kit_text(again.hub.page_lines("s-r1")) == kit_text(lines_before), "the lines of the feed are the same")
    // A follow-up after a finished run preserves the closed task and its progress.
    again.page(1, "user_message", "s-r1", "{\"turn\":\"t9\",\"text\":\"готово?\"}")
    c.expect(again.until(KIT_DONE, 15000), "after the restart: a message is answered")
    again.run(300)
    ro st9 = rk_last(again.all_lines_for(1), "route_state")
    c.expect(jtext(rk_task(st9), "id") == jtext(rk_task(back), "id"), "a follow-up keeps the completed task")
    c.expect(rk_steps_in(st9, "done") == 5 && rk_steps_in(st9, "skipped") == 1, "a follow-up keeps the route progress")
    c.expect(rk_array(rk_task(st9), "subtasks").len() == 2, "a follow-up does not add a subtask")
    c.expect(rk_boxes_done("${task_artifact_dir(dir)}/progress.2.md") == 6, "a follow-up keeps the progress file")
    // there is no publishing of a task that has no tree
    again.page(1, "route_publish", "s-r1", "{}")
    c.expect(again.until("сливать нечего", 5000), "no tree: nothing to merge")
    again.shut()
    c.report()
}

/// A run without steps does not start; the modes interactive has no steps.
export fn scenario_route_nosteps(settings ServerSettings) Proc Detach Time Net Fs Os -> str {
    mut c = kit_check()
    ro work = "${settings.data_dir}/work"
    ro made = write_file("${work}/.keep", "")
    mut rig = rig_open(settings)
    rig.attach(1)
    rk_project_page(rig, 1, "s-r2", "{\"name\":\"Без шагов\",\"agent\":\"opencode\"}")
    c.expect(rig.until("\"kind\":\"session_created\"", 5000), "the session is shown")
    rig.page(1, "route_run", "s-r2", "{}")
    c.expect(rig.until("в этом режиме нет шагов", 5000), "no run in the mode interactive")
    rig.page(1, "session_route", "s-r2", "{\"route\":\"nonsense\"}")
    rig.run(200)
    c.expect(jtext(rk_last(rig.all_lines_for(1), "route_state"), "route") != "nonsense", "an unknown mode is refused")
    rig.page(1, "session_route", "s-r2", "{\"route\":\"full\"}")
    rig.run(200)
    ro st = rk_last(rig.all_lines_for(1), "route_state")
    c.expect(rk_array(st, "steps").len() == 8, "full has eight steps")
    rig.page(1, "route_run", "s-r2", "{}")
    c.expect(rig.until("сначала подтвердите создание задачи", 5000), "no run before a task")
    rig.shut()
    c.report()
}

// ----- a temporary repository -----

fn rk_root(name str) -> str {
    // D454: boundary override inside non-test code, see module-conventions (Os/Fs would leak through kit_routes_git into named fn kit_routes_children in child_kit.nv)
    ro base = with Os = real_os() { temp_dir() }
    ro id = with Os = real_os() { pid() }
    ro dir = base.join("canopus-routes-git-${id}-${name}")
    with Fs = real_fs() {
        ro removed = remove_dir_all(dir)
    }
    dir.display()
}

fn rk_git(dir str, args []str) Proc -> bool {
    mut all = ["-c", "user.name=Test", "-c", "user.email=test@example.com", "-c", "commit.gpgsign=false"]
    for a in args { all.push(a) }
    git_run(dir, all).ok
}

/// A repository for the scenarios: `<root>/repo` on `main` with one commit and the folder `doc/tasks`; the trees of the tasks go beside it, to `<root>` (the setting "папка деревьев" of a project is empty).
fn rk_repo(root str) Proc -> str {
    ro repo = "${root}/repo"
    ro made = write_file("${repo}/doc/tasks/.keep", "")
    ro readme = write_file("${repo}/README.md", "# test\n")
    ro a = rk_git(repo, ["init", "-b", "main"])
    ro b = rk_git(repo, ["add", "."])
    ro d = rk_git(repo, ["commit", "-m", "init"])
    repo
}

/// The settings for a session in the repository `repo`.
export fn kit_routes_git(name str) Proc -> ServerSettings {
    ro root = rk_root(name)
    ro repo = rk_repo(root)
    rk_settings(name, repo)
}

/// The mode interactive in a repository: the first message opens a task with a tree of its own (branch `task/NNN-...`, next to the repository), the agent works in the tree, the
/// source in the repository is untouched; canonical task documents live there; closing a task that has work in its tree does not drop it ("finishing", "keep"), a kept task comes back.
export fn scenario_route_tree(settings ServerSettings) Proc Detach Time Net Fs Os -> str {
    mut c = kit_check()
    mut rig = rig_open(settings)
    rig.attach(1)
    rk_project_page(rig, 1, "s-r3", "{\"name\":\"Дерево\",\"agent\":\"opencode\"}")
    c.expect(rig.until("\"kind\":\"session_created\"", 5000), "the session is shown")
    rig.page(1, "user_message", "s-r3", "{\"turn\":\"t0\",\"text\":\"привет\"}")
    c.expect(rig.until(KIT_DONE, 20000), "a talk is answered")
    rig.run(300)
    c.expect(rk_task_is_null(rk_last(rig.all_lines_for(1), "route_state")), "a talk in a repository makes no task, no tree and no file (task 192.2)")
    c.expect(rig.seed_task("s-r3", "t1", "Дерево", ["a.txt"]), "the agent lists a work, the owner starts it: the task is there")
    rig.page(1, "user_message", "s-r3", "{\"turn\":\"t1p\",\"text\":\"pwd\"}")
    c.expect(rig.until(KIT_DONE, 20000), "the message in the task is answered")
    rig.run(300)
    ro st = rk_last(rig.all_lines_for(1), "route_state")
    ro task = rk_task(st)
    ro id = jtext(task, "id")
    ro tree = jtext(task, "worktree")
    c.expect(id.starts_with("001-"), "the first task of the repository is 001: ${id}")
    c.expect(jtext(task, "branch") == "task/${id}", "the branch of the task: ${jtext(task, "branch")}")
    c.expect(tree.byte_len() > 0 && dir_there(tree), "the tree of the task is made: ${tree}")
    c.expect(tree.contains("/repo-${id}"), "the tree is next to the repository: ${tree}")
    c.expect(path_there("${ck_dir(rig, "s-r3")}/message.1.md"), "the files are in the canonical task directory")
    c.expect(path_there("${settings.workdir}/doc/tasks/${id}/state.json") && !path_there("${tree}/doc/tasks/${id}/state.json"), "only the canonical project folder has runtime task state")
    c.expect(jtext(task, "state") == "active", "the task is active")
    c.expect(!((task.get("finish") ?? JsonValue.null()).bool() ?? false), "a tree with no work is not offered to finish (task 192)")
    ro lines = rig.lines_for(1)
    ro answer = answer_of(lines, rk_last_turn(lines)).replace("\\", "/")
    c.expect(answer.contains("/repo-${id}"), "the agent works in the tree: ${answer}")
    c.expect(rk_git(settings.workdir, ["diff", "--quiet"]) && git_run(settings.workdir, ["status", "--porcelain", "--", ".", ":(exclude)doc/tasks/${id}"]).text.byte_len() == 0, "the repository has only its canonical task documents; source and unrelated files stay clean")

    // nothing was done in the tree: closing the task removes the tree
    rig.page(1, "route_new_task", "s-r3", "{}")
    rig.run(1500)
    ro st2 = rk_last(rig.all_lines_for(1), "route_state")
    c.expect(rk_task_is_null(st2), "the task is closed")
    c.expect(!dir_there(tree), "its empty tree is removed")

    // a new task with work in its tree: it is not dropped and not parked, the owner is told to finish it
    c.expect(rig.seed_task("s-r3", "t2", "Вторая работа", ["b.txt"]), "the second task is started")
    ro st3 = rk_last(rig.all_lines_for(1), "route_state")
    ro id2 = jtext(rk_task(st3), "id")
    ro tree2 = jtext(rk_task(st3), "worktree")
    c.expect(id2.starts_with("001-") || id2.starts_with("002-"), "the second task: ${id2}")
    ro wrote = write_file("${tree2}/work.txt", "result\n")
    c.expect(rk_git(tree2, ["add", "work.txt"]) && rk_git(tree2, ["commit", "-m", "${jtext(rk_task(st3), "number")} work"]), "a commit in the tree")
    rig.page(1, "route_new_task", "s-r3", "{}")
    c.expect(rig.until("в дереве задачи есть работа", 8000), "work in the tree: a new task is not started, the owner is told to finish")
    rig.run(500)
    ro st4 = rk_last(rig.all_lines_for(1), "route_state")
    c.expect(jtext(rk_task(st4), "state") == "active" && jtext(rk_task(st4), "id") == id2, "the task stays as it was: ${jtext(rk_task(st4), "state")}")
    c.expect(((rk_task(st4).get("unmerged_commits") ?? JsonValue.null()).int() ?? 0) == 1, "one commit is not merged")
    c.expect((rk_task(st4).get("finish") ?? JsonValue.null()).bool() ?? false, "a tree with a commit is offered to finish")
    c.expect((st4.get("parked") ?? JsonValue.null()).is_null(), "there is no list of parked tasks any more")
    c.expect(dir_there(tree2), "the tree stays")
    c.expect(rk_tests_state(st4, "branch") == "never" && rk_tests_state(st4, "main") == "never", "no run of the tests is known: ${rk_tests_state(st4, "branch")}")
    // a tests record on the head: green; a new commit makes it outdated
    ro head = rk_head(tree2, "HEAD")
    ro rec = write_file("${task_artifact_dir(ck_dir(rig, "s-r3"))}/tests-run.json", tests_rec_text(head, 1000, "green", "test"))
    rig.run(12500)
    ro st4b = rk_last(rig.all_lines_for(1), "route_state")
    c.expect(rk_tests_state(st4b, "branch") == "green", "the record of the run on the head: green: ${rk_tests_state(st4b, "branch")}")
    ro wrote2 = write_file("${tree2}/more.txt", "more\n")
    c.expect(rk_git(tree2, ["add", "more.txt"]) && rk_git(tree2, ["commit", "-m", "${jtext(rk_task(st3), "number")} more"]), "a second commit")
    rig.run(12500)
    ro st4c = rk_last(rig.all_lines_for(1), "route_state")
    c.expect(rk_tests_state(st4c, "branch") == "outdated", "a newer head: the run was not on this commit: ${rk_tests_state(st4c, "branch")}")
    // what the agent left uncommitted: the button "merge" commits it in one commit before the push; there is no remote here, so the publishing stops with a note after that
    ro dirty = write_file("${tree2}/left.txt", "left by the agent\n")
    ro junk = write_file("${tree2}/junk.tmp", "temporary\n")
    rig.shut()

    // after a restart the task is still in its session
    mut again = rig_open(settings)
    again.attach(1)
    ro back = rk_last(again.all_lines_for(1), "route_state")
    c.expect(jtext(rk_task(back), "id") == id2, "after the restart: the task is open in its session")
    again.page(1, "route_merge", "s-r3", "{}")
    c.expect(again.until("публикация задачи", 20000), "publishing stops with a note (no remote)")
    again.run(300)
    ro st7 = rk_last(again.all_lines_for(1), "route_state")
    c.expect(jtext(rk_task(st7), "state") != "done" && ((rk_task(st7).get("needs_owner") ?? JsonValue.null()).bool() ?? false), "the task is not done and asks the owner")
    c.expect(!git_run(settings.workdir, ["rev-parse", "--verify", "--quiet", "origin/main"]).ok, "no remote was made or pushed to")
    c.expect(kit_with(again.lines_for(1), "закоммичено одним коммитом") >= 1, "the owner is told about the one commit")
    c.expect(git_run(tree2, ["status", "--porcelain"]).text.contains("junk.tmp") && !git_run(tree2, ["status", "--porcelain"]).text.contains("left.txt"), "the left file is committed, the temporary one is not")
    c.expect(git_run(tree2, ["log", "-1", "--format=%B"]).text.contains("Signed-off-by"), "the commit is signed off")
    c.expect(git_run(tree2, ["log", "-1", "--format=%s"]).text.starts_with(jtext(rk_task(st3), "number")), "the subject begins with the number of the task")
    again.page(1, "route_diff", "s-r3", "{}")
    c.expect(again.until("work.txt", 8000), "the changes of the task are shown")
    // deleting the session: the work is not lost, the tree and the branch stay
    again.page(1, "session_delete", "s-r3", "{}")
    again.run(1500)
    c.expect(dir_there(tree2), "a deleted session with work leaves the tree")
    again.shut()
    c.report()
}

// The turn of the last message of the owner in the feed.
fn rk_last_turn(lines []str) -> str {
    mut turn = ""
    for line in lines {
        if line_field(line, "kind") == "user_message" { turn = line_input(line, "turn") }
    }
    turn
}

fn rk_tests_state(st JsonObject, which str) -> str {
    ro tests = jchild(rk_task(st), "tests") ?? JsonObject.new()
    jtext(jchild(tests, which) ?? JsonObject.new(), "state")
}

// A repository with a remote: `<root>/origin.git` (bare) and `<root>/repo` on `main`, pushed, with the identity set for the commits of the hub.
fn rk_repo_remote(root str) Proc -> str {
    ro repo = rk_repo(root)
    ro origin = "${root}/origin.git"
    ro made = write_file("${origin}/.keep", "")
    ro bare = rk_git(origin, ["init", "--bare", "-b", "main"])
    ro name = rk_git(repo, ["config", "user.name", "Test"])
    ro mail = rk_git(repo, ["config", "user.email", "test@example.com"])
    ro sign = rk_git(repo, ["config", "commit.gpgsign", "false"])
    ro remote = rk_git(repo, ["remote", "add", "origin", origin])
    ro pushed = rk_git(repo, ["push", "origin", "main"])
    repo
}

/// The settings for a session in a repository that has a remote.
export fn kit_routes_remote(name str) Proc -> ServerSettings {
    ro root = rk_root(name)
    ro repo = rk_repo_remote(root)
    rk_settings(name, repo)
}

fn rk_head(dir str, branch str) Proc -> str => git_run(dir, ["rev-parse", branch]).text

// Pump until the subtask `at` (from 0) of the task is merged, at most `limit_ms`.
fn Rig mut @wait_merged(at int, limit_ms int) Proc Detach Time -> bool {
    ro deadline = Time.now().unix_millis() + limit_ms
    while Time.now().unix_millis() < deadline {
        @run(150)
        if ((rk_sub(rk_last(@all_lines_for(1), "route_state"), at).get("merged") ?? JsonValue.null()).bool() ?? false) { return true }
    }
    false
}

/// A subtask in a tree of its own is merged into the tree of the task (a conflict is resolved by the agent), and the task is published ONLY by the word of the owner: before it the remote is
/// untouched; then the rebase, the tests (a turn of the agent), the push, the main copy brought up by a fast-forward, the tree removed.
export fn scenario_route_publish(settings ServerSettings) Proc Detach Time Net Fs Os -> str {
    mut c = kit_check()
    ro repo = settings.workdir
    ro origin = "${repo}/../origin.git"
    ro initial = rk_head(origin, "main")
    mut rig = rig_open(settings)
    rig.attach(1)
    rk_project_page(rig, 1, "s-r4", "{\"name\":\"Публикация\",\"agent\":\"opencode\"}")
    c.expect(rig.until("\"kind\":\"session_created\"", 5000), "the session is shown")
    c.expect(rig.seed_task("s-r4", "t1", "Общая работа", ["a.txt"]), "the first work is started")
    // the second work touches other files: no overlap, so it goes on in a tree of its own at once (task 192.2)
    c.expect(rig.seed_task("s-r4", "t2", "Вторая часть", ["b.txt"]), "the second work is started")
    rig.page(1, "route_subtask_worktree", "s-r4", "{\"n\":2}")
    rig.run(1500)
    ro st = rk_last(rig.all_lines_for(1), "route_state")
    ro task = rk_task(st)
    ro tree = jtext(task, "worktree")
    ro sub = rk_sub(st, 1)
    ro subtree = jtext(sub, "worktree")
    c.expect(rk_array(task, "subtasks").len() == 2, "two subtasks")
    c.expect(subtree.byte_len() > 0 && dir_there(subtree) && subtree != tree, "the subtask has a tree of its own: ${subtree}")
    c.expect(jtext(sub, "branch").starts_with("task/") && jtext(sub, "branch").ends_with("-${task_slug_of(jtext(task, "id"))}") && jtext(sub, "branch") != jtext(task, "branch"), "its branch has a number of its own (flat): ${jtext(sub, "branch")}")

    // both sides add a.txt: a conflict of the merge
    ro w1 = write_file("${tree}/a.txt", "task side\n")
    c.expect(rk_git(tree, ["add", "a.txt"]) && rk_git(tree, ["commit", "-m", "${jtext(task, "number")} task side"]), "a commit in the tree of the task")
    ro w2 = write_file("${subtree}/a.txt", "subtask side\n")
    ro w3 = write_file("${subtree}/b.txt", "b\n")
    c.expect(rk_git(subtree, ["add", "a.txt", "b.txt"]) && rk_git(subtree, ["commit", "-m", "${jtext(task, "number")} subtask side"]), "a commit in the tree of the subtask")
    rig.page(1, "route_subtask_done", "s-r4", "{\"n\":2}")
    c.expect(rig.wait_merged(1, 60000), "the conflict is resolved by the agent and the subtask is merged")
    rig.run(500)
    ro st2 = rk_last(rig.all_lines_for(1), "route_state")
    c.expect(rk_text("${tree}/a.txt") == "resolved\n", "the file holds what the agent resolved: ${rk_text("${tree}/a.txt")}")
    c.expect(path_there("${tree}/b.txt"), "the other file of the subtask came with the merge")
    c.expect(!dir_there(subtree), "the tree of a merged subtask is removed")
    c.expect(jtext(rk_sub(st2, 1), "worktree") == "" && jtext(rk_sub(st2, 1), "state") == "done", "the subtask is done and has no tree")
    c.expect(kit_with(rig.lines_for(1), "Служебный ход: разрешение конфликта") >= 1, "the service turn is shown in the feed")
    c.expect(rk_head(origin, "main") == initial, "nothing was pushed before the word of the owner")

    // the word of the owner
    ro left = write_file("${tree}/left.txt", "left by the agent\n")
    rig.page(1, "route_merge", "s-r4", "{}")
    ro deadline = Time.now().unix_millis() + 90000
    mut state = ""
    while Time.now().unix_millis() < deadline && state != "done" && state != "ready" {
        rig.run(200)
        state = jtext(rk_task(rk_last(rig.all_lines_for(1), "route_state")), "state")
        if state == "active" || state == "finishing" { state = "" }
    }
    rig.run(500)
    ro st3 = rk_last(rig.all_lines_for(1), "route_state")
    c.expect(state == "done", "the task is published: state ${state}, ${jtext(rk_task(st3), "note")}")
    c.expect(rk_head(origin, "main") != initial, "the remote has the work now")
    c.expect(git_run(origin, ["show", "main:left.txt"]).text.trim_ascii() == "left by the agent", "what the agent left uncommitted went in one commit and was pushed")
    c.expect(!kit_with(rig.lines_for(1), "Служебный ход: тесты перед публикацией") >= 1, "no tests were run before the push")
    c.expect(rk_text("${repo}/a.txt").trim_ascii() == "resolved", "the main copy was brought up by a fast-forward")
    c.expect(!dir_there(tree), "the tree of the task is removed")
    c.expect(kit_with(rig.lines_for(1), "влита в main") >= 1 && kit_with(rig.lines_for(1), "Основная копия: updated") >= 1, "the owner is told what became of the main copy")
    c.expect(git_run(repo, ["status", "--porcelain"]).text.byte_len() == 0, "the main copy is clean")
    rig.shut()
    c.report()
}

/// The mode "Planning" in a repository: the task is numbered at once but has no tree (its folder is in the data folder), the steps run and leave the task open, and when the owner
/// chooses another mode the whole folder of the task (the assignment in `message.1.md`, `images/`) goes into a tree of its own and the mode goes on with it.
export fn scenario_route_planning(settings ServerSettings) Proc Detach Time Net Fs Os -> str {
    mut c = kit_check()
    ro repo = settings.workdir
    ro branches_before = git_run(repo, ["branch", "--list"]).text
    ro head_before = git_run(repo, ["symbolic-ref", "HEAD"]).text
    mut rig = rig_open(settings)
    rig.attach(1)
    rk_project_page(rig, 1, "s-r5", "{\"name\":\"План\",\"agent\":\"opencode\",\"route\":\"planning\",\"worktree\":true}")
    c.expect(rig.until("\"kind\":\"session_created\"", 5000), "the session is shown")
    rig.run(300)
    ro st0 = rk_last(rig.all_lines_for(1), "route_state")
    c.expect(jtext(st0, "route") == "planning", "the session was made in the mode planning: ${jtext(st0, "route")}")
    c.expect(rk_array(st0, "steps").len() == 0, "preparation has no execution steps")
    c.expect(rig.hub.sessions[rig.hub.find("s-r5")].clients.len() == 0, "ordinary ACP is refused before spawn")
    rig.page(1, "session_agent", "s-r5", "{\"agent\":\"second\"}")
    rig.run(100)
    c.expect(rig.hub.sessions[rig.hub.find("s-r5")].clients.len() == 0, "switching the family cannot bypass fail-closed")
    c.expect(rig.hub.sessions[rig.hub.find("s-r5")].agent == "opencode", "the forbidden family switch retains the chosen agent")
    rig.page(1, "user_message", "s-r5", "{\"turn\":\"t1\",\"text\":\"подготовь задание\"}")
    // A test executable has no installed restricted adapter; a real installation without
    // a chosen model reaches the later missing-backend guard. Both must forbid ordinary ACP.
    c.expect(rig.until("обычный ACP запрещён", 5000), "the unsupported backend explicitly forbids ordinary ACP: ${ck_errors(rig)}")
    rig.run(300)
    ro lines1 = rig.lines_for(1)
    ro echo = answer_of(lines1, line_input(first_of(lines1, "user_message", 0), "turn"))
    c.expect(echo == "", "no prompt goes to an unrestricted ACP agent")
    ro st1 = rk_last(rig.all_lines_for(1), "route_state")
    ro task = rk_task(st1)
    ro id = jtext(task, "id")
    ro dir = "${settings.data_dir}/s-r5/tasks/${id}/task"
    c.expect(id == "draft", "the draft does not reserve a task number: ${id}")
    c.expect(jtext(task, "worktree") == "" && jtext(task, "branch") == "", "the planning makes no tree")
    c.expect(!dir_there("${repo}/../worktrees"), "no folder of trees is made")
    c.expect(rk_text("${dir}/message.1.md").contains("подготовь задание"), "message.1.md is in the data folder")
    c.expect(parse_progress(rk_text("${task_artifact_dir(dir)}/progress.1.md")).total == 0, "the draft has no execution checklist")

    rig.page(1, "route_run", "s-r5", "{}")
    rig.run(500)
    rig.run(500)
    ro st2 = rk_last(rig.all_lines_for(1), "route_state")
    c.expect(!rk_task_is_null(st2) && !((rk_task(st2).get("closed") ?? JsonValue.null()).bool() ?? false), "the planning leaves the task open")
    c.expect(kit_with(rig.lines_for(1), "Независимая проверка (second)") == 0, "preparation does not launch an independent executor")
    rig.page(1, "session_worktree", "s-r5", "{\"on\":true}")
    rig.run(300)
    c.expect(!dir_there("${repo}/../worktrees"), "a forged worktree signal cannot create a tree in preparation")
    for signal in ["route_merge", "route_publish", "route_tests_run", "route_children_merge", "route_subtask_worktree", "route_subtask_parallel", "route_new_task", "route_tree_drop"] {
        rig.page(1, signal, "s-r5", "{\"n\":1,\"on\":true,\"force\":true}")
    }
    rig.run(300)
    c.expect(jtext(rk_state(rig), "route") == "planning", "forged execution signals do not leave preparation")
    c.expect(!dir_there("${repo}/../worktrees"), "forged execution signals create no tree")
    // Inject the already recognised list at the server boundary: no unsafe external transport is used by this test.
    ro items_text = "{\"tasks\":${JsonValue.array([rk_item("new", "Черновик", 0, ["src/code.nv"])]).to_str()}}"
    ro items = match proposals_of_list_text(items_text) { Ok(items) => items, Err(e) => panic(e) }
    ro prep_at = rig.hub.find("s-r5")
    ro offered = rig.hub.ct_list_offer(prep_at, items)
    rig.hub.route_broadcast(prep_at, true)
    rig.run(100)
    c.expect(offered == 1, "recognised statements are accepted without starting an executor")
    ro recognized = rk_state(rig)
    rig.page(1, "route_prop", "s-r5", "{\"id\":${rk_card_id(recognized, "Черновик")},\"action\":\"start\",\"mode\":\"new\",\"run\":\"full\"}")
    rig.run(500)
    c.expect(rk_text("${dir}/drafts/${task_slug("Черновик")}/task/message.md").contains("сделать: Черновик"), "confirmation writes a statement, not implementation")
    c.expect(jtext(rk_state(rig), "route") == "planning", "confirmation keeps preparation selected")
    c.expect(!dir_there("${repo}/../worktrees"), "a forged full route on the proposal does not start execution")
    c.expect(git_run(repo, ["branch", "--list"]).text == branches_before, "preparation and forged signals create or switch no branch")
    c.expect(git_run(repo, ["symbolic-ref", "HEAD"]).text == head_before, "preparation does not switch HEAD")

    // the assignment and a picture are in the folder of the task; the owner chooses a mode that does the task
    ro more = append_file("${dir}/message.1.md", "\n## Задание\n\nцель\n\n![картинка](images/image-1.png)\n")
    ro pic = write_file("${dir}/images/image-1.png", "not really a picture")
    rig.page(1, "session_route", "s-r5", "{\"route\":\"fast\"}")
    rig.run(3000)
    ro st3 = rk_last(rig.all_lines_for(1), "route_state")
    ro tree = jtext(rk_task(st3), "worktree")
    c.expect(jtext(rk_task(st3), "id") == id, "the task stays the same: ${jtext(rk_task(st3), "id")}")
    c.expect(tree == "", "changing the mode does not start execution or create a tree")
    ro moved = dir
    c.expect(rk_text("${moved}/message.1.md").contains("## Задание"), "the assignment went into the tree")
    c.expect(path_there("${moved}/images/image-1.png"), "the pictures went with it")
    c.expect(parse_progress(rk_text("${task_artifact_dir(moved)}/progress.1.md")).total == 6 && rk_boxes_done("${task_artifact_dir(moved)}/progress.1.md") == 0, "the checklist is made again for the six steps")
    c.expect(rk_steps_in(st3, "pending") == 6, "the steps of the new mode are pending")
    rig.page(1, "user_message", "s-r5", "{\"turn\":\"t2\",\"text\":\"продолжай\"}")
    // Recorded journal: 725 durable echo chunks, completion at 30093 ms; no lost answer.
    // This scenario checks recovery, not a 20-second end-to-end performance SLA.
    c.expect(rig.until(KIT_DONE, 120000), "the next message is answered")
    // the answer is the echo of what the agent got: wait for the end of it (the message of the owner comes last)
    mut echo2 = ""
    mut waited = 0
    while waited < 20000 && !echo2.ends_with("продолжай") {
        rig.run(300)
        waited += 300
        ro lines2 = rig.lines_for(1)
        echo2 = answer_of(lines2, rk_last_turn(lines2))
    }
    c.expect(echo2.contains("[canopus] в конце") && echo2.contains("раздел «Задание»"), "the agent is told the assignment is the statement: ${echo2.byte_len()}")
    c.expect(echo2.contains("images/"), "and where the pictures are")
    rig.page(1, "session_route", "s-r5", "{\"route\":\"planning\"}")
    rig.run(200)
    c.expect(rig.hub.sessions[rig.hub.find("s-r5")].clients.len() == 0, "entering preparation closes an already opened unrestricted ACP client")
    c.expect(rk_text("${dir}/drafts/${task_slug("Черновик")}/task/message.md").contains("сделать: Черновик"), "switching modes keeps the saved statement")
    rig.shut()
    mut again = rig_open(settings)
    again.attach(1)
    c.expect(jtext(rk_state(again), "route") == "planning", "restart restores preparation")
    c.expect(rk_text("${dir}/drafts/${task_slug("Черновик")}/task/message.md").contains("сделать: Черновик"), "restart preserves the statement")
    c.expect(again.hub.sessions[again.hub.find("s-r5")].clients.len() == 0, "restart does not bypass the backend refusal")
    again.page(1, "session_route", "s-r5", "{\"route\":\"interactive\"}")
    again.page(1, "session_worktree", "s-r5", "{\"on\":false}")
    again.page(1, "user_message", "s-r5", "{\"turn\":\"normal-after-restart\",\"text\":\"обычная беседа после перезапуска\"}")
    mut normal = ""
    mut normal_waited = 0
    while normal_waited < 20000 && !normal.ends_with("обычная беседа после перезапуска") {
        again.run(300)
        normal_waited += 300
        ro normal_lines = again.lines_for(1)
        normal = answer_of(normal_lines, rk_last_turn(normal_lines))
    }
    c.expect(normal.ends_with("обычная беседа после перезапуска"), "switching back to interactive after restart restores ordinary conversation")
    c.expect(again.hub.sessions[again.hub.find("s-r5")].clients.len() > 0, "interactive starts a fresh ordinary ACP client after the preparation refusal")
    again.shut()
    c.report()
}

/// A session without "Worktree": the agent works in the folder of the project itself, no task and no tree in the mode interactive; the switch turns the tree on for the next task.
export fn scenario_route_notree(settings ServerSettings) Proc Detach Time Net Fs Os -> str {
    mut c = kit_check()
    ro repo = settings.workdir
    mut rig = rig_open(settings)
    rig.attach(1)
    rk_project_page(rig, 1, "s-r6", "{\"name\":\"Без дерева\",\"agent\":\"opencode\",\"worktree\":false}")
    c.expect(rig.until("\"kind\":\"session_created\"", 5000), "the session is shown")
    rig.run(300)
    c.expect(!((rk_last(rig.all_lines_for(1), "route_state").get("use_tree") ?? JsonValue.null()).bool() ?? true), "the page is told: no tree")
    rig.page(1, "user_message", "s-r6", "{\"turn\":\"t1\",\"text\":\"pwd\"}")
    c.expect(rig.until(KIT_DONE, 20000), "the message is answered")
    rig.run(300)
    ro lines = rig.lines_for(1)
    ro answer = answer_of(lines, line_input(first_of(lines, "user_message", 0), "turn")).replace("\\", "/")
    c.expect(answer.contains(repo.replace("\\", "/")) && !answer.contains("/worktrees/"), "the agent works in the folder of the project: ${answer}")
    c.expect(rk_task_is_null(rk_last(rig.all_lines_for(1), "route_state")), "no task in the mode interactive without a tree")
    c.expect(!dir_there("${repo}/../worktrees"), "no tree is made")
    // the switch is on: the next task gets a tree
    rig.page(1, "session_worktree", "s-r6", "{\"on\":true}")
    rig.run(300)
    c.expect((rk_last(rig.all_lines_for(1), "route_state").get("use_tree") ?? JsonValue.null()).bool() ?? false, "the switch is on")
    c.expect(rk_offer_tasks(rig, "s-r6", [rk_item("new", "С деревом", 0, ["a.txt"])], "С деревом"), "the MCP proposal is shown while prompt dispatch waits for the copy")
    rig.press("s-r6", "С деревом", "start")
    rig.run(3000)
    c.expect(!rk_task_is_null(ck_state(rig, 1, "s-r6")), "the owner starts a work: the task is there")
    ro st = rk_last(rig.all_lines_for(1), "route_state")
    c.expect(jtext(rk_task(st), "worktree").byte_len() > 0, "the task has a tree now")
    // with a tree the switch cannot be turned off
    rig.page(1, "session_worktree", "s-r6", "{\"on\":false}")
    c.expect(rig.until("выключить Worktree нельзя", 5000), "a tree that is there is not switched off")
    rig.shut()
    c.report()
}
