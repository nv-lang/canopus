// stdio.nv - the hub as a program: the lines of its stdin are what the pages and the front say, the lines of its stdout are
// what the hub says to the pages (task 099).
//
// The installed server calls the same loop over channels; stdio is a diagnostic adapter.
//
// The lines, one per line, fields separated by a tab (a JSON text has no raw line break or tab):
//   to the hub:    open <conn> | close <conn> | msg <conn> <page message> | quit
//   from the hub:  ready | <conn> <message for the page>      (conn 0: for every page)
// stderr carries the log. The hub ends when it reads `quit` or when its stdin is closed.
//
// ORACLE-WORKAROUND(31): `Stdin.read` waits until the whole buffer is full (or the end of the stream), so a line that is shorter than the buffer would never arrive; the buffer is ONE byte; read a chunk when item 31 is fixed.
// Reading parks only the fiber that reads.
module canopus.server

import canopus.acp.{LineSplitter}
import canopus.storage.{replace_file}
import std.fs.{Path}
import std.concurrency.nvchan.{Chan, ChanTx, ChanRx}
import std.io.{stdin, stdout, stderr, Stdin, IoError}

export type HubCommand enum
    | HubAttach { conn int, lazy bool }
    | HubRelease { conn int }
    | HubPageMessage { conn int, text str }
    | HubQuit

// ORACLE-WORKAROUND(31): the read of stdin waits in C (`fread`) and, if it were made by a fiber, would keep the worker thread of that fiber and starve the fibers queued on it until a byte comes; `#blocking` sends the call to the thread pool; call `Stdin.read` in the fiber when item 31 is fixed
#blocking
fn read_blocking(mut input Stdin, mut buf []u8) Io -> Result[int, IoError] => input.read(buf)

fn read_stdin(tx ChanTx[HubCommand]) Io -> () {
    mut buf []u8 = []u8.new()
    buf.resize(1, 0 as u8)
    mut splitter = LineSplitter.new()
    mut input = stdin()
    mut reading = true
    while reading {
        match read_blocking(input, buf) {
            Ok(0) => { reading = false }
            Ok(n) => {
                for line in splitter.feed(buf[..n]) {
                    send_stdio_command(tx, line)
                }
            }
            Err(e) => { reading = false }
        }
    }
    match splitter.flush() {
        Some(rest) => {
            send_stdio_command(tx, rest)
        }
        None => ()
    }
    ro bye = tx.send(HubCommand.HubQuit)
}

fn to_log(text str) Io -> () {
    mut err = stderr()
    ro written = err.write("${text}\n".bytes())
}

fn to_front(line str) Io -> () {
    mut out = stdout()
    ro written = out.write("${line}\n".bytes())
}

fn conn_of(text str) -> int {
    match text.to_int() {
        Ok(n) => n
        Err(e) => 0
    }
}

fn parse_stdio_command(line str) -> Option[HubCommand] {
    if line == "quit" { return Some(HubCommand.HubQuit) }
    ro first = line.find("\t")?
    ro verb = line[..first]
    ro rest = line[first + 1..]
    if verb == "open" || verb == "open_lazy" {
        return Some(HubCommand.HubAttach { conn: conn_of(rest), lazy: verb == "open_lazy" })
    }
    if verb == "close" { return Some(HubCommand.HubRelease { conn: conn_of(rest) }) }
    if verb == "msg" {
        ro second = rest.find("\t")?
        return Some(HubCommand.HubPageMessage { conn: conn_of(rest[..second]), text: rest[second + 1..] })
    }
    None
}

fn send_stdio_command(tx ChanTx[HubCommand], line str) -> () {
    match parse_stdio_command(line) {
        Some(cmd) => { ro sent = tx.send(cmd) }
        None => ()
    }
}

fn apply_command(mut hub Hub, cmd HubCommand) Proc Detach Time -> bool {
    match cmd {
        HubAttach { conn, lazy } => {
            if lazy { hub.attach_lazy(conn) }
            else { hub.attach(conn) }
        }
        HubRelease { conn } => hub.release(conn)
        HubPageMessage { conn, text } => hub.handle(conn, text)
        HubQuit => return false
    }
    true
}

// The hub being run: the hub of a result cannot be bound as mutable, a field of a mutable record can be changed.
type Running { hub Hub }

/// Diagnostic adapter for the standalone hub. The installed server uses typed channels.
export fn run_hub_stdio(settings ServerSettings) Proc Detach Time Net Fs Os Io -> int {
    ro commands = Chan[HubCommand].new(4096)
    detach { read_stdin(commands.tx) }
    ro events = Chan[Outgoing].new(1)
    run_hub_loop(settings, commands.rx, events.tx, true)
}

export fn run_hub_loop(settings ServerSettings, commands ChanRx[HubCommand], events ChanTx[Outgoing], stdio bool) Proc Detach Time Net Fs Os Io -> int {
    match start_hub_for_pages(settings) {
        Err(reason) => {
            to_log("the hub cannot start: ${reason}")
            1
        }
        Ok(started) => {
            mut running_hub = Running { hub: started }
            for line in running_hub.hub.take_log() { to_log(line) }
            if stdio { to_front("ready") }
            running_hub.hub.save_history_previews()
            ro index_path = Path.from_bytes("${settings.layout.cache}/sessions-index.json".bytes())
            mut saved_index = ""
            mut preview_due = 0
            mut running = true
            while running {
                mut busy = false
                mut more = true
                while more {
                    match commands.try_recv() {
                        Some(cmd) => {
                            busy = true
                            if !apply_command(running_hub.hub, cmd) {
                                running = false
                                more = false
                            }
                        }
                        None => { more = false }
                    }
                }
                if running { running_hub.hub.pump_restores() }
                ro outgoing = running_hub.hub.take_output()
                for o in outgoing {
                    if stdio { to_front("${o.conn}\t${o.text}") }
                    else { ro sent = events.send(o) }
                    busy = true
                }
                // A preview is a cache. Give the browser time to submit after receiving the history.
                if outgoing.len() > 0 { preview_due = Time.now().unix_millis() + 250 }
                if saved_index.byte_len() == 0 || outgoing.len() > 0 {
                    ro index = running_hub.hub.session_index()
                    if index != saved_index && replace_file(index_path, index) { saved_index = index }
                }
                if running {
                    ro made = running_hub.hub.pump()
                    if made > 0 { busy = true }
                }
                if !busy && preview_due > 0 && Time.now().unix_millis() >= preview_due && !running_hub.hub.prioritize_agent_start() {
                    running_hub.hub.save_history_previews()
                    preview_due = 0
                }
                for line in running_hub.hub.take_log() { to_log(line) }
                if !busy { 8.to_millis().sleep() }
            }
            running_hub.hub.close()
            to_log("the hub ended")
            0
        }
    }
}
