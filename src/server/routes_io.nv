// routes_io.nv - task 192q: the disk and the processes under the modes of work: the files of the tasks (`message.N.md`, `progress.N.md`), the files of the modes, `git`.
// The git operations of the tasks (trees, merges, publishing) are the module of task 192r (`taskwt.nv`); here is only what the hub needs of the plain disk.
module canopus.server

import std.fs.{Fs, real_fs, Path, read_text, write_text, create_dir_all, try_exists, read_dir, metadata, copy_file, remove_file}
import std.os.{Command}
import std.encoding.json.{JsonObject}
import canopus.process.{command_run_timed}

fn rio_path(p str) -> Path => Path.from_bytes(p.bytes())

/// Does the file or folder exist?
export fn path_there(p str) -> bool {
    // D454: boundary override inside non-test code, see module-conventions
    with Fs = real_fs() {
        match try_exists(rio_path(p)) {
            Ok(b) => b
            Err(e) => false
        }
    }
}

/// Is it a folder?
export fn dir_there(p str) -> bool {
    // D454: boundary override inside non-test code, see module-conventions
    with Fs = real_fs() {
        match metadata(rio_path(p)) {
            Ok(m) => m.is_dir()
            Err(e) => false
        }
    }
}

/// The text of a file, None - it cannot be read.
export fn read_file(p str) -> Option[str] {
    // D454: boundary override inside non-test code, see module-conventions
    with Fs = real_fs() {
        match read_text(rio_path(p)) {
            Ok(t) => Some(t)
            Err(e) => None
        }
    }
}

/// Write a file (the folders above it are made); false - it could not be written.
export fn write_file(p str, text str) -> bool {
    // D454: boundary override inside non-test code, see module-conventions
    with Fs = real_fs() {
        match rio_path(p).parent() {
            Some(parent) => {
                match create_dir_all(parent) {
                    Ok(done) => ()
                    Err(e) => return false
                }
            }
            None => ()
        }
        match write_text(rio_path(p), text) {
            Ok(done) => true
            Err(e) => false
        }
    }
}

/// Add a text to the end of a file (it is made when there is none).
export fn append_file(p str, text str) -> bool {
    ro old = read_file(p) ?? ""
    write_file(p, "${old}${text}")
}

/// The names in a folder (files and folders), [] when it cannot be read.
export fn dir_names(p str) -> []str {
    mut out = []str.new()
    // D454: boundary override inside non-test code, see module-conventions
    with Fs = real_fs() {
        match read_dir(rio_path(p)) {
            Ok(entries) => {
                for entry in entries {
                    match entry.name_str() {
                        Some(name) => out.push(name)
                        None => ()
                    }
                }
            }
            Err(e) => ()
        }
    }
    out
}

/// Copy a file as it is (bytes), the folders above the new one are made; false - it could not be copied.
export fn io_copy_file(src str, dst str) -> bool {
    // D454: boundary override inside non-test code, see module-conventions
    with Fs = real_fs() {
        match rio_path(dst).parent() {
            Some(parent) => {
                match create_dir_all(parent) {
                    Ok(done) => ()
                    Err(e) => return false
                }
            }
            None => ()
        }
        match copy_file(rio_path(src), rio_path(dst)) {
            Ok(n) => true
            Err(e) => false
        }
    }
}

/// Copy a folder with everything in it (the folders inside too) into `dst`; the number of the files copied (-1 - one could not be).
export fn io_copy_dir(src str, dst str) -> int {
    mut count = 0
    for name in dir_names(src) {
        if dir_there("${src}/${name}") {
            ro inner = io_copy_dir("${src}/${name}", "${dst}/${name}")
            if inner < 0 { return -1 }
            count += inner
        } else {
            if !io_copy_file("${src}/${name}", "${dst}/${name}") { return -1 }
            count += 1
        }
    }
    count
}

/// Remove a file; false - it could not be.
export fn io_remove_file(p str) -> bool {
    // D454: boundary override inside non-test code, see module-conventions
    with Fs = real_fs() {
        match remove_file(rio_path(p)) {
            Ok(done) => true
            Err(e) => false
        }
    }
}

/// ShellOut: did the command end with 0, and what it printed (the output; the error text when it failed).
export type ShellOut { ok bool, text str }

/// The time for one child of the hub (the shared task adapter, `git`): the taskwt convention.
const SHELL_RUN_MS = 15000

type TimedRun { finished bool, out ShellOut }

fn command_output_timed(mut command Command, timeout_ms int) Proc Time -> TimedRun {
    ro raw = command_run_timed(command, timeout_ms)
    if raw.note.byte_len() > 0 { return TimedRun { finished: raw.finished, out: ShellOut { ok: false, text: raw.note } } }
    ro printed = raw.out.to_str_lossy().trim_ascii()
    if raw.code == 0 { return TimedRun { finished: raw.finished, out: ShellOut { ok: true, text: printed } } }
    TimedRun { finished: raw.finished, out: ShellOut { ok: false, text: joined([printed, raw.err.to_str_lossy().trim_ascii()], "\n") } }
}

/// `git -C dir args...` without a terminal prompt or an editor.
export fn git_run(dir str, args []str) Proc Time -> ShellOut {
    mut command = Command.new("git")
    command.arg("-C")
    command.arg(dir)
    for a in args { command.arg(a) }
    command.env("GIT_TERMINAL_PROMPT", "0")
    command.env("GIT_EDITOR", "true")
    ro run = command_output_timed(command, SHELL_RUN_MS)
    // finished=false means the child was ended by the timeout: run.out already says so.
    run.out
}

// 331: legacy projects keep their task store until the explicit folder migration.
fn project_task_directory(root str) -> str {
    ro cfg = jobject(read_file("${root}/.canopus/plugin/config.json") ?? "") ?? JsonObject.new()
    ro explicit = jtext(cfg, "tasks_dir").replace("\\", "/")
    if explicit.starts_with("/") || explicit.contains(":") { return "" }
    for segment in explicit.split("/") { if segment == ".." || segment == "." { return "" } }
    if explicit != "" { return "${root}/${explicit}" }
    if path_there("${root}/docs/tasks") && path_there("${root}/doc/tasks") { return "" }
    if path_there("${root}/doc/tasks") { return "${root}/doc/tasks" }
    "${root}/docs/tasks"
}
