// front_settings_test.nv - the settings of the front: the port, the folder of the page, the command of the hub; a file and the
// environment over it (the keys are those of src/server/settings.nv).
module canopus.server.front

import std.os.{Os, MockOs, mock_os, real_os, temp_dir, pid}
import std.fs.{Fs, real_fs, write_text, create_dir_all, remove_dir_all, Path}

fn front_file(name str, text str) -> Path {
    ro base = with Os = real_os() { temp_dir() }
    ro id = with Os = real_os() { pid() }
    ro dir = base.join("canopus-front-settings-${id}-${name}")
    ro path = dir.join(name)
    with Fs = real_fs() {
        ro made = create_dir_all(dir)
        ro written = write_text(path, text)
    }
    path
}

test "front resolved parser retains internal code policy features" {
    ro cfg = fs_from_file("{\"port\":8123,\"hub\":{\"program\":\"internal-hub\",\"args\":[\"x\"]},\"voice\":{\"managed\":false,\"dir\":\"internal-tools\",\"model\":\"medium\"},\"max_image_bytes\":4096}")
    assert(cfg.port == 8123 && cfg.hub_program == "internal-hub" && cfg.hub_args.len() == 1)
    assert(!cfg.stt_managed && cfg.stt_dir == "internal-tools" && cfg.stt_model == "medium" && cfg.max_image_bytes == 4096)
}

test "front public config: custom basename and instance folders" {
    ro file = front_file("custom.json", "{\"port\":8123,\"voice\":{\"language\":\"ru\",\"model\":\"medium\"}}")
    ro root = file.parent().unwrap().display().replace("\\", "/")
    mut state = MockOs.new()
    state.set_cwd_str("C:/work/repo")
    state.push_arg("C:/work/install/target/canopus.exe")
    match with Os = mock_os(state), Fs = real_fs() { front_settings_selected("", root, []str.new(), file.display()) } {
        Ok(cfg) => {
            assert(cfg.port == 8123 && cfg.stt_language == "ru" && cfg.stt_model == "medium")
            assert(cfg.layout.config_file.replace("\\", "/").ends_with("/custom.json"))
            assert(cfg.data_dir == "${root}/data/sessions" && cfg.stt_dir == "${root}/tools/whisper")
            assert(cfg.web_dir == "C:/work/install/src/web" && cfg.hub_program == "C:/work/install/target/canopus-hub.exe")
        }
        Err(e) => assert(false)
    }
}

test "front public config: voice can be disabled without a managed path override" {
    ro file = front_file("voice-off.json", "{\"voice\":false}")
    ro root = file.parent().unwrap().display()
    match with Os = mock_os(MockOs.new()), Fs = real_fs() { front_settings_selected("", root, []str.new(), file.display()) } {
        Ok(cfg) => assert(!cfg.stt_managed)
        Err(e) => assert(false)
    }
}

test "front public config: internal fields and retired overrides are refused" {
    ro file = front_file("internal.json", "{\"voice\":{\"dir\":\"not-a-public-path\"}}")
    match with Os = mock_os(MockOs.new()), Fs = real_fs() { front_settings_selected("", file.parent().unwrap().display(), []str.new(), file.display()) } {
        Ok(cfg) => assert(false)
        Err(e) => assert(e.contains("voice.dir") && !e.contains("not-a-public-path"))
    }
    mut state = MockOs.new()
    state.put_env("CANOPUS_SERVER_PORT", "not-printed-value")
    match with Os = mock_os(state), Fs = real_fs() { front_settings_in("", "C:/work/instance", []str.new()) } {
        Ok(cfg) => assert(false)
        Err(e) => assert(e.contains("CANOPUS_SERVER_PORT") && !e.contains("not-printed-value"))
    }
}

test "front public layers: project and personal fields override global" {
    ro file = front_file("layers.json", "{\"port\":8100,\"voice\":{\"language\":\"ru\"}}")
    ro root = file.parent().unwrap().display().replace("\\", "/")
    with Fs = real_fs() {
        ro made = create_dir_all(Path.from_bytes("${root}/repo/.canopus".bytes()))
        ro one = write_text(Path.from_bytes("${root}/repo/.canopus/config.json".bytes()), "{\"port\":8101}")
        ro two = write_text(Path.from_bytes("${root}/repo/.canopus/local.json".bytes()), "{\"voice\":{\"language\":\"en\"}}")
    }
    mut state = MockOs.new()
    state.set_cwd_str("${root}/repo/src")
    match with Os = mock_os(state), Fs = real_fs() { front_settings_selected("", root, []str.new(), file.display()) } {
        Ok(cfg) => assert(cfg.port == 8101 && cfg.stt_language == "en")
        Err(e) => assert(false)
    }
}
