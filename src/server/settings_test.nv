// settings_test.nv - the settings of the session server: a JSON file and the environment over it; the password is in no
// text that can be printed.
module canopus.server

import std.fs.{Path}
import canopus.config.{defaults_layer, policy_layer, parse_database_url}
import std.os.{Os, MockOs, mock_os, real_os, temp_dir, pid}
import std.fs.{Fs, real_fs, read_text, write_text, create_dir_all, remove_dir_all, Path}

fn full_settings_text() -> str => "{\"port\":8123,\"data_dir\":\"C:/work/canopus-data\",\"store\":\"pg\",\"pg\":{\"host\":\"localhost\",\"port\":55432,\"database\":\"canopus_x\",\"user\":\"canopus_login\",\"password\":\"file-test-pw\"},\"agents\":[{\"id\":\"opencode\",\"label\":\"OpenCode\",\"program\":\"opencode\",\"args\":[\"acp\"]},{\"id\":\"fake\",\"program\":\"node\",\"args\":[\"a.mjs\",\"--live\"]}],\"idle_term_seconds\":60,\"workdir\":\"C:/work/project\",\"web_dir\":\"web\",\"hub\":{\"program\":\"target/hub.exe\",\"args\":[\"x\"]}}"

fn must_settings(text str) -> ServerSettings {
    match parse_server_settings(text) {
        Ok(s) => s
        Err(e) => panic("settings: ${e}")
    }
}

fn settings_file(name str, text str) -> Path {
    ro base = with Os = real_os() { temp_dir() }
    ro id = with Os = real_os() { pid() }
    ro dir = base.join("canopus-server-settings-${id}-${name}")
    ro path = dir.join(name)
    with Fs = real_fs() {
        ro made = create_dir_all(dir)
        ro written = write_text(path, text)
    }
    path
}

fn is_error(result Result[ServerSettings, str]) -> bool {
    match result {
        Ok(s) => false
        Err(e) => true
    }
}

test "settings: an empty object has the defaults, opencode acp among them" {
    ro s = must_settings("{}")
    assert(s.port == 8099)
    assert(s.store == "files")
    assert(s.data_dir == "canopus-data")
    assert(s.idle_term_ms == 900000)
    assert(s.web_dir == "src/web")
    assert(s.agents.len() == 1)
    assert(s.agents[0].id == "opencode")
    assert(s.agents[0].program == default_opencode_program())
    assert(s.agents[0].args.len() == 1)
    assert(s.agents[0].args[0] == "acp")
}

test "settings: every key of a file is read" {
    ro s = must_settings(full_settings_text())
    assert(s.port == 8123)
    assert(s.data_dir == "C:/work/canopus-data")
    assert(s.store == "pg")
    assert(s.pg.port == 55432 && s.pg.database == "canopus_x" && s.pg.user == "canopus_login")
    assert(s.agents.len() == 2)
    assert(s.agents[0].label == "OpenCode")
    assert(s.agents[1].id == "fake")
    assert(s.agents[1].label == "fake")
    assert(s.agents[1].args.len() == 2 && s.agents[1].args[1] == "--live")
    assert(s.idle_term_ms == 60000)
    assert(s.workdir == "C:/work/project")
    assert(s.web_dir == "web")
    assert(s.hub_program == "target/hub.exe")
    assert(s.hub_args.len() == 1)
}

test "settings: an agent is found by its id" {
    ro s = must_settings(full_settings_text())
    match s.agent("fake") {
        Some(a) => assert(a.program == "node")
        None => assert(false)
    }
    assert(s.agent("nobody") == None)
}

test "settings: a wrong file is an error that does not print the content" {
    assert(is_error(parse_server_settings("not json password=never-printed")))
    assert(is_error(parse_server_settings("[1]")))
    assert(is_error(parse_server_settings("{\"port\":\"x\"}")))
    assert(is_error(parse_server_settings("{\"port\":0}")))
    assert(is_error(parse_server_settings("{\"store\":\"redis\"}")))
    assert(is_error(parse_server_settings("{\"agents\":[]}")))
    assert(is_error(parse_server_settings("{\"agents\":[{\"program\":\"x\"}]}")))
    assert(is_error(parse_server_settings("{\"agents\":[{\"id\":\"a\"}]}")))
    assert(is_error(parse_server_settings("{\"idle_term_seconds\":0}")))
    match parse_server_settings("{\"pg\":{\"password\":\"never-printed\",\"port\":\"x\"}}") {
        Ok(s) => assert(false)
        Err(e) => assert(!e.contains("never-printed"))
    }
}

test "settings: the description has no password" {
    ro s = must_settings(full_settings_text())
    ro text = s.describe()
    assert(text.contains("8123"))
    assert(text.contains("pg"))
    assert(text.contains("opencode"))
    assert(!text.contains("file-test-pw"))
}

test "settings: pg without a password does not pass the check, files need none" {
    ro files = must_settings("{}")
    match files.check() {
        Ok(done) => ()
        Err(e) => assert(false)
    }
    ro pg = must_settings("{\"store\":\"pg\"}")
    match pg.check() {
        Ok(done) => assert(false)
        Err(e) => assert(e.contains("password"))
    }
    ro ok = must_settings(full_settings_text())
    match ok.check() {
        Ok(done) => ()
        Err(e) => assert(false)
    }
}





test "settings: the example file of the repository is a valid configuration" {
    ro text = with Fs = real_fs() {
        match read_text(Path.from_bytes("src/server/server.example.json".bytes())) {
            Ok(t) => t
            Err(e) => ""
        }
    }
    assert(text.byte_len() > 0)
    ro s = must_settings(text)
    assert(s.agents.len() >= 1)
    match s.check() {
        Ok(done) => ()
        Err(e) => assert(false)
    }
}

test "settings: the public pg example has no connection secret and cannot open a database" {
    ro text = with Fs = real_fs() {
        match read_text(Path.from_bytes("src/server/server-pg.example.json".bytes())) {
            Ok(t) => t
            Err(e) => ""
        }
    }
    assert(text.byte_len() > 0)
    ro s = must_settings(text)
    assert(s.store == "pg")
    assert(s.pg.port == 5432)
    assert(s.pg.database == "canopus")
    assert(s.pg.user == "canopus_app")
    assert(s.pg.password == "")
    match s.check() {
        Ok(done) => assert(false)
        Err(e) => assert(e.contains("pg"))
    }
}











test "settings: an agent asks the owner by its own tool (native) unless the file says mcp or off" {
    ro s = must_settings("{\"agents\":[{\"id\":\"a\",\"program\":\"x\"},{\"id\":\"b\",\"program\":\"x\",\"ask\":\"mcp\"},{\"id\":\"c\",\"program\":\"x\",\"ask\":\"off\"}]}")
    assert(s.agents[0].ask == "native")
    assert(s.agents[1].ask == "mcp")
    assert(s.agents[2].ask == "off")
    assert(is_error(parse_server_settings("{\"agents\":[{\"id\":\"a\",\"program\":\"x\",\"ask\":\"always\"}]}")))
}

test "settings: the modes of work have defaults and can be set" {
    ro plain = must_settings("{}")
    assert(plain.routes_dir == "doc/routes")
    assert(plain.route_reviewer_order == ["codex", "claude", "kimi", "opencode"])
    assert(plain.route_task_limit == 12)
    assert(plain.route_task_messages == 40)
    assert(plain.route_fix_attempts == 2)
    assert(plain.route_worktree_ask)
    assert(plain.route_overlap_seconds == 30)
    assert(plain.route_keep_days == 30)
    assert(plain.context_drop_percent == 40)
    assert(plain.route_confirm_word == "задача" && plain.route_over_limit_word == "сверх" && plain.route_max_active == 3 && plain.route_tool && !plain.route_auto_propose)
    ro set = must_settings("{\"routes_dir\":\"my/routes\",\"route_reviewer_order\":[\"kimi\"],\"route_task_limit\":5,\"route_task_messages\":9,\"route_fix_attempts\":3,\"route_worktree_ask\":false,\"route_overlap_seconds\":10,\"route_keep_days\":0}")
    assert(set.routes_dir == "my/routes")
    assert(set.route_reviewer_order == ["kimi"])
    assert(set.route_task_limit == 5 && set.route_task_messages == 9 && set.route_fix_attempts == 3)
    assert(!set.route_worktree_ask)
    assert(set.route_overlap_seconds == 10)
    assert(set.route_keep_days == 0)
    ro words = must_settings("{\"route_confirm_word\":\"go\",\"route_over_limit_word\":\"more\",\"route_max_active\":0,\"route_tool\":false,\"route_auto_propose\":true}")
    assert(words.route_confirm_word == "go" && words.route_over_limit_word == "more" && words.route_max_active == 0 && !words.route_tool && words.route_auto_propose)
    assert(is_error(parse_server_settings("{\"route_reviewer_order\":\"kimi\"}")))
}

// ----- the layers and the layout of the folders (task 192.12) -----

fn layers_root(name str) -> str {
    ro base = with Os = real_os() { temp_dir() }
    ro id = with Os = real_os() { pid() }
    ro dir = base.join("canopus-layers-${name}-${id}")
    with Fs = real_fs() {
        ro gone = remove_dir_all(dir)
        ro made = create_dir_all(dir)
    }
    dir.display().replace("\\", "/")
}

fn layers_put(root str, rel str, text str) -> () {
    ro path = Path.from_bytes("${root}/${rel}".bytes())
    with Fs = real_fs() {
        match path.parent() {
            Some(p) => { ro made = create_dir_all(p) }
            None => ()
        }
        ro written = write_text(path, text)
    }
}

fn layers_drop(root str) -> () {
    with Fs = real_fs() {
        ro gone = remove_dir_all(Path.from_bytes(root.bytes()))
    }
}















test "layers: the defaults of the schema are the defaults of the settings" {
    ro s = must_settings("{}")
    ro d = policy_layer().obj
    assert(d.get("port").unwrap().int() == Some(s.port))
    assert(d.get("web_dir").unwrap().str() == Some(s.web_dir))
    assert(d.get("max_image_bytes").unwrap().int() == Some(s.max_image_bytes))
    assert(d.get("route_task_limit").unwrap().int() == Some(s.route_task_limit))
    assert(d.get("route_max_active").unwrap().int() == Some(s.route_max_active))
    assert(d.get("route_confirm_word").unwrap().str() == Some(s.route_confirm_word))
    assert(d.get("ask_timeout_seconds").unwrap().int() == Some(s.ask_timeout_ms / 1000))
    assert(d.get("idle_term_seconds").unwrap().int() == Some(s.idle_term_ms / 1000))
    assert(d.get("preset").unwrap().str() == Some(s.preset))
    assert(d.get("voice").unwrap().object().unwrap().get("url").unwrap().str() == Some(s.stt_url))
}

test "settings: the confidence of the addition at once and the scope of the tasks are checked" {
    assert(must_settings("{}").auto_extend_confidence == "high" && must_settings("{}").task_scope == "session")
    assert(must_settings("{\"auto_extend_confidence\":\"medium\"}").auto_extend_confidence == "medium")
    assert(must_settings("{\"auto_extend_confidence\":\"off\"}").auto_extend_confidence == "off")
    assert(is_error(parse_server_settings("{\"auto_extend_confidence\":\"low\"}")))
    assert(is_error(parse_server_settings("{\"task_scope\":\"project\"}")))
}




// Runtime contract after 286; resolved parser tests above retain internal feature coverage.
test "public settings: five fields and explicit custom global file" {
    ro file = settings_file("public.json", "{\"port\":8123,\"voice\":{\"language\":\"ru\",\"model\":\"medium\"}}")
    ro home = file.parent().unwrap().display().replace("\\", "/")
    mut state = MockOs.new()
    state.set_cwd_str("C:/work/project")
    match with Os = mock_os(state), Fs = real_fs() { server_settings_selected("", home, []str.new(), file.display()) } {
        Ok(cfg) => {
            assert(cfg.port == 8123 && cfg.stt_language == "ru")
            assert(cfg.layout.sessions == "${home}/data/sessions")
            assert(cfg.idle_term_ms == 900000 && cfg.ask_form)
        }
        Err(e) => assert(false)
    }
}

test "public settings: internal keys in user files are refused by name" {
    ro file = settings_file("internal.json", "{\"idle_term_seconds\":1}")
    ro home = file.parent().unwrap().display()
    match with Os = mock_os(MockOs.new()), Fs = real_fs() { server_settings_selected("", home, []str.new(), file.display()) } {
        Ok(cfg) => assert(false)
        Err(e) => assert(e.contains("unknown key idle_term_seconds"))
    }
}

test "public settings: retired environment and command overrides never echo values" {
    mut state = MockOs.new()
    state.put_env("CANOPUS_PG_PASSWORD", "not-printed-value")
    match with Os = mock_os(state), Fs = real_fs() { server_settings_in("", "C:/work/instance", []str.new()) } {
        Ok(cfg) => assert(false)
        Err(e) => assert(e.contains("CANOPUS_PG_PASSWORD") && !e.contains("not-printed-value"))
    }
    assert(with Os = mock_os(MockOs.new()), Fs = real_fs() { server_settings_in("old.json", "C:/work/instance", []str.new()) }.is_err())
    assert(with Os = mock_os(MockOs.new()), Fs = real_fs() { server_settings_in("", "C:/work/instance", ["port=8123"]) }.is_err())
}

test "public settings: database_url reaches PostgreSQL without leaking password" {
    ro sample = "placeholder"
    ro scheme = "postgresql"
    ro url = "${scheme}://canopus_app:${sample}@127.0.0.1:5432/canopus"
    ro cfg = must_settings("{\"store\":\"pg\",\"database_url\":\"${url}\"}")
    assert(cfg.pg.password == "placeholder" && cfg.pg.database == "canopus")
    assert(!cfg.describe().contains("placeholder"))
}


test "public settings: voice false disables the endpoint through the selected config" {
    ro file = settings_file("voice-off.json", "{\"voice\":false}")
    ro home = file.parent().unwrap().display()
    match with Os = mock_os(MockOs.new()), Fs = real_fs() { server_settings_selected("", home, []str.new(), file.display()) } {
        Ok(cfg) => assert(cfg.stt_url == "")
        Err(e) => panic(e)
    }
    assert(is_error(parse_server_settings("{\"voice\":true}")))
}

test "settings: any registered family can supply a separate preparation transport" {
    ro s = must_settings("{\"agents\":[{\"id\":\"future-agent\",\"program\":\"ordinary\",\"preparation\":[\"restricted\",\"acp\"]}]}")
    ro agent = s.agent("future-agent").unwrap()
    assert(agent.program == "ordinary")
    assert(agent.preparation[0] == "restricted" && agent.preparation[1] == "acp")
    assert(is_error(parse_server_settings("{\"agents\":[{\"id\":\"future-agent\",\"program\":\"ordinary\",\"preparation\":[\"\"]}]}")))
}
