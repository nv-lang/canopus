// Native ids are protocol facts; the Alula table decides whether the choice may be applied.
module canopus.server

import alula.engine.{Incoming}
import std.encoding.json.{JsonObject, JsonValue}

export fn approval_offered(options JsonObject, value str) -> bool {
    if value.byte_len() == 0 { return false }
    for item in jlist(options, "modes") {
        match item.object() {
            Some(o) => if jtext(o, "id") == value { return true }
            None => ()
        }
    }
    false
}

fn Hub mut @approval_result(trace str, family str, refused bool, options str = "") Time -> () {
    mut input = JsonObject.new()
    jput(input, "family", JsonValue.str(family))
    jput(input, "refused", JsonValue.bool(refused))
    match jobject(options) {
        Some(o) => jput(input, "options", JsonValue.object(o))
        None => ()
    }
    @serial += 1
    @send(0, event_line("srv-${@serial}", trace, 0, "approval_result", input, now_millis()))
}

fn Hub mut @family_approval(trace str, family str, value str, start_agent bool) Proc Detach Time -> () {
    ro at = @find(trace)
    if at < 0 { return }
    mut s = @sessions[at]
    if @settings.agent(family).is_none() || value.byte_len() == 0 {
        @approval_result(trace, family, true)
        return
    }
    mut options = JsonObject.new()
    match @catalog.get(family) {
        Some(v) => { options = v.object() ?? JsonObject.new() }
        None => ()
    }
    // Current capabilities override a historical catalog, including an empty list.
    if family == s.agent && s.clients.len() > 0 && s.clients[0].phase() == "ready" {
        options = jobject(s.clients[0].options()) ?? JsonObject.new()
    }
    ro offered = approval_offered(options, value)
    // Persist the intent even on refusal: restarting must not silently restore broader defaults.
    s.chosen = chosen_put(s.chosen, family, "mode", value)
    accept_in(@settings.store == "pg", @settings.data_dir, s, Incoming.signal("setting_chosen", chosen_text(family, "mode", value, now_millis())))
    ro apply = work_mode_allows(@approval_policy, if offered { "offered" } else { "unknown" }, "apply")
    @sessions[at] = s
    // Preserve the existing explicit setting API for a cold current family. Never start an inactive family,
    // a session being created before its work mode is installed, or a backend forbidden by WorkModePolicy.
    if start_agent && family == s.agent && @work_allowed(at, "execute") {
        ro reason = @ensure_client(at)
        if reason.byte_len() > 0 { @approval_result(trace, family, true); return }
        s = @sessions[at]
    }
    if family == s.agent && s.clients.len() > 0 {
        // ACP validates current offers again and blocks its queue on an unknown id.
        if start_agent { s.approval_pending = family }
        s.clients[0].require_mode(value)
    }
    @sessions[at] = s
    @drain(at)
    if s.approval_pending != family { @approval_result(trace, family, !apply) }
}
