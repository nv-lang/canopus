module crew_harness.server

import std.text
import alula.engine.{Incoming}

fn delivery_count(lines []str, kind str) -> int {
    mut count = 0
    for line in lines { if line.contains("\"kind\":\"${kind}\"") { count += 1 } }
    count
}

test "260: receipt is scoped to the session, replayed after restart and never repeats the turn" {
    ro settings = kit_files("delivery260", 30000)
    mut r = rig_open(settings)
    r.attach(1)
    r.page(1, "session_created", "delivery-s", "{\"name\":\"delivery\",\"agent\":\"opencode\"}")
    r.page_id(1, "user_message", "delivery-s", "{\"text\":\"safe receipt test\"}", "delivery-id")
    assert(r.until("agent_done", 15000))
    ro lines = r.lines_for(1)
    assert(delivery_count(lines, "user_message") == 1)
    mut accepted = false
    for line in lines {
        if line.contains("\"kind\":\"message_delivery\"") && line.contains("\"accepted\":true") { accepted = true }
    }
    assert(accepted)
    r.page_id(1, "user_message", "delivery-s", "{\"text\":\"must not be sent twice\"}", "delivery-id")
    assert(delivery_count(r.lines_for(1), "user_message") == 1)
    r.shut()
    mut resumed = rig_open(settings)
    resumed.attach(2)
    assert(delivery_count(resumed.lines_for(2), "user_message") == 1)
    resumed.page_id(2, "user_message", "delivery-s", "{\"text\":\"reconnect replay\"}", "delivery-id")
    assert(delivery_count(resumed.lines_for(2), "user_message") == 1)
    // The same identity in another session is not an acknowledgement for that session.
    resumed.page(2, "session_created", "delivery-other", "{\"name\":\"other\",\"agent\":\"opencode\"}")
    resumed.page_id(2, "user_message", "delivery-other", "{\"text\":\"another session\"}", "delivery-id")
    assert(delivery_count(resumed.lines_for(2), "user_message") == 2)
    resumed.shut()
}

test "260: crash after durable intent cannot replay an uncertain side effect" {
    ro settings = kit_files("delivery260-crash", 30000)
    mut r = rig_open(settings)
    r.attach(1)
    r.page(1, "session_created", "pending-s", "{\"name\":\"pending\",\"agent\":\"opencode\"}")
    // Fault boundary: only the first durable receipt was committed; no user_message has yet been accepted.
    mut s = r.hub.sessions[0]
    accept_in(false, settings.data_dir, s, Incoming.signal("message_delivery", "{\"client_id\":\"uncertain-id\",\"accepted\":false,\"turn\":\"\"}"))
    r.shut()
    mut resumed = rig_open(settings)
    resumed.attach(2)
    resumed.page_id(2, "user_message", "pending-s", "{\"text\":\"do not guess after a crash\"}", "uncertain-id")
    assert(delivery_count(resumed.lines_for(2), "user_message") == 0)
    assert(delivery_count(resumed.lines_for(2), "message_delivery") >= 1)
    resumed.shut()
}

test "260: pre-turn launch refusal names the send, not a previous turn" {
    mut settings = kit_files("delivery260-refusal", 30000)
    settings.agents = [AgentSpec { id: "missing", label: "Missing test agent", program: "crew-harness-no-such-agent-260", args: []str.new(), ask: "native" }]
    mut r = rig_open(settings)
    r.attach(1)
    r.page(1, "session_created", "refused-s", "{\"name\":\"refused\",\"agent\":\"missing\"}")
    r.page_id(1, "user_message", "refused-s", "{\"text\":\"keep local text\"}", "refused-send")
    assert(delivery_count(r.lines_for(1), "user_message") == 0)
    mut linked = false
    mut falsely_accepted = false
    for line in r.lines_for(1) {
        if line.contains("\"kind\":\"error\"") && line.contains("\"client_id\":\"refused-send\"") { linked = true }
        if line.contains("\"accepted\":true") { falsely_accepted = true }
    }
    assert(linked)
    assert(!falsely_accepted)
    r.shut()
}
