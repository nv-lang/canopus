module crew_harness.server

import crew_harness.product_machines.{tree_text, product_registry}
import alula.machine.{NamedText}
import alula.machine_text.{translate_checked_with, error_text}

test "preparation: Alula table and runtime JSON enforce the same capabilities" {
    ro report = translate_checked_with(tree_text("machines/product/work-mode.alula.md"), product_registry(), []NamedText.new())
    for error in report.errors { panic(error_text(error, "work-mode.alula.md")) }
    assert(report.errors.len() == 0)
    ro table = match work_mode_machine(report.json, product_registry()) { Ok(m) => m, Err(e) => panic(e) }
    ro stored = match work_mode_machine(tree_text("machines/product/work-mode.alula.json"), product_registry()) { Ok(m) => m, Err(e) => panic(e) }
    for route in ["planning", "interactive", "fast", "full", "unknown"] {
        for op in ["execute", "tree", "repository", "draft", "recognize", "workspace", "unknown"] {
            assert(work_mode_allows(table, route, op) == work_mode_allows(stored, route, op))
        }
        for locked in [false, true] {
            for available in [false, true] {
                assert(workspace_allows(table, route, locked, available) == workspace_allows(stored, route, locked, available))
                assert(workspace_allows(stored, route, locked, available) == (!locked && available))
                assert(workspace_dispatch_allows(table, route, true, available, locked) == workspace_dispatch_allows(stored, route, true, available, locked))
            }
        }
    }
}

test "workspace: explicit pending or failed copy never dispatches, even with a late ready fact" {
    ro m = match work_mode_machine(tree_text("machines/product/work-mode.alula.json"), product_registry()) { Ok(m) => m, Err(e) => panic(e) }
    assert(!workspace_dispatch_allows(m, "planning", true, true, false))
    assert(!workspace_dispatch_allows(m, "interactive", true, false, false))
    assert(!workspace_dispatch_allows(m, "interactive", true, false, true))
    assert(!workspace_dispatch_allows(m, "interactive", true, true, true))
    assert(workspace_dispatch_allows(m, "interactive", true, true, false))
    assert(workspace_dispatch_allows(m, "interactive", false, false, false))
}

test "preparation: Alula denies execution and git lifecycle, but keeps discussion and statements" {
    ro m = match work_mode_machine(tree_text("machines/product/work-mode.alula.json"), product_registry()) {
        Ok(m) => m
        Err(e) => panic(e)
    }
    for route in ["planning", "", "unknown"] {
        for op in ["execute", "tree", "repository", "shell", "native_write"] { assert(!work_mode_allows(m, route, op)) }
        assert(work_mode_allows(m, route, "draft"))
        assert(work_mode_allows(m, route, "recognize"))
        assert(work_mode_allows(m, route, "workspace"))
    }
    for route in ["interactive", "fast", "full"] {
        for op in ["execute", "tree", "repository", "draft", "recognize"] { assert(work_mode_allows(m, route, op)) }
        assert(!work_mode_allows(m, route, "unknown"))
    }
}
