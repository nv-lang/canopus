module canopus.server

import canopus.acp.{AcpConfig}
import canopus.storage.{valid_session_name, ensure_session_dir}
import std.os.{Os, real_os}
import std.fs.{Fs, real_fs}
import canopus.config.{load_presets, preset_named, preset_pick, install_paths}
import std.encoding.json.{JsonValue, JsonObject}

// Removed public controls remain named code policy, ready for explicit future exposure.
const PREPARATION_SERVICE_REGISTRATION = ""
const PREPARATION_DEFAULT_MODEL = ""
const PREPARATION_DEFAULT_VARIANT = ""
const PREPARATION_ADAPTER_FILE = "preparation-agent.mjs"

// Trusted host/test DI only; no browser, model response or ACP method can set it.
type PreparationFixture { session str, registration str, model str, variant str, adapter str }

export fn preparation_same_launch(a AcpConfig, b AcpConfig) -> bool {
    if a.program != b.program || a.cwd != b.cwd || a.args.len() != b.args.len() { return false }
    mut i = 0
    while i < a.args.len() {
        if a.args[i] != b.args[i] { return false }
        i += 1
    }
    true
}

export fn preparation_choice_allowed(offered JsonObject, setting str, value str) -> bool {
    if (setting != "model" && setting != "effort") || value.byte_len() == 0 { return false }
    ro key = if setting == "model" { "models" } else { "efforts" }
    for item in jlist(offered, key) {
        match item.object() { Some(o) => { if jtext(o, "id") == value { return true } }, None => () }
    }
    false
}

export fn preparation_launch(registration str, model str, variant str, adapter str, data str, session str) -> Result[AcpConfig, str] {
    if !valid_session_name(session) { return Err("Подготовка: недопустимая сессия") }
    if model.byte_len() == 0 || adapter.byte_len() == 0 {
        return Err("Подготовка задачи недоступна: ограниченный backend не подключён (нужны выбранная модель и транспорт); обычный ACP запрещён")
    }
    ro slash = model.find("/") ?? -1
    if slash <= 0 || slash == model.byte_len() - 1 { return Err("Подготовка: модель задаётся как provider/model") }
    mut arguments = [adapter, "--model", model, "--variant", variant, "--root", "${data}/${session}/tasks/draft"]
    if registration.byte_len() > 0 { arguments.push("--service-registration"); arguments.push(registration) }
    Ok(AcpConfig { program: "node", args: arguments, cwd: "${data}/${session}", inbox_path: "" })
}

fn Hub @preparation_config(mut s Dialog) -> Result[AcpConfig, str] {
    if s.agent != "codex" && s.agent != "opencode" && s.agent != "kimi" { return Err("Подготовка: для выбранной семьи не подключён ограниченный backend; обычный ACP запрещён") }
    // Exact-session trusted injection returns before production preset and installation discovery.
    for fixture in @preparation_fixtures {
        if fixture.session == s.id {
            if fixture.registration.byte_len() == 0 || !path_there(fixture.adapter) {
                return Err("Подготовка: неполная изолированная конфигурация")
            }
            return @preparation_config_at(s, fixture.registration, fixture.model, fixture.variant, fixture.adapter)
        }
    }
    ro registration = PREPARATION_SERVICE_REGISTRATION
    mut model = PREPARATION_DEFAULT_MODEL
    mut variant = PREPARATION_DEFAULT_VARIANT
    for pick in presets_for(s.chosen, s.agent) {
        if pick.setting == "model" { model = pick.value }
        if pick.setting == "effort" { variant = pick.value }
    }
    // Direct source selection is separate from the old per-family native presets.
    // Read only host journal metadata, never conversation text or model-proposed paths.
    for event in history_in(@settings.store == "pg", @settings.data_dir, s) {
        if event.name == "session_source" || event.name == "agent_selection" || event.name == "agent_selected" {
            match jobject(event.input) {
                Some(source) => if jtext(source, "family") == s.agent && jtext(source, "model").byte_len() > 0 { model = jtext(source, "model"); variant = jtext(source, "effort") }
                None => ()
            }
        }
        if event.name == "setting_chosen" {
            match jobject(event.input) {
                Some(choice) => if jtext(choice, "agent") == s.agent {
                    if jtext(choice, "setting") == "model" { model = jtext(choice, "value") }
                    if jtext(choice, "setting") == "effort" { variant = jtext(choice, "value") }
                }
                None => ()
            }
        }
    }
    if model.byte_len() == 0 {
        // D454: boundary override inside non-test code, see module-conventions
        match with Fs = real_fs() { load_presets(@settings.layout, @settings.route_reviewer_order) } {
            Ok(list) => match preset_named(list, @preset_name_of(s)) {
                Some(preset) => match preset_pick(preset, "dev") {
                    Some(pick) => {
                        if pick.family == s.agent { model = pick.model; variant = pick.effort }
                    }
                    None => ()
                }
                None => ()
            }
            Err(reason) => ()
        }
    }
    // D454: existing Hub adapter boundary; installation discovery inherits these handlers.
    ro installed = with Os = real_os() { with Fs = real_fs() { install_paths() } }
    ro local = "${installed.root}/src/server/${PREPARATION_ADAPTER_FILE}"
    ro packaged = "${installed.bin}/${PREPARATION_ADAPTER_FILE}"
    ro adapter = if path_there(local) { local } else { packaged }
    if !path_there(adapter) { return Err("Подготовка задачи недоступна: встроенный адаптер не найден; обычный ACP запрещён") }
    @preparation_config_at(s, registration, model, variant, adapter)
}

fn Hub @preparation_config_at(s Dialog, registration str, model str, variant str, adapter str) -> Result[AcpConfig, str] {
    mut config = if s.agent == "kimi" {
        ro native = match @settings.agent("kimi") { Some(agent) => agent, None => return Err("Подготовка: Kimi не настроен") }
        preparation_kimi_launch(native.program, native.args, model, variant, tk_canon(adapter), tk_canon(@settings.data_dir), s.id)?
    } else { preparation_launch(registration, model, variant, tk_canon(adapter), tk_canon(@settings.data_dir), s.id)? }
    // D454: boundary override inside non-test code, see module-conventions
    ro made = with Fs = real_fs() { ensure_session_dir(@settings.data_dir, s.id) }
    if !made {
        return Err("Подготовка: session-owned каталог недоступен")
    }
    config.args.push("--context")
    config.args.push(if s.project_id.byte_len() > 0 { "Проект: ${s.project_id}; каталог: ${s.folder}. Только контекст постановки, не рабочая копия." } else { "Без проекта. Контекст, история и постановка принадлежат этой сессии." })
    Ok(config)
}

export fn preparation_kimi_launch(program str, native_args []str, model str, variant str, adapter str, data str, session str) -> Result[AcpConfig, str] {
    if !valid_session_name(session) || program.byte_len() == 0 || model.byte_len() == 0 || adapter.byte_len() == 0 { return Err("Подготовка Kimi: неполный назначенный источник") }
    if native_args.len() == 0 || native_args[native_args.len() - 1] != "acp" { return Err("Подготовка Kimi: нужен настроенный нативный ACP; обычный агент запрещён") }
    mut encoded = []JsonValue.new()
    for arg in native_args { encoded.push(JsonValue.str(arg)) }
    ro arguments = [adapter, "--backend", "kimi", "--native-program", program, "--native-args", JsonValue.array(encoded).to_str(), "--model", model, "--variant", variant, "--root", "${data}/${session}/tasks/draft"]
    Ok(AcpConfig { program: "node", args: arguments, cwd: "${data}/${session}", inbox_path: "" })
}
