// ext_kit.nv - owner-confirmed additions (task 313), with a fake ACP agent in a repository.
// The helpers are in `child_kit.nv`, `routes_kit.nv`, `canopus_task_kit.nv`.
module canopus.server

import std.encoding.json.{Json, JsonValue, JsonObject}

// An item of `canopus_task` / `canopus_task_list` with the confidence the agent states.
fn ek_item(kind str, title str, extends int, confidence str) -> JsonValue {
    mut o = rk_item(kind, title, extends, []str.new()).object() ?? JsonObject.new()
    if confidence.byte_len() > 0 { jput(o, "confidence", JsonValue.str(confidence)) }
    JsonValue.object(o)
}

// The additions of the session `trace` as the page sees them: `extensions` of its last state.
fn ek_exts(rig Rig, trace str) -> []JsonValue => rk_array(ck_state(rig, 1, trace), "extensions")

fn ek_undone(rig Rig, trace str, at int) -> bool {
    ro list = ek_exts(rig, trace)
    if at >= list.len() { return false }
    ro o = list[at].object() ?? JsonObject.new()
    (o.get("undone") ?? JsonValue.null()).bool() ?? false
}

// The text of the hidden service notes the hub gave to the agent of the session (the panel "Машины").
fn ek_hints(rig Rig, trace str) -> str {
    mut out = []str.new()
    for h in rk_array(ck_state(rig, 1, trace), "hints") {
        out.push(jtext(h.object() ?? JsonObject.new(), "text"))
    }
    joined(out, "\n")
}

// The agent of the talk calls `canopus_task` once: the turn of the fake agent ends.
fn ek_say(mut rig Rig, session str, turn str, item JsonValue) Proc Detach Time -> bool {
    rig.run(1500)
    rig.page(1, "user_message", session, rk_tasktool_page(turn, item))
    ro done = rig.until(KIT_DONE, 20000)
    rig.run(500)
    done
}

/// Every addition waits for the owner: approval writes the requirement, refusal leaves the assignment unchanged.
export fn scenario_route_auto_extend(settings ServerSettings) Proc Detach Time Net Fs Os -> str {
    mut c = kit_check()
    mut rig = rig_open(settings)
    rig.attach(1)
    rk_project_page(rig, 1, "s-e1", "{\"name\":\"Беседа\",\"agent\":\"opencode\"}")
    c.expect(rig.until("\"kind\":\"session_created\"", 5000), "the session of the talk is shown")
    c.expect(ck_list(rig, "s-e1", "t1", [ck_item("new", "Исходная работа", 0, 0, ["a.txt"])], "Исходная работа"), "the list is shown")
    ck_apply(rig, "s-e1", [["Исходная работа", "work", "new", "0"]])
    rig.run(4000)
    ro p1 = ck_find(rig, 1, "Исходная работа")
    c.expect(p1 != "", "the task is a session of its own: ${p1}")
    c.expect(ck_idle(rig, p1, 60000), "its agent finishes the first turn")
    ro file = "${ck_dir(rig, p1)}/message.md"
    c.expect(!rk_text(file).contains("## Дополнение"), "message.md has no addition yet")

    // A high confidence is a proposal, never permission to write or wake the worker.
    ro before = rk_text(file)
    ro hints = ek_hints(rig, p1)
    c.expect(ek_say(rig, "s-e1", "t2", ek_item("extend", "Ещё одно требование", 1, "high")), "the agent proposes an addition")
    c.expect(rk_card_state(ck_state(rig, 1, "s-e1"), "Ещё одно требование") == "open", "high confidence still shows a card")
    c.expect(rk_text(file) == before, "no text is written before approval")
    c.expect(ek_exts(rig, "s-e1").len() == 0, "no automatic extension record")
    c.expect(ek_hints(rig, p1) == hints, "the worker receives no new requirement before approval")

    // Explicit owner approval applies the proposed text through the existing card path.
    ck_apply(rig, "s-e1", [["Ещё одно требование", "work", "extend", "1"]])
    rig.run(1500)
    c.expect(rk_text(file).contains("Ещё одно требование"), "owner approval appends the requirement")
    c.expect(ck_idle(rig, p1, 60000), "the worker finishes the approved service turn")
    c.expect(ek_hints(rig, p1) != hints, "owner approval delivers a service note to the worker")
    c.expect(rk_card_id(ck_state(rig, 1, "s-e1"), "Ещё одно требование") == 0, "approved card is removed")

    // A refusal leaves the assignment and the worker unchanged.
    ro approved = rk_text(file)
    ro approved_hints = ek_hints(rig, p1)
    c.expect(ek_say(rig, "s-e1", "t3", ek_item("extend", "Отклонённое требование", 1, "high")), "another high proposal")
    ck_apply(rig, "s-e1", [["Отклонённое требование", "forget", "extend", "1"]])
    rig.run(500)
    c.expect(rk_text(file) == approved && ek_hints(rig, p1) == approved_hints, "refusal neither writes nor delivers a requirement")

    // 3. a lower confidence: a card
    c.expect(ek_say(rig, "s-e1", "t4", ek_item("extend", "Средняя уверенность", 1, "medium")), "a medium confidence")
    c.expect(rk_card_state(ck_state(rig, 1, "s-e1"), "Средняя уверенность") == "open", "it is a card with the buttons")
    c.expect(!rk_text(file).contains("Средняя уверенность"), "message.md is not touched")
    // the confidence is not stated at all
    c.expect(ek_say(rig, "s-e1", "t5", ek_item("extend", "Без уверенности", 1, "")), "no confidence")
    c.expect(rk_card_state(ck_state(rig, 1, "s-e1"), "Без уверенности") == "open" && !rk_text(file).contains("Без уверенности"), "it is a card too")

    // 4. a task that is not there: a card of a new task (nothing is made by itself)
    c.expect(ek_say(rig, "s-e1", "t6", ek_item("extend", "К несуществующей", 77, "high")), "an addition to a task that is not there")
    c.expect(rk_card_state(ck_state(rig, 1, "s-e1"), "К несуществующей") == "open", "it is a card")

    // 5. a new task with a high confidence: a card, no session, no folder
    c.expect(ek_say(rig, "s-e1", "t7", ek_item("new", "Новая работа автоматом", 0, "high")), "a new task with a high confidence")
    c.expect(rk_card_state(ck_state(rig, 1, "s-e1"), "Новая работа автоматом") == "open", "it is a card")
    c.expect(ck_find(rig, 1, "Новая работа автоматом") == "", "no session was made by itself")
    c.expect(ek_exts(rig, "s-e1").len() == 0, "no automatic additions are in the list")

    // The list of the agent: both additions and new tasks wait for approval.
    c.expect(ck_list(rig, "s-e1", "t8", [ek_item("extend", "Из списка дополнение", 1, "high"), ek_item("new", "Из списка новая", 0, "high")], "Из списка новая"), "the list is shown")
    c.expect(!rk_text(file).contains("Из списка дополнение"), "a listed high extension waits for approval")
    c.expect(rk_card_state(ck_state(rig, 1, "s-e1"), "Из списка дополнение") == "open", "the extension has an approval row")
    c.expect(rk_card_state(ck_state(rig, 1, "s-e1"), "Из списка новая") == "open", "the new work of the list is a row")
    c.expect(ek_say(rig, p1, "own-high", ek_item("extend", "Дополнение своей сессии", 1, "high")), "the worker proposes an addition to its own assignment")
    c.expect(!rk_text(file).contains("Дополнение своей сессии"), "own-session proposal does not change the assignment")
    c.expect(rk_card_state(ck_state(rig, 1, p1), "Дополнение своей сессии") == "open", "own-session addition waits on a card too")

    rig.shut()
    c.report()
}

/// The scope of the tasks (task 192.13, the owner 2026-10-29): the tasks of ANOTHER session of the project are neither listed to the agent, nor offered, nor extended; the tasks made from the talk of the session are its own.
export fn scenario_route_scope(settings ServerSettings) Proc Detach Time Net Fs Os -> str {
    mut c = kit_check()
    mut rig = rig_open(settings)
    rig.attach(1)
    rk_project_page(rig, 1, "s-a", "{\"name\":\"Беседа А\",\"agent\":\"opencode\"}")
    rk_project_page(rig, 1, "s-b", "{\"name\":\"Беседа Б\",\"agent\":\"opencode\"}")
    c.expect(rig.until("\"kind\":\"session_created\"", 5000), "the two sessions are shown")
    c.expect(ck_list(rig, "s-a", "t1", [ck_item("new", "Работа первой беседы", 0, 0, ["a.txt"])], "Работа первой беседы"), "the list of the first talk is shown")
    ck_apply(rig, "s-a", [["Работа первой беседы", "work", "new", "0"]])
    rig.run(4000)
    ro p1 = ck_find(rig, 1, "Работа первой беседы")
    c.expect(p1 != "", "the task of the first talk is a session of its own: ${p1}")
    c.expect(ck_idle(rig, p1, 60000), "its agent finishes the first turn")
    ro file = "${ck_dir(rig, p1)}/message.md"

    // the first talk sees its own task among the targets of the card, the second one does not
    c.expect(rk_array(ck_state(rig, 1, "s-a"), "targets").len() == 1, "the first talk has its own task as a target")
    c.expect(rk_array(ck_state(rig, 1, "s-b"), "targets").len() == 0, "the second talk has no targets: the task is of another session")

    // an addition from the second talk, even with a high confidence, is a card and does not touch the task of the first one
    c.expect(ek_say(rig, "s-b", "t2", ek_item("extend", "Чужое дополнение", 1, "high")), "the second talk says: an addition to the task 1")
    c.expect(!rk_text(file).contains("Чужое дополнение"), "message.md of the other session is not touched")
    c.expect(rk_card_state(ck_state(rig, 1, "s-b"), "Чужое дополнение") == "open", "it is a card of a new task")
    // the owner forces the way on the card: refused
    ro id = rk_card_id(ck_state(rig, 1, "s-b"), "Чужое дополнение")
    rig.page(1, "route_prop", "s-b", "{\"id\":${id},\"action\":\"start\",\"mode\":\"extend\",\"target\":1}")
    rig.run(800)
    c.expect(!rk_text(file).contains("Чужое дополнение"), "the forced addition is refused")
    c.expect(ck_find(rig, 1, "Чужое дополнение") == "", "and no session is made")

    // The first talk: even its own related task needs approval.
    c.expect(ek_say(rig, "s-a", "t3", ek_item("extend", "Своё дополнение", 1, "high")), "the first talk adds to its own task")
    c.expect(!rk_text(file).contains("Своё дополнение"), "even a related task requires approval")
    c.expect(rk_card_state(ck_state(rig, 1, "s-a"), "Своё дополнение") == "open", "own extension has a card")
    rig.shut()
    c.report()
}
