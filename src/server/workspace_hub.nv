// Workspace preferences never perform Git mutations. Lifecycle authorization is the Alula WorkModePolicy.
module canopus.server

import std.encoding.json.{Json, JsonValue, JsonObject}

// Shared by prompt dispatch and every cold/ready client path (including other UI settings).
fn Hub @workspace_agent_ready(at int) -> bool {
    ro s = @sessions[at]
    ro required = s.project_id.byte_len() > 0 && s.rt.use_tree && wip_explicit(s.rt) && s.rt.worktree.byte_len() == 0 && s.rt.result_repo.byte_len() == 0
    workspace_dispatch_allows(@work_mode, s.rt.route, required, s.rt.wip_tree.byte_len() > 0, s.rt.workspace_failed)
}

fn workspace_problem(project str, folder str, source str, tree bool) Proc -> str {
    if project.byte_len() == 0 || folder.byte_len() == 0 {
        return if tree || source.byte_len() > 0 { "без проекта нельзя выбрать исходную ветку или отдельную Git-папку" } else { "" }
    }
    if !tk_is_repo(folder) {
        return if tree || source.byte_len() > 0 { "в папке проекта нет Git: исходная ветка и отдельная Git-папка недоступны" } else { "" }
    }
    if source.byte_len() > 0 { return tk_workspace_source(folder, source) }
    ""
}

fn Hub mut @workspace_set(trace str, input JsonObject) Proc Detach Time -> () {
    ro at = @find(trace)
    if at < 0 || !@work_require(at, "workspace") { return }
    ro s = @sessions[at]
    ro locked = (s.rt.task_open && s.rt.task_id != "draft") || s.rt.wip_tree.byte_len() > 0 || s.rt.worktree.byte_len() > 0 || (s.rt.wip_prep != 0 && !s.rt.workspace_failed) || wip_had_message(s.lines) || s.rt.result_repo.byte_len() > 0
    ro available = s.project_id.byte_len() > 0 && s.folder.byte_len() > 0 && tk_is_repo(s.folder)
    if !workspace_allows(@work_mode, s.rt.route, locked, available) {
        @tell_error(0, trace, s.engine.step_number(), "", if available { "исполнение уже началось: исходная ветка и рабочая папка закреплены" } else { "выбор исходной ветки и Git-папки доступен только в проекте с Git" })
        return
    }
    ro source = jtext(input, "source_branch")
    ro tree = jflag(input, "worktree")
    ro problem = workspace_problem(s.project_id, s.folder, source, tree)
    if problem.byte_len() > 0 { @tell_error(0, trace, s.engine.step_number(), "", problem); return }
    mut o = JsonObject.new()
    js(o, "source_branch", source)
    jput(o, "worktree", JsonValue.bool(tree))
    jput(o, "workspace_explicit", JsonValue.bool(true))
    jput(o, "workspace_failed", JsonValue.bool(false))
    @rt_journal(at, "route_set", JsonValue.object(o).to_str())
    if s.rt.workspace_failed {
        mut retry = @sessions[at]
        retry.rt.wip_prep = 0
        @sessions[at] = retry
    }
    if !@workspace_agent_ready(at) && @work_allowed(at, "execute") { ro pending = @ensure_client(at) }
    @route_broadcast(at, true)
}
