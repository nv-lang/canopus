// Integration scenario using the existing real ACP process fixture (task 269).
module canopus.server

// ORACLE-WORKAROUND(32): std.fs imported first in the first file of the unit, or .join on []str resolves into Path (last-wins) — the item-32 family returned on the 0.1.2 toolchain
import std.fs
import canopus.config.{layout_with_data_dir}
import alula.engine.{EventKind}
import std.fs
import std.encoding.json.{JsonObject}

// The shared kit_ask gathers chunks by turn id across every session. This scenario
// restarts a multi-session hub, so scope evidence to the actual session as well.
fn source_ask(mut rig Rig, trace str, text str) Proc Detach Time Net Fs Os -> str {
    ro ignored = kit_ask(rig, trace, text)
    mut own = []str.new()
    for line in rig.lines_for(1) {
        if line_field(line, "trace") == trace { own.push(line) }
    }
    answer_of(own, line_input(kit_last_of(own, "user_message"), "turn"))
}

export fn scenario_agent_source(settings ServerSettings) Proc Detach Time Net Fs Os -> str {
    mut c = kit_check()
    ro written = write_file("${settings.data_dir}/inst/presets/pool269.json", "{\"roles\":{},\"pools\":{\"mix\":{\"heavy\":[{\"family\":\"opencode\",\"model\":\"fake-model-b\",\"effort\":\"high\"}],\"light\":[]}}}")
    mut configured = ServerSettings { ...settings }
    configured.layout = layout_with_data_dir("${settings.data_dir}/inst", settings.data_dir, "")
    mut rig = rig_open(configured)
    rig.attach(1)
    rig.page(1, "session_created", "s-source", "{\"name\":\"Источник\",\"agent\":\"opencode\"}")
    rig.page(1, "session_source", "s-source", "{\"family\":\"opencode\",\"model\":\"fake-model-b\",\"effort\":\"high\"}")
    c.expect(kit_ask(rig, "s-source", "mode") == "mode: default model: fake-model-b effort: high", "prompt waits for the exact source to be confirmed")
    c.expect(kit_with(rig.hub.page_lines("s-source"), "\"kind\":\"agent_selected\"") > 0, "actual choice is visible in history")
    ro first_turn = line_input(kit_last_of(rig.hub.page_lines("s-source"), "user_message"), "turn")
    ro first_actual = kit_last_of(rig.hub.page_lines("s-source"), "agent_actual")
    c.expect(line_input(first_actual, "turn") == first_turn && line_input(first_actual, "turn_id") == first_turn, "actual snapshot uses the response turn key")
    c.expect(line_input(first_actual, "family") == "opencode" && line_input(first_actual, "model") == "fake-model-b" && line_input(first_actual, "effort") == "high", "actual snapshot uses confirmed native settings: ${first_actual}")
    c.expect(kit_ask(rig, "s-source", "mode") == "mode: default model: fake-model-b effort: high", "unchanged second dispatch still executes the pinned model")
    ro second_turn = line_input(kit_last_of(rig.hub.page_lines("s-source"), "user_message"), "turn")
    ro second_actual = kit_last_of(rig.hub.page_lines("s-source"), "agent_actual")
    c.expect(first_turn != second_turn && line_input(second_actual, "turn") == second_turn, "every unchanged dispatch has its own actual snapshot")
    c.expect(line_input(first_actual, "dispatch_id") != line_input(second_actual, "dispatch_id"), "dispatch audit identities are not reused")
    c.expect(kit_with(rig.hub.page_lines("s-source"), "\"kind\":\"agent_actual\"") == 2, "exactly one actual snapshot per dispatched turn")
    rig.page(1, "session_preset", "s-source", "{\"preset\":\"pool269\"}")
    c.expect(rig.until("\"kind\":\"session_preset\"", 5000), "the pool preset is actually loaded from the fixture layout")
    rig.page(1, "session_source", "s-source", "{\"pool\":\"mix\",\"level\":\"heavy\"}")
    c.expect(rig.until("\"pool\":\"mix\"", 5000), "the pool source itself is accepted, not the previous direct source")
    c.expect(kit_ask(rig, "s-source", "mode") == "mode: default model: fake-model-b effort: high", "pool resolves an actual catalog model without translating level to effort")
    ro with_alternative = write_file("${settings.data_dir}/inst/presets/pool269.json", "{\"roles\":{},\"pools\":{\"mix\":{\"heavy\":[{\"family\":\"opencode\",\"model\":\"fake-model\",\"effort\":\"medium\"},{\"family\":\"opencode\",\"model\":\"fake-model-b\",\"effort\":\"high\"}],\"light\":[]}}}")
    c.expect(kit_ask(rig, "s-source", "mode") == "mode: default model: fake-model-b effort: high", "adding an alternative does not reselect a pinned model")
    ro disabled = write_file("${settings.data_dir}/inst/presets/pool269.json", "{\"roles\":{},\"pools\":{\"mix\":{\"heavy\":[{\"family\":\"opencode\",\"model\":\"fake-model\",\"effort\":\"medium\"},{\"family\":\"opencode\",\"model\":\"fake-model-b\",\"effort\":\"high\",\"active\":false}],\"light\":[]}}}")
    c.expect(kit_ask(rig, "s-source", "mode") == "mode: default model: fake-model effort: medium", "disabling the pinned model changes model and effort inside the family before prompt")
    rig.page(1, "session_created", "s-warm", "{\"name\":\"Каталог второй семьи\",\"agent\":\"second\"}")
    c.expect(kit_ask(rig, "s-warm", "mode").byte_len() > 0, "second family's actual catalog is available")
    ro cross_family = write_file("${settings.data_dir}/inst/presets/pool269.json", "{\"roles\":{},\"pools\":{\"mix\":{\"heavy\":[{\"family\":\"second\",\"model\":\"fake-model\",\"effort\":\"medium\"}],\"light\":[]}}}")
    ro history_before = rig.hub.page_lines("s-source")
    rig.forget()
    rig.page(1, "user_message", "s-source", "{\"text\":\"cross-family must not run\"}")
    c.expect(rig.until("Смена семьи источника остановлена", 5000), "unsafe context transfer is explicitly refused")
    c.expect(kit_text(rig.hub.page_lines("s-source")) == kit_text(history_before), "refusal does not lose history or add a user turn")
    c.expect(kit_with(rig.lines_for(1), "Echo: cross-family must not run") == 0, "refusal executes no duplicate or replacement prompt")
    rig.page(1, "session_created", "s-first", "{\"name\":\"До первого хода\",\"agent\":\"opencode\",\"source\":{\"family\":\"second\",\"model\":\"fake-model-b\",\"effort\":\"high\"}}")
    c.expect(kit_ask(rig, "s-first", "mode") == "mode: default model: fake-model-b effort: high", "family may change before the first turn when there is no context to transfer")
    rig.page(1, "session_source", "s-source", "{\"pool\":\"mix\",\"level\":\"light\"}")
    rig.forget()
    rig.page(1, "user_message", "s-source", "{\"text\":\"empty pool\"}")
    c.expect(rig.until("no active available models", 5000), "empty level refuses the turn")
    c.expect(kit_with(rig.lines_for(1), "Echo: empty pool") == 0, "empty pool does not fall back")
    rig.page(1, "session_source", "s-source", "{\"family\":\"opencode\",\"model\":\"fake-model-b\",\"effort\":\"high\"}")
    rig.shut()
    mut again = rig_open(configured)
    again.attach(1)
    c.expect(kit_ask(again, "s-source", "mode") == "mode: default model: fake-model-b effort: high", "source survives restart")
    again.page(1, "session_source", "s-source", "{\"family\":\"opencode\",\"model\":\"missing-model\",\"effort\":\"high\"}")
    again.forget()
    again.page(1, "user_message", "s-source", "{\"text\":\"must not use a fallback\"}")
    c.expect(again.until("agent source not offered", 10000), "unavailable direct model is refused instead of replaced")
    c.expect(kit_with(again.lines_for(1), "Echo: must not use a fallback") == 0, "no fallback prompt reaches the agent")
    ro weighted = write_file("${settings.data_dir}/inst/presets/weighted269.json", "{\"roles\":{\"dev\":{\"default\":{\"family\":\"opencode\",\"model\":\"fake-model\",\"effort\":\"medium\"},\"by_weight\":{\"heavy\":{\"family\":\"opencode\",\"model\":\"fake-model-b\",\"effort\":\"high\"}}},\"dev_accept\":{\"family\":\"second\",\"model\":\"fake-model-b\",\"effort\":\"high\"}}}")
    again.page(1, "session_created", "s-weight", "{\"name\":\"Вес\",\"agent\":\"opencode\",\"preset\":\"weighted269\"}")
    ro default_answer = source_ask(again, "s-weight", "mode")
    c.expect(default_answer == "mode: default model: fake-model effort: medium", "missing weight uses role default (actual: ${default_answer})")
    again.page(1, "session_preset", "s-weight", "{\"preset\":\"weighted269\",\"weight\":\"heavy\"}")
    c.expect(source_ask(again, "s-weight", "mode") == "mode: default model: fake-model-b effort: high", "explicit weight override reaches confirmed ACP dispatch")
    again.forget()
    again.page(1, "session_preset", "s-weight", "{\"preset\":\"weighted269\",\"weight\":\"unknown\"}")
    c.expect(again.until("Неизвестный вес", 5000), "unknown task weight is refused")
    again.forget()
    again.page(1, "session_preset", "s-weight", "{\"preset\":\"weighted269\",\"role\":\"unknown\"}")
    c.expect(again.until("Неизвестная роль", 5000), "unknown role is refused")
    again.forget()
    again.page(1, "session_preset", "s-weight", "{\"preset\":\"weighted269\",\"role\":\"dev_accept\"}")
    c.expect(again.until("Независимую роль", 5000), "user assignment cannot launch an independent reviewer")
    c.expect(source_ask(again, "s-weight", "mode") == "mode: default model: fake-model-b effort: high", "invalid assignments do not change pinned executor")
    ro review_at = again.hub.find("s-weight")
    again.hub.route_start_review(review_at, 0, RouteStep { id: "check", kind: "independent", title: "Проверка", required: true, prompt: "review" })
    again.run(3000)
    mut reviewed = again.hub.sessions[review_at]
    mut confirmed_review = false
    mut review_details = "no review_selected"
    for event in history_in(configured.store == "pg", configured.data_dir, reviewed) {
        if event.kind == EventKind.Input && event.name == "review_selected" {
            ro choice = jobject(event.input) ?? JsonObject.new()
            review_details = event.input
            confirmed_review = jtext(choice, "family") == "second" && jtext(choice, "model") == "fake-model-b" && jtext(choice, "effort") == "high"
        }
    }
    c.expect(confirmed_review, "independent reviewer confirms its own exact model and effort before dispatch (${review_details})")
    ro pool_review = write_file("${settings.data_dir}/inst/presets/reviewpool269.json", "{\"roles\":{\"dev_accept\":{\"pool\":\"review\",\"level\":\"light\"}},\"pools\":{\"review\":{\"light\":[{\"family\":\"opencode\",\"model\":\"fake-model-b\",\"effort\":\"high\"},{\"family\":\"second\",\"model\":\"fake-model\",\"effort\":\"medium\"}]}}}")
    again.page(1, "session_preset", "s-weight", "{\"preset\":\"reviewpool269\",\"weight\":\"heavy\"}")
    again.hub.route_start_review(review_at, 0, RouteStep { id: "check", kind: "independent", title: "Проверка", required: true, prompt: "review" })
    again.run(3000)
    reviewed = again.hub.sessions[review_at]
    mut pool_confirmed = false
    for event in history_in(configured.store == "pg", configured.data_dir, reviewed) {
        if event.kind == EventKind.Input && event.name == "review_selected" {
            ro choice = jobject(event.input) ?? JsonObject.new()
            if jtext(choice, "pool") == "review" { pool_confirmed = jtext(choice, "family") == "second" && jtext(choice, "model") == "fake-model" && jtext(choice, "effort") == "medium" && jtext(choice, "level") == "light" }
        }
    }
    c.expect(pool_confirmed, "review pool excludes actual author family and does not translate heavy task weight to pool level")
    ro same_family = write_file("${settings.data_dir}/inst/presets/same269.json", "{\"roles\":{\"dev_accept\":{\"family\":\"opencode\",\"model\":\"fake-model-b\",\"effort\":\"high\"}}}")
    again.page(1, "session_preset", "s-weight", "{\"preset\":\"same269\"}")
    again.forget()
    again.hub.route_start_review(review_at, 0, RouteStep { id: "check", kind: "independent", title: "Проверка", required: true, prompt: "must not dispatch" })
    c.expect(again.until("не независим", 3000), "reviewer matching the actual executor family is refused before dispatch")
    c.expect(again.hub.reviews.len() == 0, "same-family review has no running ACP dispatch")
    ro empty_review = write_file("${settings.data_dir}/inst/presets/emptyreview269.json", "{\"roles\":{\"dev_accept\":{\"pool\":\"only-author\",\"level\":\"heavy\"}},\"pools\":{\"only-author\":{\"heavy\":[{\"family\":\"opencode\",\"model\":\"fake-model\",\"effort\":\"medium\"}]}}}")
    again.page(1, "session_preset", "s-weight", "{\"preset\":\"emptyreview269\"}")
    again.forget()
    again.hub.route_start_review(review_at, 0, RouteStep { id: "check", kind: "independent", title: "Проверка", required: true, prompt: "must not dispatch" })
    c.expect(again.until("no active available models", 3000), "review pool without an available independent family refuses without fallback")
    c.expect(again.hub.reviews.len() == 0, "empty independent pool has no ACP dispatch")
    again.shut()
    mut rejecting_settings = ServerSettings { ...configured }
    mut rejecting_agents = []AgentSpec.new()
    for spec in configured.agents {
        if spec.id == "second" {
            mut rejecting = kit_agent("second", "--reject-effort-set", "")
            rejecting.args.push("--prompt-marker=${settings.data_dir}/forbidden-review-prompt")
            rejecting_agents.push(rejecting)
        } else { rejecting_agents.push(spec) }
    }
    rejecting_settings.agents = rejecting_agents
    mut rejected = rig_open(rejecting_settings)
    rejected.attach(1)
    rejected.page(1, "session_preset", "s-weight", "{\"preset\":\"weighted269\",\"weight\":\"heavy\"}")
    rejected.forget()
    rejected.hub.route_start_review(rejected.hub.find("s-weight"), 0, RouteStep { id: "check", kind: "independent", title: "Проверка", required: true, prompt: "must not dispatch after partial set" })
    c.expect(rejected.until("проверяющий не запустился", 8000), "one rejected ACP set fails the independent review")
    c.expect(read_file("${settings.data_dir}/forbidden-review-prompt").is_none(), "partial model confirmation followed by effort refusal dispatches no reviewer prompt")
    rejected.shut()
    c.report()
}

export fn scenario_context_handoff(settings ServerSettings) Proc Detach Time Net Fs Os -> str {
    mut configured = ServerSettings { ...settings }
    configured.agents.push(kit_agent("kimi", "--handoff-summary", ""))
    configured.agents.push(kit_agent("codex", "--handoff-overflow", ""))
    mut rig = rig_open(configured)
    mut c = kit_check()
    rig.attach(1)
    rig.page(1, "session_created", "s-handoff", "{\"name\":\"Handoff\",\"agent\":\"kimi\"}")
    c.expect(kit_ask(rig, "s-handoff", "first fact").byte_len() > 0, "the original Kimi turn completed")
    rig.forget()
    rig.page(1, "session_context_handoff", "s-handoff", "{\"family\":\"codex\",\"model\":\"missing-model\"}")
    c.expect(rig.until("Kimi остаётся активным", 15000), "a refused model keeps Kimi active")
    c.expect(kit_with(rig.lines_for(1), "\"kind\":\"agent_switched\"") == 0, "failed handoff did not switch the family")
    rig.forget()
    rig.page(1, "session_context_handoff", "s-handoff", "{\"family\":\"codex\",\"model\":\"fake-model-b\",\"effort\":\"high\"}")
    c.expect(rig.until("\"kind\":\"agent_switched\"", 15000), "the same chat switched after successful handoff")
    c.expect(kit_ask(rig, "s-handoff", "mode") == "mode: default model: fake-model-b effort: high", "the next turn uses the chosen Codex source")
    rig.forget()
    rig.page(1, "user_message", "s-handoff", rk_tasklist_page("handoff-tools", []JsonValue.new()))
    c.expect(rig.until(KIT_DONE, 20000), "the task list request completed")
    ro lines = rig.lines_for(1)
    ro turn = line_input(kit_last_of(lines, "user_message"), "turn")
    ro tools = answer_of(lines, turn)
    c.expect(tools.contains("canopus_task_list") && tools.contains("Список показан владельцу"), "the promoted Codex client can call Canopus tools")
    rig.shut()
    c.report()
}
