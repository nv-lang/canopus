// transfer_test.nv - task 192: the protocol of a conversation that is handed to another agent (`transfer.nv`): whole messages, in order,
// complete recorded tool details and named references to attachments.
module canopus.server

fn tl(kind str, input str) -> str => "{\"id\":\"x\",\"trace\":\"s\",\"step\":1,\"kind\":\"${kind}\",\"input\":${input},\"time\":0}"

fn sample() -> []str => [
    tl("session_created", "{\"name\":\"N\",\"agent\":\"opencode\"}"),
    tl("user_message", "{\"turn\":\"t1\",\"text\":\"first question\\nwith a second line\"}"),
    tl("agent_chunk", "{\"turn\":\"t1\",\"text\":\"The answer \"}"),
    tl("tool_call", "{\"turn\":\"t1\",\"id\":\"c1\",\"title\":\"read a.txt\",\"kind\":\"read\",\"status\":\"in_progress\"}"),
    tl("tool_call_update", "{\"id\":\"c1\",\"status\":\"completed\",\"detail\":\"12 lines\"}"),
    tl("agent_chunk", "{\"turn\":\"t1\",\"text\":\"goes on.\"}"),
    tl("agent_done", "{\"turn\":\"t1\"}"),
    tl("user_message", "{\"turn\":\"t2\",\"text\":\"second question\"}")
]

test "transfer: the first line says whose conversation it is, the messages come whole and in order" {
    ro r = build_transfer(sample(), "opencode")
    assert(r.text.starts_with("Это продолжение разговора, ранее вёл opencode; ниже протокол; продолжай с последнего сообщения пользователя, ничего не отвечай на протокол"))
    assert(r.text.contains("first question\nwith a second line"))
    assert(r.text.contains("The answer"))
    assert(r.text.contains("goes on."))
    assert(r.text.contains("read a.txt"))
    assert(r.text.contains("completed"))
    assert(r.text.contains("second question"))
    assert(r.shown == 4)
    assert(r.total == 4)
    assert(!r.cut)
    ro first = r.text.find("first question") ?? -1
    ro answer = r.text.find("The answer") ?? -1
    ro second = r.text.find("second question") ?? -1
    assert(first >= 0 && first < answer && answer < second)
}

test "transfer: a long transcript preserves early messages and full recorded tool details" {
    ro early = "beginning ".concat("x".repeat(410000))
    ro detail = "y".repeat(300).concat(" tool detail end")
    ro lines = [
        tl("user_message", "{\"turn\":\"t1\",\"text\":\"${early}\"}"),
        tl("tool_call", "{\"turn\":\"t1\",\"id\":\"c1\",\"title\":\"read\",\"detail\":\"${detail}\"}"),
        tl("agent_chunk", "{\"turn\":\"t1\",\"text\":\"recent answer\"}")
    ]
    ro r = build_transfer(lines, "kimi")
    assert(r.text.contains(early))
    assert(r.text.contains(detail))
    assert(r.text.contains("recent answer"))
    assert(r.shown == 2 && r.total == 2 && !r.cut)
}

test "transfer: the pictures of a message go as lines with the names, never the bytes" {
    ro lines = [
        tl("session_created", "{\"name\":\"N\",\"agent\":\"opencode\"}"),
        tl("message_images", "{\"images\":[{\"n\":1,\"name\":\"shot.png\",\"mime\":\"image/png\",\"bytes\":5},{\"n\":2,\"name\":\"image-2.png\",\"mime\":\"image/png\",\"bytes\":7}]}"),
        tl("user_message", "{\"turn\":\"t1\",\"text\":\"look at this\"}"),
        tl("agent_done", "{\"turn\":\"t1\"}"),
        tl("message_images", "{\"images\":[{\"n\":3,\"name\":\"alone.png\",\"mime\":\"image/png\",\"bytes\":1}]}"),
        tl("user_message", "{\"turn\":\"t2\",\"text\":\"\"}"),
        tl("user_message", "{\"turn\":\"t3\",\"text\":\"plain\"}")
    ]
    ro r = build_transfer(lines, "opencode")
    assert(r.text.contains("look at this\n[изображение: shot.png]\n[изображение: image-2.png]"))
    assert(r.text.contains("[пользователь]\n[изображение: alone.png]"))
    assert(r.text.contains("[пользователь]\nplain"))
    assert(r.total == 3)
}
