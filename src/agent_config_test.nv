// agent_config_test.nv - task 192.9: the configuration of OpenCode for the agents of the hub: the plugin canopus is cut out, everything else stays.
module canopus.agent_config_test

import canopus.agent_config.{config_for_hub, config_without_plugin, config_without_string_property, opencode_home_prepare, opencode_home_prepare_with_policy, OPENCODE_KEEP_PLUGIN}

import std.encoding.json.{Json, JsonValue}
import std.os.{Os, MockOs, mock_os, real_os, temp_dir, pid}
import std.fs.{Fs, real_fs, Path, create_dir_all, write_text, read_text, try_exists, remove_dir_all}

fn ac_sample() -> str => [
    "{",
    "  // the models",
    "  \"model\": \"a/b\",",
    "  \"plugins\": [",
    "    \"C:/work/plugins/windows-env\",",
    "    // a comment of the second one",
    "    \"C:/work/plugins/guards\",",
    "    // the projects of the letters (a comment of the plugin canopus)",
    "    {",
    "      \"package\": \"C:/work/canopus/opencode-plugin\",",
    "      \"options\": { \"projects\": [\"C:/work/x\", \"C:/work/y\"], \"local\": { \"a\": 1 } }",
    "    }",
    "  ],",
    "  \"provider\": {",
    "    \"cc\": { \"settings\": { \"claudeConfigDir\": \"C:/acc\", \"timeStamp\": true, \"crewMcp\": \"C:/work/canopus/opencode-plugin/mcp.ts\", \"canopusMcp\": \"C:/work/canopus/opencode-plugin/mcp.ts\" } },", // guard-allow(legacy-name): published external provider option in owner fixture
    "    \"k\": { \"models\": { \"m1\": {} } }",
    "  }",
    "}"
].join("\n")

test "agent config: the plugin canopus is cut out of the list, the other plugins, the comments and the providers stay" {
    ro cut = config_for_hub(ac_sample())
    assert(!cut.contains("opencode-plugin"))
    assert(!cut.contains("canopusMcp"))
    assert(cut.contains("\"crewMcp\": false")) // guard-allow(legacy-name): actual external provider disable contract
    assert(!cut.contains("a comment of the plugin"))
    assert(cut.contains("C:/work/plugins/windows-env"))
    assert(cut.contains("// a comment of the second one"))
    assert(cut.contains("C:/work/plugins/guards"))
    assert(cut.contains("// the models"))
    assert(cut.contains("\"claudeConfigDir\": \"C:/acc\""))
    assert(cut.contains("\"timeStamp\": true"))
    assert(cut.contains("\"models\": { \"m1\": {} }"))
}

test "agent config: the cut text is JSON without the comments (the list is closed without a stray comma)" {
    ro cut = config_for_hub(ac_sample())
    // the comments are dropped for the check only
    mut lines = []str.new()
    for line in cut.lines() {
        if !line.trim_ascii().starts_with("//") { lines.push(line) }
    }
    match Json.parse(lines.join("\n")) {
        Ok(v) => assert(v.object().is_some())
        Err(e) => panic("the cut configuration is not JSON")
    }
}

test "agent config: a plugin of the plugins in the middle and a string entry are cut too; no plugin - the same text" {
    ro middle = "{ \"plugins\": [\"a\", \"D:\\work\\canopus\\opencode-plugin\", \"b\"] }"
    ro cut = config_without_plugin(middle)
    assert(cut == "{ \"plugins\": [\"a\", \"b\"] }")
    ro none = "{ \"plugins\": [\"a\", \"b\"], \"x\": [1] }"
    assert(config_for_hub(none) == none)
    ro cli = "{\n  \"plugins\": [\"C:/work/canopus/opencode-plugin\"],\n  \"debug\": { \"turn_tokens\": true }\n}\n"
    ro cli_cut = config_for_hub(cli)
    assert(!cli_cut.contains("opencode-plugin"))
    assert(cli_cut.contains("\"debug\": { \"turn_tokens\": true }"))
    match Json.parse(cli_cut) {
        Ok(v) => assert(v.object().is_some())
        Err(e) => panic("not JSON")
    }
}

test "agent config: the property canopusMcp is cut when it is first or alone too" {
    ro first = config_without_string_property("{ \"s\": { \"canopusMcp\": \"p\", \"t\": 1 } }", "canopusMcp")
    assert(first.replace(" ", "") == "{\"s\":{\"t\":1}}")
    assert(!config_without_string_property("{ \"s\": { \"canopusMcp\": \"p\" } }", "canopusMcp").contains("canopusMcp"))
}


test "agent config: retired keep-plugin env cannot bypass the default; explicit code policy retains the alternative" {
    assert(!OPENCODE_KEEP_PLUGIN)
    ro temp = with Os = real_os() { temp_dir() }
    ro id = with Os = real_os() { pid() }
    ro root = temp.join("canopus-agent-policy-${id}")
    ro source = root.join("source")
    ro data = root.join("data")
    ro kept = root.join("kept")
    with Fs = real_fs() {
        ro old = remove_dir_all(root)
        ro made = create_dir_all(source)
        match write_text(source.join("opencode.jsonc"), ac_sample()) {
            Ok(done) => ()
            Err(e) => panic("cannot prepare agent configuration fixture")
        }
    }
    mut state = MockOs.new()
    state.put_env("CANOPUS_OPENCODE_KEEP_PLUGIN", "1")
    with Fs = real_fs(), Os = mock_os(state) {
        match opencode_home_prepare(data.display(), source.display()) {
            Ok(xdg) => {
                ro copy = read_text(Path.from_bytes("${xdg}/opencode/opencode.jsonc".bytes())) ?? ""
                assert(copy.byte_len() > 0 && !copy.contains("opencode-plugin"))
                assert(copy.contains("C:/work/plugins/guards"))
                assert(copy.contains("\"crewMcp\": false")) // guard-allow(legacy-name): copied agent config must disable actual external provider MCP
                assert((read_text(source.join("opencode.jsonc")) ?? "") == ac_sample())
            }
            Err(e) => panic("retired environment changed the internal default")
        }
        match opencode_home_prepare_with_policy(kept.display(), source.display(), true) {
            Err(why) => assert(why == "kept by code policy")
            Ok(xdg) => panic("explicit keep policy unexpectedly made a copy")
        }
        assert(!(try_exists(kept.join("agent-config")) ?? false))
        ro gone = remove_dir_all(root)
    }
}


test "agent config: actual provider option is false rather than absent, with comments and neighboring values preserved" {
    ro key = "crewMcp" // guard-allow(legacy-name): independent literal of the published external provider option
    for source in ["{\"${key}\":\"endpoint\"}", "{\"${key}\":\"endpoint\",\"other\":7}", "{\"other\":7,\"${key}\":\"endpoint\"}"] {
        ro cut = config_for_hub(source)
        match Json.parse(cut) {
            Ok(value) => assert(value.object().unwrap().get(key).unwrap().bool() == Some(false))
            Err(error) => panic("disabled provider configuration is not JSON")
        }
        if source.contains("other") { assert(cut.contains("\"other\":7")) }
        assert(config_for_hub(cut) == cut)
    }
    ro already_disabled = "{\"${key}\":false,\"other\":7}"
    assert(config_for_hub(already_disabled) == already_disabled)
    ro commented = "{/* keep ${key} in this comment */ \"${key}\": /* endpoint */ \"endpoint\", \"other\":7}"
    ro cut = config_for_hub(commented)
    assert(cut == "{/* keep ${key} in this comment */ \"${key}\": /* endpoint */ false, \"other\":7}")
}


test "agent config: recognized native provider gets false even when absent or null; unrelated aliases stay intact" {
    ro package = "aisdk:file:///C:/work/fixtures/opencode-claude-code-provider/index.js"
    for map in ["providers", "provider"] {
        for settings in ["{}", "{ /* keep */ \"timeStamp\":true, }", "{\"crewMcp\":null,\"x\":1}", "{\"crewMcp\":false}", "{\"crewMcp\":{\"nested\":[1,2]},\"x\":1}", "{\"crewMcp\":[1,{\"nested\":2}],\"x\":1}"] { // guard-allow(legacy-name): published external provider option
            ro original = "{\"${map}\":{\"renamed-provider\":{\"package\":\"${package}\",\"settings\":${settings}},\"other\":{\"package\":\"@ai-sdk/other\",\"settings\":{\"x\":2}}}}"
            ro cut = config_for_hub(original)
            assert(cut.contains("\"crewMcp\":false")) // guard-allow(legacy-name): published external provider option
            assert(cut.contains("\"other\":{\"package\":\"@ai-sdk/other\",\"settings\":{\"x\":2}}"))
            if settings.contains("/* keep */") {
                assert(cut.contains("/* keep */"))
            } else {
                match Json.parse(cut) {
                    Ok(v) => assert(v.object().is_some())
                    Err(e) => panic("the sanitized native provider is not valid JSON")
                }
            }
            if settings.contains("\"x\":1") { assert(cut.contains("\"x\":1")) }
            assert(config_for_hub(cut) == cut)
        }
    }
    ro absent = "{\"providers\":{\"alias\":{\"package\":\"${package}\",\"models\":{}}}}"
    assert(config_for_hub(absent).contains("\"settings\":{\"crewMcp\":false}")) // guard-allow(legacy-name): published external provider option
    ro unrelated = "{\"providers\":{\"claude-code\":{\"package\":\"@ai-sdk/other\",\"settings\":{}}}}"
    assert(config_for_hub(unrelated) == unrelated)
    assert(config_for_hub("{\"providers\":{}}") == "{\"providers\":{}}")
}
