// ext_live_test.nv - owner-confirmed additions (313), with a fake ACP agent in a repository.
module canopus.server_ext_live

import canopus.server.{kit_routes_children, scenario_route_auto_extend, scenario_route_scope}

fn ext_clean(report str) -> () {
    if report.byte_len() > 0 { panic("NOT AS IT MUST BE: ${report}") }
    assert(report == "")
}

test "files: every addition including high confidence waits for owner approval; refusal leaves the assignment unchanged" {
    ext_clean(scenario_route_auto_extend(kit_routes_children("route-ext")))
}

test "files: the tasks of another session of the project are not offered, not extended, not adopted; the tasks made from the talk of the session are its own (task 192.13)" {
    ext_clean(scenario_route_scope(kit_routes_children("route-scope")))
}
