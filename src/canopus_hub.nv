// canopus_hub.nv - the entry point of the hub of the session server (task 099): the engines, the agents and the store, over stdin and
// stdout. The front (HTTP and WebSocket) starts it; it can also be started by hand to look at the lines it speaks.
//   canopus-hub [--config <file>]   (the parent of the selected file owns the instance; see src/server/README.md)
// Build: nova build src/canopus_hub.nv -o target/canopus-hub.exe
module canopus.canopus_hub

import canopus.server.{server_settings_selected, run_hub_stdio}
import canopus.config.{split_cli_args, canopus_home, legacy_env_problem, select_config, ConfigSelection, work_dir_now, claim_instance}
import std.os.{args, exit_process}
import std.io.{stderr}

fn main() Os Fs Proc Detach Time Net Io -> () {
    ro legacy = legacy_env_problem()
    if legacy.byte_len() > 0 {
        mut err0 = stderr()
        ro written0 = err0.write("canopus-hub: старые имена переменных окружения не поддерживаются: ${legacy}\n".bytes())
        exit_process(2)
    }
    ro cli = split_cli_args(args())
    if cli.error.byte_len() > 0 {
        mut err = stderr()
        ro written = err.write("canopus-hub: ${cli.error}\n".bytes())
        exit_process(2)
    }
    ro selected = if cli.config.byte_len() > 0 {
        match select_config(cli.config, work_dir_now(), "") {
            Ok(s) => s
            Err(reason) => {
                mut err = stderr()
                ro written = err.write("canopus-hub: ${reason}\n".bytes())
                exit_process(2)
                return
            }
        }
    } else { ConfigSelection { file: "", root: canopus_home(cli.home) } }
    ro file = if selected.file.byte_len() == 0 && cli.rest.len() > 1 { cli.rest[1] } else { "" }
    match server_settings_selected(file, selected.root, cli.sets, selected.file) {
        Err(reason) => {
            mut err = stderr()
            ro written = err.write("canopus-hub: ${reason}\n".bytes())
            exit_process(2)
        }
        Ok(settings) => {
            match claim_instance(selected.root, "app") {
                Ok(done) => ()
                Err(reason) => {
                    mut err = stderr()
                    ro written = err.write("canopus-hub: ${reason}\n".bytes())
                    exit_process(2)
                    return
                }
            }
            ro code = run_hub_stdio(settings)
            // ORACLE-WORKAROUND(19): an explicit exit: the fiber that reads stdin is parked until the front closes it, and a program with a parked fiber does not end by itself; return from `main` when item 19 is fixed
            exit_process(code)
        }
    }
}
