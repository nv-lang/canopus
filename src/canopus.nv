// canopus.nv - the entry point of the canopus binary (task 099): the session server, its front. It serves the page
// of src/web/ and the WebSocket /ws on 127.0.0.1 and starts the hub (src/canopus_hub.nv) as a child process. Task 192.12 adds the commands of the configuration.
//   canopus [serve] [--config <file>]
//   canopus config list [--show-origin] | get <key> [--show-origin] | set <key> <value> [--project]
//   canopus doctor
//   canopus migrate [--from <data_dir>] [--dry-run]
//   canopus                            starts the default application instance
// The selected config parent is the instance root; default ~/.canopus/config.json.
// Build both programs: nova build src/canopus_hub.nv -o target/canopus-hub.exe; nova build src/canopus.nv -o target/canopus.exe
module canopus.canopus

import canopus.server.front.{run_front_with_metadata, front_settings_selected, FrontSettings}
import canopus.model_metadata.{MetadataInput, MetadataHook, static_hook, default_opencode_program}
import canopus.config.{split_cli_args, canopus_home, layout_in, find_project_dir, work_dir_now, config_list, config_get, config_set, doctor, command_layers, effective_entries, plan_migration, plan_text, run_migration, ConfigLayout, ConfigSelection, claim_instance, retired_env_problem, select_config, layout_for_config, CliArgs}
import std.os.{args, exit_process, env}
import std.io.{stderr}
import std.time.{Time}

const USAGE = "canopus 0.1.0 - usage:\n  canopus [serve] [--config <file>]\n  canopus config list [--show-origin]\n  canopus config get <key> [--show-origin]\n  canopus config set <key> <value> [--project]\n  canopus doctor\n  canopus migrate [--from <data_dir>] [--dry-run]\n(default config: ~/.canopus/config.json; its parent owns secrets.json and instance data)"


fn fail(text str) Os Io -> () {
    mut err = stderr()
    ro written = err.write("canopus: ${text}\n".bytes())
    exit_process(2)
}

// Where the root came from, for `doctor`.
fn home_source(arg_home str) Os -> str => "the folder of the user"

/// OptionTaken: the value of `--name value` ("" - none) and the words without it.
type OptionTaken { value str, rest []str }

fn take_option(words []str, name str) -> OptionTaken {
    mut value = ""
    mut rest = []str.new()
    mut i = 0
    while i < words.len() {
        if words[i] == name && i + 1 < words.len() {
            value = words[i + 1]
            i += 1
        } else {
            rest.push(words[i])
        }
        i += 1
    }
    OptionTaken { value, rest }
}

type FlagTaken { found bool, rest []str }

fn take_flag(words []str, name str) -> FlagTaken {
    mut found = false
    mut rest = []str.new()
    for w in words {
        if w == name { found = true } else { rest.push(w) }
    }
    FlagTaken { found, rest }
}

// The catalog observer input of this instance: the OpenCode agent among the configured ones (its
// program, or the platform default), its id as the family, the working directory of this process
// and the state folder for the snapshot. No OpenCode agent configured - no observer (None).
fn metadata_input_of(settings FrontSettings) Os Fs -> Option[MetadataInput] {
    mut program = ""
    mut family = ""
    for a in settings.agents {
        if a.id == "opencode" {
            if a.program.byte_len() > 0 { program = a.program }
            family = a.id
        }
    }
    if family.byte_len() == 0 { return None }
    if program.byte_len() == 0 { program = default_opencode_program() }
    Some(MetadataInput { program, family, cwd: work_dir_now(), state_dir: settings.layout.state })
}

fn cmd_serve(cli CliArgs) Proc Net Time Detach Io Os Fs -> () {
    if cli.rest.len() > 2 { return fail("serve no longer takes a settings file; use --config <file>") }
    ro selected = if cli.config.byte_len() > 0 {
        match select_config(cli.config, work_dir_now(), "") { Ok(s) => s, Err(reason) => return fail(reason) }
    } else { ConfigSelection { file: "", root: canopus_home(cli.home) } }
    ro file = if selected.file.byte_len() == 0 && cli.rest.len() > 2 { cli.rest[2] } else { "" }
    mut pass = []str.new()
    if selected.file.byte_len() > 0 {
        pass.push("--config")
        pass.push(selected.file)
    } else if cli.home.byte_len() > 0 {
        pass.push("--home")
        pass.push(cli.home)
    }
    for s in cli.sets {
        pass.push("--set")
        pass.push(s)
    }
    match front_settings_selected(file, selected.root, cli.sets, selected.file) {
        Err(reason) => fail(reason)
        Ok(settings) => {
            match claim_instance(settings.layout.home, "app") { Ok(done) => (), Err(reason) => return fail(reason) }
            // the effects of metadata_input_of are already in this signature; the handler comes
            // from the caller (one with at the entry, the module-conventions rule)
            ro input = metadata_input_of(settings)
            // the effect is in this signature already; the handler comes from the caller
            // (one with at the entry - the module-conventions rule), no per-call wrapper
            ro hook = match input { Some(i) => static_hook(i), None => None }
            run_front_with_metadata(settings, file, pass, hook)
        }
    }
}

fn layout_now(cli CliArgs) Os Fs -> Result[ConfigLayout, str] {
    if cli.config.byte_len() > 0 {
        ro selected = select_config(cli.config, work_dir_now(), "")?
        claim_instance(selected.root, "app")?
        return Ok(layout_for_config(selected, find_project_dir(work_dir_now(), selected.root)))
    }
    ro home = canopus_home(cli.home)
    claim_instance(home, "app")?
    Ok(layout_in(home, find_project_dir(work_dir_now(), home)))
}

fn cmd_config(cli CliArgs) Os Fs Io -> () {
    ro layout = match layout_now(cli) { Ok(l) => l, Err(reason) => return fail(reason) }
    mut words = []str.new()
    mut i = 2
    while i < cli.rest.len() {
        words.push(cli.rest[i])
        i += 1
    }
    ro file = take_option(words, "--file")
    ro origin = take_flag(file.rest, "--show-origin")
    ro project = take_flag(origin.rest, "--project")
    ro local = take_flag(project.rest, "--local")
    if local.found { return fail("--local was removed; use --project or the selected global config") }
    ro scope = if project.found { "project" } else { "user" }
    ro w = local.rest
    if w.len() == 0 { return fail("config needs list, get or set\n${USAGE}") }
    if w[0] == "list" {
        match config_list(layout, file.value, cli.sets, origin.found) {
            Ok(text) => println(text)
            Err(reason) => fail(reason)
        }
    } else if w[0] == "get" && w.len() == 2 {
        match config_get(layout, file.value, cli.sets, w[1], origin.found) {
            Ok(text) => println(text)
            Err(reason) => fail(reason)
        }
    } else if w[0] == "set" && w.len() == 3 {
        match config_set(layout, scope, work_dir_now(), w[1], w[2]) {
            Ok(text) => println(text)
            Err(reason) => fail(reason)
        }
    } else {
        fail("config: wrong arguments\n${USAGE}")
    }
}

fn cmd_doctor(cli CliArgs) Os Fs Io -> () {
    ro layout = match layout_now(cli) { Ok(l) => l, Err(reason) => return fail(reason) }
    ro file = take_option(cli.rest, "--file")
    ro report = doctor(layout, file.value, if cli.config.byte_len() > 0 { "--config" } else { home_source(cli.home) }, work_dir_now())
    println(report.text)
    if report.errors > 0 { exit_process(1) }
}

fn cmd_migrate(cli CliArgs) Os Fs Time Io -> () {
    ro layout = match layout_now(cli) { Ok(l) => l, Err(reason) => return fail(reason) }
    ro from = take_option(cli.rest, "--from")
    ro dry = take_flag(from.rest, "--dry-run")
    ro file = take_option(dry.rest, "--file")
    // the old folder: --from, else the data_dir of the settings (a file, CANOPUS_SERVER_DATA_DIR), else ./canopus-data
    mut old = from.value
    if old.byte_len() == 0 {
        match command_layers(layout, file.value, cli.sets) {
            Ok(layers) => {
                for e in effective_entries(layers) {
                    if e.key == "data_dir" && e.origin != "default" { old = e.value.str() ?? "" }
                }
            }
            Err(reason) => return fail(reason)
        }
    }
    if old.byte_len() == 0 { old = "${work_dir_now()}/canopus-data" }
    ro plan = plan_migration(old, layout)
    if plan.error.byte_len() > 0 { return fail(plan.error) }
    if dry.found {
        println(plan_text(plan, true))
        return
    }
    ro stamp = "${Time.now().unix_millis()}"
    ro result = run_migration(plan, layout, stamp)
    println(result.text)
    if result.failed > 0 { exit_process(1) }
}

fn main() Os Fs Proc Net Time Detach Io -> () {
    ro cli = split_cli_args(args())
    if cli.error.byte_len() > 0 { return fail(cli.error) }
    ro old_env = retired_env_problem()
    if old_env.byte_len() > 0 { return fail(old_env) }
    if cli.rest.len() < 2 {
        cmd_serve(cli)
        return
    }
    ro verb = cli.rest[1]
    if verb == "--help" || verb == "-h" {
        println(USAGE)
    } else if verb == "serve" {
        cmd_serve(cli)
    } else if verb == "config" {
        cmd_config(cli)
    } else if verb == "doctor" {
        cmd_doctor(cli)
    } else if verb == "migrate" {
        cmd_migrate(cli)
    } else {
        println(USAGE)
    }
}
