node_modules/

# nova build output; nova.lock.toml is NOT ignored: it pins the build and belongs in the repository.
target/

# `nova build <file>` drops <name>.exe beside the source, the package rule says built artefacts
# live in target/: the stray one is ignored rather than moved.
*.exe

# Codegen leaves a <name>.c beside every <name>.nv it compiles.
*.c

# Local replacement of a dependency by a folder (until a version of the package `alula` is published, tasks 144 and 148); it is never committed.
nova.override.toml

# Personal settings of a project of the control panel (absolute paths of the machine); the shared ones, .canopus/config.json, are committed (task 192.12).
.canopus/local.json

# Personal Canopus configuration
.canopus/secrets.json
.canopus/plugin/local.json

# Shared task runtime state is local; documents remain versioned (288).
**/input/state.json
**/.task-store.lock/
**/imported-sources/
**/.task-store.claim-*
**/input/watch.json
**/input/snapshot.json
**/input/tests-run.json

# Private runtime in either task layout; input documents remain versioned.
**/[0-9][0-9][0-9]*/state.json
**/task/state.json
**/[0-9][0-9][0-9]*/watch.json
**/task/watch.json
**/[0-9][0-9][0-9]*/snapshot.json
**/task/snapshot.json
